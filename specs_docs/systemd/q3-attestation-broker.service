[Unit]
Description=Q3 Control-v9 semantic attestation broker (Linux independent auditor)
Documentation=https://github.com/Malaeu/chen_q3/blob/rh_clean/docs/routeB_bus/proshka/PROSHKA_VERDICT_GOAL058_W5_CONTROL_V9_SEMANTIC_ATTESTATION_MATERIALIZATION_2026-08-25.md
After=default.target

[Service]
Type=simple
EnvironmentFile=%h/.config/q3-control-v9.env
ExecStart=/bin/sh -c 'test -n "$${Q3_REPO}" && ROOT="$$(git -C "$${Q3_REPO}" rev-parse --show-toplevel)" && test "$$(realpath "$${ROOT}")" = "$$(realpath "$${Q3_REPO}")" && test -f "$${ROOT}/docs/CODEX_CONTROL.md" && test -f "$${ROOT}/q3.lean.aristotle/PROJECT_ORCHESTRATOR.md" && test -f "$${ROOT}/q3.lean.aristotle/lakefile.toml" && cd "$${ROOT}" && exec .venv/bin/python orchestrator/semantic_attestation_broker.py'
Restart=on-failure
RestartSec=5
# The broker only reads its own registry; it never writes the repository.
ProtectSystem=strict
ReadWritePaths=/run/q3-control-v9
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
