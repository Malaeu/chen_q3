"""One bounded full-tree bootstrap rehearsal; all writes stay in a cache fixture.

Real CLI, actor, locking, registration and local bare Git transport. The fixture
establishes its own v1 owner during setup; it never transfers the live owner.
No mathematical stages, actual native wake or semantic refresh are certified.
"""
import copy
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
from datetime import datetime, timezone

SOURCE = Path('/home/chirurgie/.cache/q3-team-2026-09-11-01a08f80')
CANONICAL = Path('/mnt/hdd01/Soft/GitHub/chen_q3_rh_clean')
ROOT = Path('/home/chirurgie/.cache/q3-team-full-bootstrap-fixture-2026-09-11-01a08f80')
BASE = 'ec9f9057f103f3e75c1b8b3fa452c8a234f25cd9'
TARGET = subprocess.check_output(['git', 'rev-parse', 'fde52e40'], cwd=SOURCE).decode().strip()
ACTOR = os.environ['CODEX_THREAD_ID']
assert ACTOR == '01a08f80-f033-7a31-8f3a-3aef042a3fbc'
RESUME_SETUP = sys.argv[1:] == ['--resume-before-initial-checkpoint']
RESUME_SEED = sys.argv[1:] == ['--resume-seed-before-commit']
assert RESUME_SETUP or RESUME_SEED or not ROOT.exists(), 'Never restart an existing fixture or repeat its publication'
ROOT.mkdir(exist_ok=RESUME_SETUP or RESUME_SEED)
REPO, REMOTE = ROOT / 'owner', ROOT / 'remote.git'
ENV = {**os.environ, 'Q3_OWNER_EPOCH': '1'}
sys.path.insert(0, str(SOURCE))
from orchestrator import workflow_runtime as runtime

def digest(raw):
    return hashlib.sha256(raw).hexdigest()

def git(repo, *args):
    return subprocess.check_output(['git', *args], cwd=repo, env=ENV, stderr=subprocess.PIPE)

def emit(name, result):
    print(name, json.dumps(result, sort_keys=True), flush=True)

def cli(*args, permitted=(0,)):
    result = subprocess.run(['python3', 'orchestrator/workflow_runtime.py', *args],
                            cwd=REPO, env=ENV, capture_output=True, text=True)
    value = json.loads(result.stdout)
    (ROOT / ('command-%02d.json' % len(list(ROOT.glob('command-*.json'))))).write_text(
        json.dumps({'args': args, 'exit': result.returncode, 'result': value}, indent=2) + '\n')
    assert result.returncode in permitted, (args, result.returncode, value, result.stderr[-1000:])
    return value

def serialize(data, body):
    return ('---\n' + runtime.yaml.safe_dump(data, sort_keys=False) + '---\n' + body).encode()

def save(data, body):
    before = (REPO / runtime.RESUME_PATH).read_bytes()
    old, _ = runtime._resume_document(before)
    data = copy.deepcopy(data)
    data.update(revision=old['revision'] + 1, previous_sha256=digest(before),
                observed_at=datetime.now(timezone.utc).isoformat())
    raw = serialize(data, body)
    runtime._resume_document(raw)
    candidate = ROOT / ('resume-%d.md' % data['revision'])
    assert not candidate.exists()
    candidate.write_bytes(raw)
    result = cli('resume-checkpoint', '--candidate', str(candidate), '--expected-sha256', digest(before))
    assert (REPO / runtime.RESUME_PATH).read_bytes() == raw
    emit('checkpoint', {'revision': data['revision'], 'bytes': len(raw), 'status': result['status']})
    return data

def install(paths):
    with runtime._execution_writer_epoch(REPO) as epoch:
        for path in paths:
            previous = runtime._resume_file(REPO, Path(path))
            payload = git(SOURCE, 'show', TARGET + ':' + path)
            mode = int(git(SOURCE, 'ls-tree', TARGET, '--', path).split()[0], 8) & 0o777
            runtime._resume_cas_bytes(REPO, Path(path), previous, payload, epoch, mode=mode)

def commit(paths, message):
    git(REPO, 'add', '--', *paths)
    git(REPO, 'diff', '--cached', '--check')
    git(REPO, 'commit', '-m', message)
    return git(REPO, 'rev-parse', 'HEAD').decode().strip()

if not RESUME_SETUP and not RESUME_SEED:
    git(ROOT, 'clone', '--bare', '--shared', '--quiet', str(CANONICAL), str(REMOTE))
    assert git(REMOTE, 'rev-parse', 'rh_clean').decode().strip() == BASE
    git(ROOT, 'clone', '--shared', '--quiet', '--branch', 'rh_clean', str(REMOTE), str(REPO))
elif RESUME_SETUP:
    # The local bare fixture has no LFS media server. Its clone stopped before
    # writing the index. Reconcile that setup only, preserving existing bytes.
    assert not list(ROOT.glob('command-*.json'))
    assert git(REPO, 'rev-parse', 'HEAD').decode().strip() == BASE
    assert git(REMOTE, 'rev-parse', 'rh_clean').decode().strip() == BASE
    assert not (REPO / '.git/index').exists()
    for relative in git(REPO, 'ls-tree', '-rz', '--name-only', 'HEAD').decode().split('\0')[:-1]:
        path = REPO / relative
        if not path.exists() and not path.is_symlink():
            raw = git(REPO, 'show', 'HEAD:' + relative)
            assert raw.startswith(b'version https://git-lfs.github.com/spec/v1\n'), relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(raw)
    git(REPO, 'read-tree', 'HEAD')
    git(REPO, 'diff', '--quiet', 'HEAD', '--')
else:
    assert git(REPO, 'rev-parse', 'HEAD').decode().strip() == BASE
    assert git(REMOTE, 'rev-parse', 'rh_clean').decode().strip() == BASE
    assert len(list(ROOT.glob('command-*.json'))) == 1
    assert (REPO / runtime.RESUME_PATH).read_bytes() == (ROOT / 'resume-66.md').read_bytes()
assert Path(git(REPO, 'remote', 'get-url', 'origin').decode().strip()) == REMOTE
# A fixture needs the legacy local lock before the new local-init exists.
(REPO / '.git/q3-three-body.writer.lock').touch(mode=0o600)
old, _ = runtime._resume_document((REPO / runtime.RESUME_PATH).read_bytes())
body = '# Isolated startup and publication acceptance fixture\n\n' + ''.join(
    '## ' + name + '\nIsolated fixture only; no mathematical or native-provider acceptance.\n\n'
    for name in runtime.RESUME_SECTIONS)
body = body.rstrip() + '\n'
old.update(owner_thread_id=ACTOR, operation={'kind': 'NONE', 'state': 'NONE', 'id': '', 'evidence': []},
           stages={key: 'PENDING' for key in old['stages']})
old = save(old, body)
remote_commit = commit([str(runtime.RESUME_PATH), str(runtime.RESUME_HISTORY_PATH)], 'Fixture-only owner seed')
git(REPO, 'push', '--no-follow-tags', '--recurse-submodules=no', 'origin', remote_commit + ':refs/heads/rh_clean')
remote_resume = (REPO / runtime.RESUME_PATH).read_bytes()
remote_history = (REPO / runtime.RESUME_HISTORY_PATH).read_bytes()
paths = git(SOURCE, 'diff', '--name-only', BASE, TARGET, '--').decode().splitlines()
assert len(paths) == 21, paths
initial = [p for p in paths if (p.startswith('orchestrator/') and p.endswith('.py')) or p == 'docs/cartographer/TOOLS.yaml']
final = [p for p in paths if p not in initial]
inputs = {p: digest(git(SOURCE, 'show', TARGET + ':' + p)) for p in paths}
initial_inputs = {p: inputs[p] for p in initial}
operation_id = 'FULL-TREE-BOOTSTRAP-FIXTURE'
old['operation'] = {'kind': 'PUBLISH', 'state': 'INTENT', 'id': operation_id + ':local-install',
                    'evidence': ['Fixture exact local subset: ' + json.dumps(initial_inputs, sort_keys=True)]}
old = save(old, body)
install(initial)
local_commit = commit(initial + [str(runtime.RESUME_PATH), str(runtime.RESUME_HISTORY_PATH)],
                      'Install exact runtime subset in isolated full-tree fixture')
old['operation'].update(state='CONFIRMED', evidence=['bootstrap_local_commit:' + local_commit])
old['pins']['head'] = local_commit
old = save(old, body)
identity = cli('team-local-init')
phase = json.loads((REPO / 'orchestrator/state/CHANNEL_RUNTIME.json').read_bytes())['active_proshka_phase']
request_path = 'docs/routeB_bus/proshka/PROSHKA_REQUEST_GOAL058_DENSITY_2026-09-11.txt'
request_commit = git(REPO, 'rev-parse', '122076a3430251d8f1f9b0cd0577938456eaaed2').decode().strip()
request_raw = git(REPO, 'show', request_commit + ':' + request_path)
request = {'path': request_path, 'commit': request_commit,
           'blob': git(REPO, 'rev-parse', request_commit + ':' + request_path).decode().strip(),
           'sha256': digest(request_raw), 'boundary_id': 'GOAL058_THETA_PROBABILITY_DENSITY_FULL_FORM_SIGN',
           'conversation_id': phase['conversation_id']}
sources = {p: digest((REPO / p).read_bytes()) for p in [old['pins']['physical_goal'], request_path]}
source_digest = digest(runtime._team_json(sources))
request_subject = {'kind': 'REQUEST', 'id': old['pins']['request_id'], 'sha256': request['sha256']}
verdict_subject = {'kind': 'VERDICT', 'id': 'FIXTURE_UNVERIFIED', 'sha256': digest(b'fixture unverified')}
v2 = copy.deepcopy(old)
v2.update(schema='q3_resume.v2', source_manifest=sources,
          ownership={'installation_ref': identity['installation_ref'], 'epoch': 1, 'state': 'ACTIVE', 'transfer': None})
v2['pins'].update(request=request, phase_key=phase['phase_key'])
v2['stages'] = {name: {'subject': request_subject if i < 3 else verdict_subject, 'state': 'NOT_STARTED',
                       'evidence': {}, 'source_sha256': source_digest, 'checked_by': None}
                 for i, name in enumerate(runtime.TEAM_STAGES)}
v2['operation'].update(subject={'kind': 'REPAIR', 'id': old['operation']['id'],
                                 'sha256': digest(runtime._team_json(initial_inputs))},
                       command='workflow-team-bootstrap-publish', inputs=initial_inputs)
v2 = save(v2, body)
install(final)
commit(final + [str(runtime.RESUME_PATH), str(runtime.RESUME_HISTORY_PATH)], 'Install final source and control before startup')
entry = cli('plan', permitted=(2,))
assert not entry['startup']['fatal_errors'], entry
emit('actual_entry', {'status': entry['status'], 'fatal_errors': entry['startup']['fatal_errors']})
# Machine-global semantic indexes are outside this isolated CLI/transport fixture.
v2['operation'] = {'kind': 'PUBLISH', 'state': 'INTENT', 'id': operation_id, 'evidence': [],
                   'subject': {'kind': 'REPAIR', 'id': operation_id, 'sha256': digest(runtime._team_json(inputs))},
                   'command': 'workflow-team-bootstrap-publish', 'inputs': inputs}
v2 = save(v2, body)
candidate_commit = commit([str(runtime.RESUME_PATH), str(runtime.RESUME_HISTORY_PATH)], 'Publish exact fixture checkpoint')
result = cli('team-bootstrap-publish', '--operation-id', operation_id, '--expected-head', candidate_commit,
             '--expected-remote-commit', remote_commit, '--expected-remote-resume-sha256', digest(remote_resume))
assert result['status'] == 'CONFIRMED', result
repeat = cli('team-bootstrap-publish', '--operation-id', operation_id, '--reconcile-only')
assert repeat['status'] == 'CONFIRMED' and repeat['push_attempted'] is False, repeat
v2['operation'].update(state='CONFIRMED', evidence=['Actual isolated remote publication: ' + candidate_commit])
v2 = save(v2, body)
assert (REPO / runtime.RESUME_HISTORY_PATH).read_bytes().startswith(remote_history)
emit('PASS', {'base': BASE, 'source': TARGET, 'candidate': candidate_commit,
              'first_publication': result, 'reconciliation': repeat,
              'scope_count': len(paths), 'native_wake': 'NOT_TESTED', 'semantic_refresh': 'NOT_RUN_ISOLATED_FIXTURE'})

