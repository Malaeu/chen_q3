@article{elliott2025analytic-3b3,
  title = {Analytic Number Theory and Algebraic Asymptotic Analysis},
  author = {Elliott, Jesse},
  year = 2025,
  journal = {arXiv},
  eprint = {2407.17820},
  doi = {10.48550/arxiv.2407.17820},
  abstract = {This monograph elucidates and extends many theorems and conjectures in analytic number theory and algebraic asymptotic analysis via the natural notion of "degree" and a more general notion that we call "logexponential degree." Specifically, we define the \textbackslash{} emph\textbackslash{} degree\textbackslash{}  of a real function \$f\$ whose domain is not bounded above to be the infimum of all real numbers \$t\$ such that \$f(x)\$ is \$O(x\textasciicircum{} t)\$. The Riemann hypothesis, for example, is equivalent to the statement that the degree of the function \${$\pi$}(x)- \textbackslash{} operatorname\textbackslash{} li\textbackslash{} (x)\$ is \$1/2\$, where \${$\pi$}(x)\$ is the prime counting function and \$\textbackslash{} operatorname\textbackslash{} li\textbackslash{} (x)\$ is the logarithmic integral function; likewise, the abc conjecture is equivalent to the statement that a particular function has degree 1. Part 1 of the text is a survey of analytic number theory, Part 2 introduces the notion of logexponential degree and uses it to extend results in algebraic asymptotic analysis, and Part 3 applies the results of Part 2 to the various functions that figure most prominently in analytic number theory and Diophantine analysis. Central to the notion of logexponential degree are Hardy's \textbackslash{} emph\textbackslash{} logarithmico-exponential functions\textbackslash{} , which are real functions defined in a neighborhood of \$\textbackslash{} infty\$ that can be built from \$\textbackslash{} operatorname\textbackslash{} id\textbackslash{} \$, \$\textbackslash{} exp\$, and \$\textbackslash{} log\$ using the operations \$+\$, \$\textbackslash{} cdot\$, \$/\$, and \$\textbackslash{} circ\$. Such functions are natural benchmarks for the orders of growth of functions in analytic number theory. The main goal of Part 3 is to express the logexponential degree of various functions in analytic number theory in terms of as few "logexponential primitives" as possible.},
  file = {files/1842/Elliott - 2025 - Analytic number theory and algebraic asymptotic analysis.pdf}
}

