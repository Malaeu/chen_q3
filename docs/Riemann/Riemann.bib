@misc{williamsSimulatingTimeSquareRoot2025,
  title = {Simulating {{Time With Square-Root Space}}},
  author = {Williams, R. Ryan},
  year = 2025,
  month = feb,
  number = {arXiv:2502.17779},
  eprint = {2502.17779},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2502.17779},
  urldate = {2025-08-09},
  abstract = {We show that for all functions \$t(n) \textbackslash geq n\$, every multitape Turing machine running in time \$t\$ can be simulated in space only \$O(\textbackslash sqrt\textbraceleft t \textbackslash log t\textbraceright )\$. This is a substantial improvement over Hopcroft, Paul, and Valiant's simulation of time \$t\$ in \$O(t/\textbackslash log t)\$ space from 50 years ago [FOCS 1975, JACM 1977]. Among other results, our simulation implies that bounded fan-in circuits of size \$s\$ can be evaluated on any input in only \$\textbackslash sqrt\textbraceleft s\textbraceright{} \textbackslash cdot poly(\textbackslash log s)\$ space, and that there are explicit problems solvable in \$O(n)\$ space which require \$n\textasciicircum\textbraceleft 2-\textbackslash varepsilon\textbraceright\$ time on a multitape Turing machine for all \$\textbackslash varepsilon {$>$} 0\$, thereby making a little progress on the \$P\$ versus \$PSPACE\$ problem. Our simulation reduces the problem of simulating time-bounded multitape Turing machines to a series of implicitly-defined Tree Evaluation instances with nice parameters, leveraging the remarkable space-efficient algorithm for Tree Evaluation recently found by Cook and Mertz [STOC 2024].},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computational Complexity},
  note = {Comment: To appear in ACM STOC 2025},
  file = {files/1854/Williams - 2025 - Simulating Time With Square-Root Space.pdf;files/1853/2502.html}
}
