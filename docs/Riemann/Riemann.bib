@misc{gafniRoughNumbersConsecutive2025,
  title = {Rough Numbers between Consecutive Primes},
  author = {Gafni, Ayla and Tao, Terence},
  year = 2025,
  month = aug,
  number = {arXiv:2508.06463},
  eprint = {2508.06463},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2508.06463},
  urldate = {2025-08-13},
  abstract = {Using a sieve-theoretic argument, we show that almost all gaps \$(p\_n, p\_\textbraceleft n+1\textbraceright )\$ between consecutive primes \$p\_n, p\_\textbraceleft n+1\textbraceright\$ contain a natural number \$m\$ whose least prime factor \$p(m)\$ is at least the length \$p\_\textbraceleft n+1\textbraceright{} - p\_n\$ of the gap, confirming a prediction of Erd\textbackslash H\textbraceleft o\textbraceright s. In fact the number \$N(X)\$ of exceptional gaps with \$p\_n \textbackslash in [X,2X]\$ is shown to be at most \$O(X/\textbackslash log\textasciicircum 2 X)\$. Assuming a form of the Hardy--Littlewood prime tuples conjecture, we establish a more precise asymptotic \$N(X) \textbackslash sim c X / \textbackslash log\textasciicircum 2 X\$ for an explicit constant \$c{$>$}0\$, which we believe to be between \$2.7\$ and \$2.8\$. To obtain our results in their full strength we rely on the asymptotics for singular series developed by Montgomery and Soundararajan.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Number Theory},
  note = {Comment: 20 pages
\par
Comment: 20 pages},
  file = {files/1836/Gafni und Tao - 2025 - Rough numbers between consecutive primes.pdf;files/1835/2508.html}
}

