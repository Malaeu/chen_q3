@article{polymath2019effective-8f7,
  title = {Effective Approximation of Heat Flow Evolution of the {{Riemann}} {$\xi$} Function, and a New Upper Bound for the de {{Bruijn}}--{{Newman}} Constant},
  author = {Polymath, D. H. J.},
  year = 2019,
  journal = {Research in the Mathematical Sciences},
  volume = {6},
  number = {3},
  pages = {31},
  issn = {2522-0144},
  doi = {10.1007/s40687-019-0193-1},
  abstract = {For each t{$\in$}R, define the entire function Ht(z):={$\int$}0{$\infty$}etu2{$\Phi$}(u)cos(zu)du,where {$\Phi$} is the super-exponentially decaying function {$\Phi$}(u):={$\sum$}n=1{$\infty$}(2{$\pi$}2n4e9u-3{$\pi$}n2e5u)exp(-{$\pi$}n2e4u).This is essentially the heat flow evolution of the Riemann {$\xi$} function. From the work of de Bruijn and Newman, there exists a finite constant {$\Lambda$} (the de Bruijn--Newman constant) such that the zeroes of Ht are all real precisely when t{$\geq\Lambda$}. The Riemann hypothesis is equivalent to the assertion {$\Lambda\leq$}0; recently, Rodgers and Tao established the matching lower bound {$\Lambda\geq$}0. Ki, and Kim and Lee established the upper bound {$\Lambda$}\textexclamdown 12. In this paper, we establish several effective estimates on Ht(x+iy) for t{$\geq$}0, including some that are accurate for small or medium values of x. By combining these estimates with numerical computations, we are able to obtain a new upper bound {$\Lambda\leq$}0.22 unconditionally, as well as improvements conditional on further numerical verification of the Riemann hypothesis. We also obtain some new estimates controlling the asymptotic behavior of zeroes of Ht(x+iy) as x{$\rightarrow\infty$}.},
  keywords = {Polymath},
  file = {files/1839/Polymath - 2019 - Effective approximation of heat flow evolution of the Riemann ξ function, and a new upper bound for.pdf}
}

