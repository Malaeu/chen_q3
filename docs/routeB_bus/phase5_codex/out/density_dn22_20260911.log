Prediction log-curvature<0 atv10,w101/10,p=.90. New actual-source diagnostic; no DN22 rerun. Full script:
```python
from flint import arb, ctx
import time

started = time.monotonic()
ctx.prec = 256
pi, v = arb.pi(), arb(10)
# r(t)=4 sum a_n^2 (t-3/(2a_n)) exp(-a_n t), a_n=pi*n^2.
# For n>=2: n^2>=4+5(n-2) and n<=2^(n-1).
def power_tail(power):
    return 2**power * (-40*pi).exp() / (1-2**power*(-50*pi).exp())

e = (-10*pi).exp()
first = [4*pi**2*(10-3/(2*pi))*e,
         4*pi**2*(arb(5)/2-10*pi)*e,
         4*pi**3*(10*pi-arb(7)/2)*e]
tails = [40*pi**2*power_tail(4),
         40*pi**3*power_tail(6),
         40*pi**4*power_tail(8)]
r = first[0].union(first[0]+tails[0])
rp = first[1].union(first[1]-tails[1])
rpp = first[2].union(first[2]+tails[2])
assert r > 0
lv = arb(5)/(2*v)+2*rp/r
lvv = -arb(5)/(2*v**2)+2*(rpp/r-(rp/r)**2)
wp, wpp = 1-1/v**2, 2/v**3
curvature = (lvv*wp-lv*wpp)/wp**3
main_lv = arb(5)/(2*v)+2/(v-3/(2*pi))-2*pi
main_lvv = -arb(5)/(2*v**2)-2/(v-3/(2*pi))**2
main = (main_lvv*wp-main_lv*wpp)/wp**3
for name, value in zip(('r','r_prime','r_second','tail0','tail1','tail2'),
                       (r,rp,rpp,*tails)):
    print(name, value.str(55))
print('v',v.str(), 'w',(v+1/v).str())
print('log_hyperbolic_product_curvature',curvature.str(55))
print('main_term_curvature',main.str(55))
assert curvature < arb('-0.035')
assert curvature > arb('-0.037')
print('HCM_CURVATURE_EXIT=0 elapsed_seconds',time.monotonic()-started)
```

