from pathlib import Path
import json
import signal
import time
import traceback
from flint import arb, acb, ctx

# One bounded DN22 calculation. The residue identity is a separate proof obligation.
# All numbers below remain balls; no float conversion of mathematical quantities.
ctx.dps = 70
started = time.monotonic()
print('DN22_SCRIPT_BEGIN\n' + Path(__file__).read_text() + '\nDN22_SCRIPT_END', flush=True)

def timeout(signum, frame):
    raise TimeoutError('Fixed 300-second computation budget exhausted')

signal.signal(signal.SIGALRM, timeout)
signal.alarm(300)

try:
    pi = arb.pi()
    beta, ell = arb(5)/2, arb(9)/2
    cutoff, nmax = 3, 129  # Exactly 128 residues, n=2,...,129.
    mean = arb(3)/(4*pi)
    coefficients = []
    for n in range(2, nmax+1):
        t = (arb(n*n+1)/2).sqrt()
        s, c = (pi*t).sin(), (pi*t).cos()
        p = 16*arb(n**4)/(pi*pi*(n*n-1)**2*t*t)
        a = p*s*s
        b = p*(-s*c/(2*t)+s*s*(1/(2*pi*t*t)+2/(pi*(n*n-1))-arb(3)/(2*pi*n*n)))
        coefficients.append((a,b))

    def H(u):
        out = u-mean
        term = (-3*pi*u).exp()
        factor = (-5*pi*u).exp()
        step = (-2*pi*u).exp()
        for a,b in coefficients:
            out += (a*u+b)*term
            term *= factor
            factor *= step
        return out

    def phi(x):
        up, down = (2*x).exp(), (-2*x).exp()
        return ((beta*x-pi*up).exp()*H(up)+(-beta*x-pi*down).exp()*H(down))/2

    def F(w):
        z = pi*w.sqrt()
        return z.sinh()/z

    def LZ(z):
        return z*z/(4*pi*pi*F(z/pi-1)**2)

    # Uniform source-component error, conditional on the residue identity.
    u0 = arb(-2*cutoff).exp()
    z0 = arb(50000)
    p0 = (z0*u0).exp()*LZ(z0)/LZ(z0/2)
    d_out = ((2*ell*cutoff-pi*arb(2*cutoff).exp()).exp()+p0)/2
    tau = (7*u0/(nmax+1)**2+arb(10)/(nmax+1)**3)
    tau *= (-pi*((nmax+1)**2-1)*u0).exp()
    tau /= 1-(-pi*(2*nmax+3)*u0).exp()
    d_in = ((beta+ell)*cutoff).exp()*tau
    delta = d_in+d_out
    j2 = 12+arb(8)/9+arb(2)/81
    entry_error = (2*delta+delta*delta)*j2
    print('SOURCE_ERROR_BUDGET', json.dumps({
        'C': '1 (positive scaling; original determinant multiplied by C^4)',
        'residue_identity': 'PENDING_INDEPENDENT_ANALYTIC_PROOF',
        'residue_indices': '2..129', 'cutoff': '3', 'Chernoff_z': '50000',
        'p0': str(p0), 'H_series_tail': str(tau),
        'component_inside_weighted_error': str(d_in),
        'component_outside_weighted_error': str(d_out),
        'whole_V_entry_error': str(entry_error),
    }), flush=True)
    print('H_SAMPLE', {str(u): str(H(arb(u))) for u in ['0.01','0.1','1']}, flush=True)

    values = {}
    for i,j in [(1,1),(1,-1),(1,2),(1,-2),(2,2),(2,-2)]:
        value = acb(0)
        calls = [0]
        for half in range(10):
            left, right = arb(half)/2, arb(half+1)/2
            midpoint = (half+0.5)/2  # Segment selection only; no mathematical ball conversion.
            if abs(i+midpoint) >= cutoff or abs(j+midpoint) >= cutoff:
                continue
            def integrand(v, analytic):
                calls[0] += 1
                # This finite exponential formula is entire; each segment has fixed cutoff branches.
                return (i+j+2*v)*phi(v+i)*phi(v+j)
            part = acb.integral(integrand, left, right, rel_tol=arb('1e-22'),
                                abs_tol=arb('1e-46'), deg_limit=120,
                                eval_limit=2000, depth_limit=16)
            value += part
            print('QUADRATURE_SEGMENT', i,j,half,str(part), 'calls',calls[0],flush=True)
        assert value.imag.contains(0), (i,j,value)
        values[(i,j)] = value.real+arb(0,entry_error.upper())
        print('V_ENTRY',i,j,str(values[(i,j)]),flush=True)
    m11=values[(1,1)]-values[(1,-1)]
    m12=values[(1,2)]-values[(1,-2)]
    m22=values[(2,2)]-values[(2,-2)]
    determinant=m11*m22-m12*m12
    decision='UNRESOLVED_ENCLOSURE'
    if bool(determinant<0) or bool(m11<0) or bool(m22<0):
        decision='NEGATIVE_CELL_CONDITIONAL_ON_RESIDUE_IDENTITY'
    elif bool(determinant>0) and bool(m11>0) and bool(m22>0):
        decision='POSITIVE_CELL_CONDITIONAL_ON_RESIDUE_IDENTITY'
    print('DN22_RESULT',json.dumps({'M11':str(m11),'M12':str(m12),'M22':str(m22),
          'determinant':str(determinant),'decision':decision,
          'seconds':round(time.monotonic()-started,3)}),flush=True)
    signal.alarm(0)
    print('DN22_PROCESS_EXIT=0',flush=True)
except BaseException:
    traceback.print_exc()
    print('DN22_PROCESS_EXIT=1',flush=True)
    raise

DN22_SCRIPT_END
