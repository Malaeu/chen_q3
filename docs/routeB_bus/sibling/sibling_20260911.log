from pathlib import Path
import sympy as s,time,traceback,sys,os
start=time.monotonic()
print('SIBLING_ALGEBRA_LAUNCH',os.getpid(),flush=True)
print('RECIPE_BEGIN\n'+Path(__file__).read_text()+'RECIPE_END',flush=True)
try:
 for g in (1,2,3):
  N=2*g; z,w=s.symbols('z w'); middle=s.symbols('a1:'+str(g+1));a=[s.Integer(1),*middle,*reversed(middle[:-1]),s.Integer(1)]
  assert len(a)==N+1
  A=sum(a[j]*z**j for j in range(N+1));Aw=A.subs(z,w)
  V=s.Matrix(N,N,lambda p,q:sum((N-p-q+2*t)*a[p-t]*a[q-t] for t in range(min(p,q)+1)))
  K=sum(V[p,q]*z**p*w**q for p in range(N) for q in range(N))
  assert s.expand((1-z*w)*K-(N*A*Aw-z*s.diff(A,z)*Aw-w*A*s.diff(Aw,w)))==0
  powers=[s.Integer(N)]
  for k in range(1,N):powers.append(s.expand(-sum(a[j]*powers[k-j] for j in range(1,k))-k*a[k]))
  M=s.Matrix(N,N,lambda i,j:powers[abs(i-j)])
  B=s.Matrix(N,N,lambda p,k:a[N-1-p-k] if k<=N-1-p else 0)
  assert all(s.expand(x)==0 for x in V-B*M*B.T)
  assert B.det() in (-1,1)
  print('EXACT_GENUS',g,'KERNEL_AND_NEWTON_CONGRUENCE_PASS','DET_B',B.det(),flush=True)
 z,t,u=s.symbols('z t u');A=z*z+1;N=2
 F=s.expand((t+s.I)**N*A.subs(z,(t-s.I)/(t+s.I))).cancel().expand()
 L=s.expand((1+t*t)*s.diff(F,t)-N*t*F)
 bez=s.cancel((F*L.subs(t,u)-L*F.subs(t,u))/(4*(t-u)))
 assert s.expand(bez-4*(1+t*u))==0
 print('CAYLEY_GENUS1_PASS',bez,flush=True)
 V=s.Matrix([[2,-3],[-3,2]]);c=s.Matrix([1,1]);assert (c.T*V*c)[0]==-2
 print('OFF_CIRCLE_WITNESS',-2,flush=True)
 g=2;N=4;a=[1,-4,6,-4,1]
 V=s.Matrix(N,N,lambda p,q:sum((N-p-q+2*t)*a[p-t]*a[q-t] for t in range(min(p,q)+1)))
 b=s.Matrix([-1,3,-3,1]);assert V==4*b*b.T
 print('MULTIPLE_UNIT_ROOT_RANK',V.rank(),flush=True)
 print('SIBLING_ALGEBRA_SECONDS',round(time.monotonic()-start,6),flush=True)
 print('SIBLING_ALGEBRA_PROCESS_EXIT=0',flush=True)
except BaseException:
 traceback.print_exc();print('SIBLING_ALGEBRA_PROCESS_EXIT=1',flush=True);sys.exit(1)
RECIPE_END
