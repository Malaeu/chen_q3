	keywords = {Mathematics - Number Theory},
	annote = {Comment: 61 pages, no figures. This paper is the published version, but with some corrections to Section 8 to address some issues pointed out by Ofer Zeitouni that tretament of the boundary contributions to the energy was previously inadequate},
	file = {Full Text PDF:/home/chirurgie/Zotero/storage/LTBYRPFU/Rodgers und Tao - 2021 - The De Bruijn-Newman constant is non-negative.pdf:application/pdf;Snapshot:/home/chirurgie/Zotero/storage/DEFZIFT5/1801.html:text/html},
