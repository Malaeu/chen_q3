@article{malamutmannOperatorGeometricProof2025b,
	title = {Operator–{Geometric} {Proof} of the {Riemann} {Hypothesis} via the {Positivity} of the {Weil} {Functional}},
	url = {https://zenodo.org/records/17538227},
	doi = {10.5281/zenodo.17538227},
	abstract = {We present an operator–analytic framework connecting the Weil criterion for the Riemann Hypothesis with the geometry of a functional manifold associated with the zeta function. Through a sequence of analytic modules (T₀–A₃–RKHS–T₅), the positivity of the quadratic form Q(Φ) is extended from compact subspaces to the full Weil class, establishing global non-negative curvature on the functional sphere of ζ(s) with the critical line Re(s)=1/2 as the unique geodesic of zero curvature. The proof is entirely analytic, self-contained, and modular.},
	urldate = {2025-11-06},
	publisher = {Zenodo},
	author = {Malamutmann, Eugen},
	month = nov,
	year = {2025},
	keywords = {Riemann Hypothesis, Weil Criterion, Operator Theory, Functional Analysis, RKHS, Toeplitz Operators, Number Theory},
	file = {Full Text PDF:/home/chirurgie/Zotero/storage/WK2SL8B3/Malamutmann - 2025 - Operator–Geometric Proof of the Riemann Hypothesis via the Positivity of the Weil Functional.pdf:application/pdf},
}

