        "registration_rule": {"const": "EVENT_REGISTERED_ONLY_ON_CANONICAL_FIRST_PARENT_CHAIN"},
        "merge_rule": {"const": "MERGE_RESULT_MUST_PREFIX_EXTEND_PREMERGE_FIRST_PARENT"},
