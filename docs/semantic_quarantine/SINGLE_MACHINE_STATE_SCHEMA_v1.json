          ]
        },
        "role": {"enum": ["GENERATED_VIEW", "HISTORICAL"]},
        "note": {"type": "string", "minLength": 1},
        "exception_glob": {"type": "string", "minLength": 1},
        "exception_paths": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalPath"}
        }
      }
    }
