                  "component_ids": {"const": ["PHYSICAL_BUS_GOAL"]},
                  "aggregate_role": {"const": "PROJECT_STATE_AGGREGATES_BUT_DOES_NOT_REPLACE_DOMAIN_AUTHORITY"}
