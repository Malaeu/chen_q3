            {"contains": {"type": "object", "properties": {"id": {"const": "CHANNEL_RUNTIME"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"id": {"const": "SEMANTIC_QUARANTINE"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"id": {"const": "ROUTE_B_EXECUTION_STATE"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
