            "facts": {"$ref": "#/$defs/hashRef"},
            "execution": {"$ref": "#/$defs/hashRef"},
            "events": {"$ref": "#/$defs/hashRef"},
            "surface_registry": {"$ref": "#/$defs/hashRef"},
            "schema": {"$ref": "#/$defs/hashRef"},
            "builder_program": {"$ref": "#/$defs/hashRef"},
            "selector_program": {"$ref": "#/$defs/hashRef"}
