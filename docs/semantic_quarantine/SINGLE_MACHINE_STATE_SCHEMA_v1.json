        },
        "event_log": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "tail_sha256"],
          "properties": {
            "count": {"type": "integer", "minimum": 1},
            "tail_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "component_hashes": {
          "type": "array",
          "items": {"$ref": "#/$defs/hashRef"}
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_goal_id", "selected_goal_path", "route_b_rank", "route_b_rh_status", "unconditional_rh_proof", "public_export_receipt_path"],
          "properties": {
            "selected_goal_id": {"type": "string", "pattern": "^[0-9]{3}$"},
            "selected_goal_path": {"$ref": "#/$defs/canonicalPath"},
            "route_b_rank": {"const": "CHALLENGER"},
            "route_b_rh_status": {"const": "NOT_RH"},
            "unconditional_rh_proof": {"const": false},
            "public_export_receipt_path": {"$ref": "#/$defs/canonicalPath"}
          }
        }
      }
    },
