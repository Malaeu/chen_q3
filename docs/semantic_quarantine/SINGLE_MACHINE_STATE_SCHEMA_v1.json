{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "q3_single_machine_state.schema.v1",
  "title": "Q3 single machine state schemas",
  "oneOf": [
    {"$ref": "#/$defs/projectFacts"},
    {"$ref": "#/$defs/projectExecutionState"},
    {"$ref": "#/$defs/projectState"},
    {"$ref": "#/$defs/statusSurfaceRegistry"}
  ],
  "$defs": {
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"pattern": "^[^/\\\\](?:[^\\\\]*[^/\\\\])?$"},
        {"not": {"pattern": "(^|/)\\.{1,2}(/|$)"}},
        {"not": {"pattern": "//"}}
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "projectFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "public_claims", "route_facts", "receipts"],
      "properties": {
        "schema": {"const": "q3_project_facts.v1"},
        "version": {"const": 1},
        "public_claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unconditional_rh_proof", "compiled_broad_cone_export", "public_canonical_export"],
          "properties": {
            "unconditional_rh_proof": {"const": false},
            "compiled_broad_cone_export": {"const": "CONDITIONAL_LEGACY"},
            "public_canonical_export": {"const": "OPEN"}
          }
        },
        "route_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_b_rank", "route_b_rh_status", "owner_boundary"],
          "properties": {
            "route_b_rank": {"const": "CHALLENGER"},
            "route_b_rh_status": {"const": "NOT_RH"},
            "owner_boundary": {"const": "PX_RH_CLAIM"}
          }
        },
        "receipts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"type": "object", "properties": {"path": {"const": "docs/semantic_quarantine/PUBLIC_EXPORT_INDEX_AND_AXIOM_RECEIPT_v1.md"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"path": {"const": "docs/semantic_quarantine/MODULE_CLASS_REGISTRY_v1.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1}
          ],
          "items": {"$ref": "#/$defs/hashRef"}
        }
      }
    },
    "projectExecutionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "selector", "authority_domains", "component_states"],
      "properties": {
        "schema": {"const": "q3_project_execution_state.v1"},
        "version": {"const": 1},
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "selected_goal_id", "selected_goal_path", "phase_key_sha256", "selector_program"],
          "properties": {
            "action": {"const": "SELECT_EXACT_GOAL"},
            "selected_goal_id": {"type": "string", "pattern": "^[0-9]{3}$"},
            "selected_goal_path": {"$ref": "#/$defs/canonicalPath"},
            "phase_key_sha256": {"$ref": "#/$defs/sha256"},
            "selector_program": {"const": "orchestrator/goal_runtime.py"}
          }
        },
        "authority_domains": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
