              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["domain", "authority_order", "component_ids", "aggregate_role"],
                "properties": {
                  "domain": {"const": "CODEX_TASK_SELECTION"},
                  "authority_order": {"const": ["CODEX_CURRENT"]},
                  "component_ids": {"const": ["CODEX_CURRENT"]},
