            {"contains": {"type": "object", "properties": {"id": {"const": "PHYSICAL_BUS_GOAL"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"id": {"const": "SESSION_ENTRY_ROUTER"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"id": {"const": "SESSION_ENTRY_ROUTER_CANONICAL"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
