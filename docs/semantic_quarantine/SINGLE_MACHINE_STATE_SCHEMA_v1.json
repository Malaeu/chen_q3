        "phase_text": {"const": "Phase P5 — one authoritative state, generated views"},
        "board_acceptance_ids": {
          "type": "array", "minItems": 9, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^P[0-9]+\\.[0-9]{3}$"}
        },
        "acceptance_text": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
