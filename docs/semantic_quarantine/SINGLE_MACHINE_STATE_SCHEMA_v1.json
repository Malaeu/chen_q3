          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "role"],
                "properties": {
                  "id": {"const": "PHYSICAL_BUS_GOAL"},
                  "role": {"const": "SELECTOR_INPUT"}
                }
              },
              {"const": {"id": "SESSION_ENTRY_ROUTER", "path": "SESSION_ENTRY.md", "role": "SCOPED_SELECTOR_ALIAS"}},
              {"const": {"id": "SESSION_ENTRY_ROUTER_CANONICAL", "path": "q3.lean.aristotle/ACTIVE/SESSION_ENTRY.md", "role": "SCOPED_SELECTOR_CANONICAL"}},
              {"const": {"id": "CODEX_CURRENT", "path": "docs/Codex/CURRENT.md", "role": "SCOPED_SELECTOR"}},
              {"const": {"id": "CHANNEL_RUNTIME", "path": "orchestrator/state/CHANNEL_RUNTIME.json", "role": "RUNTIME_COMPONENT"}},
              {"const": {"id": "SEMANTIC_QUARANTINE", "path": "orchestrator/state/SEMANTIC_QUARANTINE.json", "role": "SEMANTIC_COMPONENT"}},
              {"const": {"id": "ROUTE_B_EXECUTION_STATE", "path": "q3.lean.aristotle/ACTIVE/requests/routeB_twolevel_spectral_ladder/ROUTE_B_EXECUTION_STATE.json", "role": "RUNTIME_COMPONENT"}},
              {"const": {"id": "ROUTE_B_FACT_HISTORY", "path": "q3.lean.aristotle/ACTIVE/requests/routeB_twolevel_spectral_ladder/ROUTE_B_STATE.md", "role": "FACT_HISTORY"}}
            ]
          }
        }
      }
    },
    "projectState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "authority", "source_hashes", "event_log", "component_hashes", "projection"],
      "properties": {
        "schema": {"const": "q3_project_state.v1"},
