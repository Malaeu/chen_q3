{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "q3.portability_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pattern_ids", "scanner_bootstrap_paths", "active_clean_paths", "active_machine_local_registries", "active_append_history_surfaces", "historical_hits", "symlinks"],
  "properties": {
    "schema_version": {"const": "q3.portability_manifest.v1"},
    "pattern_ids": {
      "type": "array",
      "items": {"enum": ["HOME_USERS", "MOUNT_ROOT", "HOME_ROOT", "STALE_REPO_MAC"]},
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "scanner_bootstrap_paths": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "class"],
        "properties": {"path": {"type": "string", "minLength": 1}, "class": {"const": "SCANNER_BOOTSTRAP"}}
      }
    },
    "active_clean_paths": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "class"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "class": {"const": "ACTIVE_PORTABLE"},
          "repo_relative_to": {"const": "GIT_TOPLEVEL"},
          "canonical_repo_path_consumer_count": {"const": 0}
        }
      },
      "minItems": 24,
      "uniqueItems": true
    },
    "active_machine_local_registries": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "class", "allowed_candidate_path_field", "evidence", "sha256"],
        "properties": {
          "path": {"const": "docs/cartographer/lean_bases.yaml"},
          "class": {"const": "ACTIVE_MACHINE_LOCAL_REGISTRY"},
          "allowed_candidate_path_field": {"const": "bases[*].paths"},
          "evidence": {"const": "MACHINE_CANDIDATES_ONLY_NOT_CANONICAL_REPO_LOCATORS"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "active_append_history_surfaces": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "class", "classification_basis", "validation"],
        "properties": {
          "path": {"const": "docs/routeB_bus/PROSHKA_QUEUE.md"},
          "class": {"const": "ACTIVE_APPEND_ONLY_HISTORY"},
          "classification_basis": {"const": "P5_STATUS_SURFACE_REGISTRY_HISTORICAL_APPEND_QUEUE"},
          "validation": {"const": "FIRST_PARENT_FULL_BYTE_PREFIX_CHAIN_ANCHORED_AT_FREEZE"}
        }
      }
    },
    "historical_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "class", "classification_basis", "sha256", "pattern_ids"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "class": {"const": "HISTORICAL_PINNED"},
          "classification_basis": {"const": "EXACT_PATH_AND_SHA256_P7_REVIEWED_BASELINE"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "pattern_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "symlinks": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "class", "target", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "class": {"const": "TRACKED_RELATIVE_SYMLINK"},
          "target": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
