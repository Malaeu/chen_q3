# Local/agent artifacts
# Note: .claude/* not .claude/ -- git will not descend into an excluded
# directory, so a later negation inside it never applies. Excluding the
# contents instead leaves the directory walkable.
.claude/*
# Skills are project knowledge, not local scratch: they must survive a clone
# and a session restart, so they are versioned with the repo.
!.claude/skills/
multiagent/
full/q3.lean.aristotle/docs/cc_15_01_26.md

# Aristotle output files
*-output.lean
output.lean
sandboxes/
.venv/

# Raw Aristotle transactions are a local intake/quarantine area.  Historical
# files already tracked by Git remain tracked; new jobs must be promoted to a
# canonical source/record path before they are committed.
/q3.lean.aristotle/aristotle_output/

# Python
__pycache__/
venv_djo/

# Generated / local-only artifacts
full/q3.lean.aristotle/ACTIVE/IMPORT_DEPS.dot

# Local PDF dumps (use docs/links/* instead of committing binaries)
q3.lean.aristotle/literature/quillen_working_papers/
full/q3.lean.aristotle/literature/quillen_working_papers/

# Local cleanup buckets for transient untracked files
q3.lean.aristotle/archive/untracked_cleanup_*/
q3.lean.aristotle/.qmd_cache/

# leanblueprint build products (generated sources and manifest stay tracked)
q3.lean.aristotle/blueprint/print/
q3.lean.aristotle/blueprint/web/
q3.lean.aristotle/blueprint/lean_decls
q3.lean.aristotle/blueprint/src/web.bbl

# Local vendor clones for external AI/research artifacts
archive/subprojects/erdos-minimum-overlap/

# window screenshots taken while calibrating the desktop lane
orchestrator/state/*.png

# Machine-local, regenerable sensor state — rebuild with
#   python3 orchestrator/observability.py rebuild
# (schema and generator ARE tracked; the database is not).
# The one canonical project database stays tracked at
# q3.lean.aristotle/aristotle_db/knowledge.db.  The exact paths below are
# zero-byte SQLite decoys created by local tooling and must never masquerade as
# the canonical database.
q3.lean.aristotle/aristotle_db/observability.db
/knowledge.db
/orchestrator/knowledge.db
/orchestrator/observability.db
/orchestrator/state/observability.db
/q3.lean.aristotle/aristotle_db/proofs.db

# браузерные сессии MCP — рабочий мусор, в репу не нужен
.playwright-mcp/
