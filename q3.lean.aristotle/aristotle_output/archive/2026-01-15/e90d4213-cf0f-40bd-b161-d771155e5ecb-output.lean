          exact W_K_boundary_vanish K hK _ ⟨ hΦ_cont, hΦ_support, hΦ_even, hΦ_nonneg ⟩ |>.2) ε hε_pos;
          refine' ⟨ _, ⟨ n, τ, fun i => Φ ( τ i ), δ, _, _, _, rfl ⟩, hg.2 ⟩ <;> aesop