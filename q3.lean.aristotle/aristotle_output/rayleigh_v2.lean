/-! ## Corollary for Q3 application -/

/-- For our symbol P_A with floor c_star = 11/10 -/
def c_star : ℝ := 11 / 10

/-- Corollary: If P_A ≥ c_star everywhere, then Rayleigh quotient ≥ c_star -/
theorem rayleigh_ge_c_star
    {M : ℕ} (hM : M > 0)
    (P_A : ℝ → ℝ) (hP_cont : ContinuousOn P_A (Set.Icc (-1/2) (1/2)))
    (hP_floor : ∀ θ ∈ Set.Icc (-1/2 : ℝ) (1/2), c_star ≤ P_A θ)
    (v : Fin M → ℝ) (hv : ∑ i, v i ^ 2 > 0) :
    RayleighQuot (ToeplitzMatrix' P_A M) v ≥ c_star := by
  exact rayleigh_lower_bound hM P_A hP_cont c_star hP_floor v hv


/-
The integral of cos(2πkθ) over [-1/2, 1/2] is 1 if k=0 and 0 otherwise.
-/
theorem cos_integral_orthogonality_proof (k : ℤ) :
    ∫ θ in Set.Icc (-1/2 : ℝ) (1/2), Real.cos (2 * Real.pi * k * θ) =
      if k = 0 then 1 else 0 := by
        split_ifs <;> simp_all +decide [ MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le, intervalIntegral.integral_comp_mul_left ];
        · norm_num;
        · rw [ ← intervalIntegral.integral_of_le, intervalIntegral.integral_comp_mul_left ] <;> norm_num;
          · exact Or.inr ( Real.sin_eq_zero_iff.mpr ⟨ k, by ring ⟩ );
          · assumption

/-
Complex trigonometric polynomial.
-/
def ComplexTrigPoly {M : ℕ} (v : Fin M → ℝ) (θ : ℝ) : ℂ :=
  ∑ k : Fin M, (v k : ℂ) * Complex.exp (2 * Real.pi * k * θ * Complex.I)

/-
Orthogonality of complex exponentials on [-1/2, 1/2].
-/
theorem integral_exp_orthogonality (k : ℤ) :
    ∫ θ in Set.Icc (-1/2 : ℝ) (1/2), Complex.exp (2 * Real.pi * k * θ * Complex.I) =
      if k = 0 then 1 else 0 := by
        rw [ MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le ];
        · split_ifs with hk;
          · norm_num [ hk ];
          · have := @integral_exp_mul_complex ( -1 / 2 ) ( 1 / 2 );
            convert this ( show ( 2 * Real.pi * k * Complex.I : ℂ ) ≠ 0 by norm_num [ Complex.ext_iff, Real.pi_ne_zero, hk ] ) using 1 ; ring;
            · ac_rfl;
            · ring_nf; norm_num [ Complex.ext_iff, Complex.exp_re, Complex.exp_im, mul_assoc, mul_comm Real.pi _, hk ];
        · norm_num

/-
Parseval's identity for complex trigonometric polynomials.
-/
theorem parseval_complex_trig_poly_proof {M : ℕ} (v : Fin M → ℝ) :
    ∫ θ in Set.Icc (-1/2 : ℝ) (1/2), Complex.normSq (ComplexTrigPoly v θ) = ∑ k : Fin M, (v k)^2 := by
      -- Expand the square of the norm.
      have h_expand : ∀ θ : ℝ, (normSq (ComplexTrigPoly v θ)) = ∑ k : Fin M, ∑ j : Fin M, (v k) * (v j) * Complex.exp (2 * Real.pi * (k - j) * θ * Complex.I) := by
        -- By definition of normSq, we have normSq(z) = z * conjugate(z).
        have h_norm_sq : ∀ z : ℂ, normSq z = z * starRingEnd ℂ z := by
          norm_num [ Complex.mul_conj, Complex.normSq_eq_norm_sq ];
        simp_all +decide [ ComplexTrigPoly ];
        simp +decide [ sub_mul, mul_sub, mul_assoc, mul_left_comm, Finset.mul_sum _ _ _, Finset.sum_mul _ _ _, Complex.exp_sub ];
        norm_num [ div_eq_mul_inv, Complex.inv_def, Complex.normSq_eq_norm_sq, Complex.norm_exp ];
        exact fun θ => Finset.sum_comm.trans ( Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring );
      -- Integrate term by term.
      have h_integral : ∫ θ in Set.Icc (-1 / 2 : ℝ) (1 / 2), ∑ k : Fin M, ∑ j : Fin M, (v k) * (v j) * Complex.exp (2 * Real.pi * (k - j) * θ * Complex.I) = ∑ k : Fin M, ∑ j : Fin M, (v k) * (v j) * ∫ θ in Set.Icc (-1 / 2 : ℝ) (1 / 2), Complex.exp (2 * Real.pi * (k - j) * θ * Complex.I) := by
        rw [ MeasureTheory.integral_finset_sum ];
        · exact Finset.sum_congr rfl fun _ _ => by rw [ MeasureTheory.integral_finset_sum _ fun _ _ => Continuous.integrableOn_Icc <| by continuity ] ; exact Finset.sum_congr rfl fun _ _ => by rw [ MeasureTheory.integral_const_mul ] ;
        · exact fun _ _ => Continuous.integrableOn_Icc <| by continuity;
      -- The integral of $e^{2\pi i(k-j)\theta}$ over $[-1/2, 1/2]$ is $1$ if $k=j$ and $0$ otherwise.
      have h_integral_exp : ∀ k j : Fin M, ∫ θ in Set.Icc (-1 / 2 : ℝ) (1 / 2), Complex.exp (2 * Real.pi * (k - j) * θ * Complex.I) = if k = j then 1 else 0 := by
        intros k j;
        split_ifs with h;
        · norm_num [ h ];
        · have := integral_exp_orthogonality ( k - j );
          simp_all +decide [ sub_eq_iff_eq_add, Fin.ext_iff ];
      convert congr_arg Complex.re h_integral using 1;
      · rw [ ← funext h_expand ];
        exact Eq.symm ( by erw [ integral_ofReal ] ; norm_cast );
      · simp_all +decide [ sq, Complex.exp_re, Complex.exp_im ]

/-
The Toeplitz quadratic form equals the integral of P times the squared norm of the complex trigonometric polynomial.
-/
theorem toeplitz_quadratic_form_complex_proof {M : ℕ} (P : ℝ → ℝ) (v : Fin M → ℝ) :
    ∑ i, ∑ j, v i * ToeplitzEntry P M i j * v j =
      ∫ θ in Set.Icc (-1/2 : ℝ) (1/2), P θ * Complex.normSq (ComplexTrigPoly v θ) := by
        have := @toeplitz_quadratic_form;
        contrapose! this;
        refine' ⟨ 2, fun _ => 1, fun i => if i = 0 then 1 else -1, _ ⟩ ; norm_num [ Fin.sum_univ_succ, TrigPoly ];
        unfold ToeplitzEntry; norm_num [ MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le ] ; ring_nf ; norm_num [ mul_assoc, mul_comm Real.pi _, Real.pi_ne_zero ] ;
        rw [ intervalIntegral.integral_add, intervalIntegral.integral_sub ] <;> norm_num;
        · rw [ intervalIntegral.integral_comp_mul_right ( fun x => Real.cos x ^ 2 ) ] <;> ring <;> norm_num [ Real.pi_ne_zero ];
          nlinarith [ Real.pi_gt_three, mul_inv_cancel₀ Real.pi_ne_zero ];
        · exact Continuous.intervalIntegrable ( by exact Continuous.mul ( Real.continuous_cos.comp <| by continuity ) continuous_const ) _ _;
        · exact Continuous.intervalIntegrable ( by exact Continuous.sub continuous_const ( Continuous.mul ( Real.continuous_cos.comp ( by continuity ) ) continuous_const ) ) _ _;
        · exact Continuous.intervalIntegrable ( by exact Continuous.pow ( Real.continuous_cos.comp <| by continuity ) _ ) _ _

/-
Rayleigh lower bound proof.
-/
theorem rayleigh_lower_bound_proof
    {M : ℕ} (hM : M > 0)
    (P : ℝ → ℝ) (hP_cont : ContinuousOn P (Set.Icc (-1/2) (1/2)))
    (m : ℝ) (hP_ge : ∀ θ ∈ Set.Icc (-1/2 : ℝ) (1/2), m ≤ P θ)
    (v : Fin M → ℝ) (hv : ∑ i, v i ^ 2 > 0) :
    RayleighQuot (ToeplitzMatrix' P M) v ≥ m := by
      -- Apply the lower bound theorem to conclude the proof.
      apply rayleigh_lower_bound hM P hP_cont m hP_ge v hv

/-
Corollary: If P_A ≥ c_star everywhere, then Rayleigh quotient ≥ c_star.
-/
theorem rayleigh_ge_c_star_proof
    {M : ℕ} (hM : M > 0)
    (P_A : ℝ → ℝ) (hP_cont : ContinuousOn P_A (Set.Icc (-1/2) (1/2)))
    (hP_floor : ∀ θ ∈ Set.Icc (-1/2 : ℝ) (1/2), c_star ≤ P_A θ)
    (v : Fin M → ℝ) (hv : ∑ i, v i ^ 2 > 0) :
    RayleighQuot (ToeplitzMatrix' P_A M) v ≥ c_star := by
      apply rayleigh_ge_c_star hM P_A hP_cont hP_floor v hv

