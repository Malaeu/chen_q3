/-- Lemma 3: Operator Subtraction -/
lemma quadform_sub_ge
  (n : ℕ) (S R : Matrix (Fin n) (Fin n) ℝ) (c : ℝ)
  (hS : ∀ v : Fin n → ℝ, (∑ i, ∑ j, v i * S i j * v j) ≥ c * (∑ i, v i ^ 2))
  (hR_psd : ∀ v : Fin n → ℝ, 0 ≤ (∑ i, ∑ j, v i * R i j * v j))
  (hR_norm : ∀ v : Fin n → ℝ, (∑ i, ∑ j, v i * R i j * v j) ≤ (c / 4) * (∑ i, v i ^ 2)) :
  ∀ v : Fin n → ℝ, (∑ i, ∑ j, v i * (S - R) i j * v j) ≥ (3 * c / 4) * (∑ i, v i ^ 2) := by
    exact fun v => by have := hS v; have := hR_norm v; norm_num [ Matrix.sub_apply, sub_mul, mul_sub ] at *; linarith;

