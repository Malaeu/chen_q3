/-
`GammaSeq` is differentiable at `z` if `z` is not a pole.
-/
lemma differentiableAt_GammaSeq (z : ℂ) (n : ℕ) (hz : ∀ k ≤ n, z ≠ -k) :
    DifferentiableAt ℂ (fun w => Complex.GammaSeq w n) z := by
      apply_rules [ DifferentiableAt.div, DifferentiableAt.const_mul ];
      · exact DifferentiableAt.mul ( DifferentiableAt.const_cpow ( differentiableAt_id ) ( by aesop ) ) ( differentiableAt_const _ );
      · induction' ( Finset.range ( n + 1 ) ) using Finset.induction <;> aesop;
      · exact Finset.prod_ne_zero_iff.mpr fun i hi => add_eq_zero_iff_eq_neg.not.mpr <| hz i <| Finset.mem_range_succ_iff.mp hi

/-
The exponential part of `GammaSeq` converges uniformly on compact sets.
-/
lemma GammaSeq_exp_part_uniform_correct (S : Set ℂ) (hS : IsCompact S) :
    TendstoUniformlyOn (fun (n : ℕ) (z : ℂ) => Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))))
    (fun z => Complex.exp (z * -Real.eulerMascheroniConstant)) Filter.atTop S := by
      exact GammaSeq_exp_part_uniform_v4 S hS

/-
The derivative of `GammaSeq` converges locally uniformly to the derivative of `Gamma` on the right half-plane.
-/
lemma deriv_GammaSeq_tendstoLocallyUniformlyOn (S : Set ℂ) (hS : S ⊆ {z | 0 < z.re}) (hS_open : IsOpen S) :
    TendstoLocallyUniformlyOn (fun n z => deriv (fun w => Complex.GammaSeq w n) z) (deriv Complex.Gamma) Filter.atTop S := by
      -- We apply `TendstoLocallyUniformlyOn.deriv` to `GammaSeq_tendstoLocallyUniformlyOn_v9`.
      have h_apply_deriv : TendstoLocallyUniformlyOn (fun n z => Complex.GammaSeq z n) Complex.Gamma Filter.atTop S := by
        exact GammaSeq_tendstoLocallyUniformlyOn_v9 S hS hS_open
      have h_diff : ∀ᶠ n in Filter.atTop, DifferentiableOn ℂ (fun z => Complex.GammaSeq z n) S := by
        refine Filter.eventually_atTop.mpr ?_
        refine ⟨ 1, fun n hn z hz => ?_ ⟩
        exact DifferentiableAt.differentiableWithinAt (differentiableAt_GammaSeq z n fun k hk => by
          intro H
          have := hS hz
          rw [H] at this
          norm_num at this
          linarith)
      exact TendstoLocallyUniformlyOn.deriv h_apply_deriv h_diff hS_open
