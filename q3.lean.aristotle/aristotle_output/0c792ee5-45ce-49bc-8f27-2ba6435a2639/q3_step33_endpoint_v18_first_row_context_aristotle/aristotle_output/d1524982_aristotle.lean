lemma GammaSeq_tendstoLocallyUniformlyOn (S : Set ℂ) (hS : S ⊆ {z | 0 < z.re}) (hS_open : IsOpen S) :
    TendstoLocallyUniformlyOn (fun n z => Complex.GammaSeq z n) Complex.Gamma Filter.atTop S := by
      -- We prove uniform convergence by decomposing `GammaSeq` into parts and showing each part converges uniformly on compact sets.
      have h_uniform : ∀ {K : Set ℂ}, IsCompact K → K ⊆ {z | 0 < z.re} → TendstoUniformlyOn (fun n z => Complex.GammaSeq z n) Complex.Gamma Filter.atTop K := by
        intro K hK hK';
        -- We prove uniform convergence by decomposing `GammaSeq` into parts and showing each part converges uniformly on compact sets using the lemmas we have.
        have h_uniform_parts : TendstoUniformlyOn (fun (n : ℕ) (z : ℂ) => Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1)))) (fun z => Complex.exp (z * -Real.eulerMascheroniConstant)) Filter.atTop K ∧ TendstoUniformlyOn (fun (n : ℕ) (z : ℂ) => ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ)))) (fun z => Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ))))) Filter.atTop K := by
          exact ⟨ by simpa using GammaSeq_exp_part_uniform K hK, by simpa using GammaSeq_product_part_tendstoUniformlyOn K hK hK' ⟩;
        have h_uniform_parts : TendstoUniformlyOn (fun (n : ℕ) (z : ℂ) => (1 / z) * Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ)))) (fun z => (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant) * Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ))))) Filter.atTop K := by
          have h_uniform_parts : TendstoUniformlyOn (fun (n : ℕ) (z : ℂ) => (1 / z) * Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1)))) (fun z => (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant)) Filter.atTop K := by
            rw [ Metric.tendstoUniformlyOn_iff ] at *;
            intro ε hε;
            -- Since $K$ is compact and $1/x$ is continuous on $K$, there exists $M > 0$ such that $|1/x| \leq M$ for all $x \in K$.
            obtain ⟨M, hM⟩ : ∃ M > 0, ∀ x ∈ K, ‖1 / x‖ ≤ M := by
              have h_bounded : ContinuousOn (fun x : ℂ => 1 / x) K := by
                exact continuousOn_of_forall_continuousAt fun x hx => ContinuousAt.div continuousAt_const continuousAt_id ( by specialize hK' hx; aesop );
              obtain ⟨ M, hM ⟩ := IsCompact.exists_bound_of_continuousOn hK h_bounded; use Max.max M 1; aesop;
            obtain ⟨ N, hN ⟩ := Filter.eventually_atTop.mp ( h_uniform_parts.1 ( ε / ( M + 1 ) ) ( div_pos hε ( add_pos hM.1 zero_lt_one ) ) ) ; refine' Filter.eventually_atTop.mpr ⟨ N, fun n hn x hx => _ ⟩ ; specialize hN n hn x hx ; simp_all +decide [ dist_eq_norm, mul_sub ];
            rw [ ← mul_sub, norm_mul ];
            exact lt_of_le_of_lt ( mul_le_mul_of_nonneg_right ( by simpa using hM.2 x hx ) ( norm_nonneg _ ) ) ( by rw [ lt_div_iff₀ ] at hN <;> nlinarith );
          have h_uniform_parts : TendstoUniformlyOn (fun (n : ℕ) (z : ℂ) => (1 / z) * Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ)))) (fun z => (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant) * Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ))))) Filter.atTop K := by
            have h_cont : ContinuousOn (fun z => (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant)) K ∧ ContinuousOn (fun z => Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ))))) K := by
              have h_cont : ContinuousOn (fun z => ∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ)))) K := by
                have h_cont : TendstoUniformlyOn (fun n z => ∑ k ∈ Finset.range n, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ)))) (fun z => ∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ)))) Filter.atTop K := by
                  exact GammaSeq_log_term_summable_uniform K hK hK'
                refine' h_cont.continuousOn _;
                refine' Filter.Frequently.of_forall fun n => continuousOn_finset_sum _ fun i hi => ContinuousOn.sub _ _;
                · exact continuousOn_id.div_const _;
                · refine' ContinuousOn.clog _ _;
                  · exact ContinuousOn.add continuousOn_const ( ContinuousOn.div_const continuousOn_id _ );
                  · intro z hz; specialize hK' hz; simp_all +decide [ Complex.slitPlane ];
                    norm_num [ Complex.div_re, Complex.div_im ];
                    exact Or.inl ( add_pos_of_pos_of_nonneg zero_lt_one ( div_nonneg ( mul_nonneg hK'.le ( by positivity ) ) ( Complex.normSq_nonneg _ ) ) );
              exact ⟨ ContinuousOn.mul ( continuousOn_const.div continuousOn_id fun z hz => by specialize hK' hz; aesop ) ( Complex.continuous_exp.comp_continuousOn ( continuousOn_id.mul continuousOn_const ) ), Complex.continuous_exp.comp_continuousOn h_cont ⟩
            exact tendstoUniformlyOn_mul_of_compact hK h_uniform_parts ( by tauto ) ( by tauto ) ( by tauto );
          convert h_uniform_parts using 1;
        have h_uniform_parts : ∀ z ∈ K, Complex.Gamma z = (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant) * Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ)))) := by
          intro z hz
          have h_gamma_eq : Complex.Gamma z = (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant) * Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ)))) := by
            have h_gamma_seq : Filter.Tendsto (fun n => Complex.GammaSeq z n) Filter.atTop (nhds (Complex.Gamma z)) := by
              exact Complex.GammaSeq_tendsto_Gamma z
            refine' tendsto_nhds_unique h_gamma_seq _;
            have h_gamma_seq : ∀ᶠ n in Filter.atTop, Complex.GammaSeq z n = (1 / z) * Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ))) := by
              have h_gamma_seq : ∀ n : ℕ, 1 ≤ n → z.GammaSeq n = (1 / z) * Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ))) := by
                intro n hn
                apply GammaSeq_eq_product z n hn (by
                intro k hk; specialize hK' hz; contrapose! hK'; aesop;);
              exact Filter.eventually_atTop.mpr ⟨ 1, fun n hn => h_gamma_seq n hn ⟩;
            rw [ Filter.tendsto_congr' h_gamma_seq ] ; exact h_uniform_parts.tendsto_at hz |> Filter.Tendsto.comp <| Filter.tendsto_id;
          exact h_gamma_eq;
        have h_uniform_parts : ∀ z ∈ K, ∀ n : ℕ, n ≥ 1 → Complex.GammaSeq z n = (1 / z) * Complex.exp (z * (Real.log n - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ))) := by
          intros z hz n hn
          apply GammaSeq_eq_product z n hn (fun k hk => by
            exact fun h => by have := hK' hz; norm_num [ h ] at this; linarith;);
        rw [ Metric.tendstoUniformlyOn_iff ] at *;
        intro ε hε; rcases Filter.eventually_atTop.mp ( ‹∀ ε > 0, ∀ᶠ ( n : ℕ ) in Filter.atTop, ∀ x ∈ K, Dist.dist ( 1 / x * cexp ( x * - ( Real.eulerMascheroniConstant : ℂ ) ) * cexp ( ∑' k : ℕ, ( x / ( k + 1 : ℂ ) - Complex.log ( 1 + x / ( k + 1 : ℂ ) ) ) ) ) ( 1 / x * cexp ( x * ( Real.log n - ∑ k ∈ Finset.range n, 1 / ( k + 1 : ℝ ) ) ) * ∏ k ∈ Finset.range n, ( 1 + x / ( k + 1 : ℂ ) ) ⁻¹ * cexp ( x / ( k + 1 : ℂ ) ) ) < ε› ε hε ) with ⟨ N, hN ⟩ ; exact Filter.eventually_atTop.mpr ⟨ N + 1, fun n hn x hx => by rw [ ‹∀ z ∈ K, Complex.Gamma z = _› x hx, h_uniform_parts x hx n ( by linarith ) ] ; exact hN n ( by linarith ) x hx ⟩ ;
      -- Since $S$ is open and contained in the right half-plane, we can apply the uniform convergence result to any compact subset of $S$.
      have h_locally_uniform : ∀ z ∈ S, ∃ K : Set ℂ, IsCompact K ∧ K ⊆ S ∧ z ∈ interior K := by
        intro z hz
        obtain ⟨ε, hε_pos, hε⟩ : ∃ ε > 0, Metric.ball z ε ⊆ S := by
          exact Metric.isOpen_iff.mp hS_open z hz
        use Metric.closedBall z (ε / 2);
        exact ⟨ ProperSpace.isCompact_closedBall _ _, fun x hx => hε <| Metric.mem_ball.mpr <| lt_of_le_of_lt ( Metric.mem_closedBall.mp hx ) <| by linarith, mem_interior_iff_mem_nhds.mpr <| Metric.closedBall_mem_nhds _ <| half_pos hε_pos ⟩;
      rw [ Metric.tendstoLocallyUniformlyOn_iff ];
      intro ε ε_pos z hz; rcases h_locally_uniform z hz with ⟨ K, hK_compact, hK_sub, hzK ⟩ ; have := h_uniform hK_compact ( hK_sub.trans hS ) ; simp_all +decide [ Metric.tendstoUniformlyOn_iff ] ;
      rcases this ε ε_pos with ⟨ N, hN ⟩ ; exact ⟨ interior K, mem_nhdsWithin_of_mem_nhds ( IsOpen.mem_nhds ( isOpen_interior ) hzK ), N, fun n hn x hx => hN n hn x <| interior_subset hx ⟩ ;

