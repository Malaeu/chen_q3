      have h_bound : ∃ N, ∀ n ≥ N, ∀ x ∈ s, ‖f n x‖ ≤ M + 1 := by
        have := Metric.tendstoUniformlyOn_iff.mp hf 1 zero_lt_one;
        rw [ Filter.eventually_atTop ] at this; rcases this with ⟨ N, hN ⟩ ; exact ⟨ N, fun n hn x hx => by linarith [ hN n hn x hx, hM x hx, norm_sub_norm_le ( f n x ) ( g x ), dist_eq_norm' ( g x ) ( f n x ) ] ⟩ ;
      -- The exponential function is uniformly continuous on the closed ball of radius `M+1`.
      have h_exp_unif_cont : UniformContinuousOn (fun z : ℂ => Complex.exp z) (Metric.closedBall 0 (M + 1)) := by
        exact ( isCompact_closedBall _ _ |> IsCompact.uniformContinuousOn_of_continuous <| Complex.continuous_exp.continuousOn );
      rw [ Metric.uniformContinuousOn_iff ] at h_exp_unif_cont;
      rw [ Metric.tendstoUniformlyOn_iff ] at *;
      exact fun ε εpos => by rcases h_exp_unif_cont ε εpos with ⟨ δ, δpos, H ⟩ ; filter_upwards [ hf δ δpos, Filter.eventually_ge_atTop h_bound.choose ] with n hn hn' x hx using H _ ( by simpa using hM x hx |> le_trans <| by linarith ) _ ( by simpa using h_bound.choose_spec n hn' x hx ) <| by simpa [ dist_comm ] using hn x hx;

