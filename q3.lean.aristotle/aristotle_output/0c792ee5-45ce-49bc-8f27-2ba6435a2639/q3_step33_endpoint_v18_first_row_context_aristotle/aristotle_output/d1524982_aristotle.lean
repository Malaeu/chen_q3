/-
`GammaSeq` converges uniformly to `Gamma_product_limit` on compact subsets of the right half-plane.
-/
lemma GammaSeq_tendstoUniformlyOn_Gamma_product_limit (K : Set ℂ) (hK : IsCompact K) (hK_pos : K ⊆ {z | 0 < z.re}) :
    TendstoUniformlyOn (fun n z => Complex.GammaSeq z n) Gamma_product_limit Filter.atTop K := by
      have h_uniform : TendstoUniformlyOn (fun (n : ℕ) x => (1 / x) * Complex.exp (x * (Real.log (n : ℝ) - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + x / (k + 1 : ℂ))⁻¹ * Complex.exp (x / (k + 1 : ℂ)))) (fun z => (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant) * Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ))))) Filter.atTop K := by
        have h_uniform : TendstoUniformlyOn (fun (n : ℕ) x => (1 / x) * Complex.exp (x * (Real.log (n : ℝ) - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1)))) (fun z => (1 / z) * Complex.exp (z * -Real.eulerMascheroniConstant)) Filter.atTop K := by
          have h_uniform : TendstoUniformlyOn (fun (n : ℕ) x => Complex.exp (x * (Real.log (n : ℝ) - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1)))) (fun z => Complex.exp (z * -Real.eulerMascheroniConstant)) Filter.atTop K := by
            exact GammaSeq_exp_part_uniform_v4 K hK
          have h_cont : ContinuousOn (fun z : ℂ => 1 / z) K := by
            exact continuousOn_of_forall_continuousAt fun z hz => ContinuousAt.div continuousAt_const continuousAt_id <| ne_of_apply_ne Complex.re <| ne_of_gt <| hK_pos hz;
          apply tendstoUniformlyOn_mul_of_compact hK;
          · rw [ Metric.tendstoUniformlyOn_iff ] ; aesop;
          · convert h_uniform using 1;
          · exact h_cont;
          · exact Continuous.continuousOn ( by continuity );
        have h_uniform : TendstoUniformlyOn (fun (n : ℕ) x => ∏ k ∈ Finset.range n, ((1 + x / (k + 1 : ℂ))⁻¹ * Complex.exp (x / (k + 1 : ℂ)))) (fun z => Complex.exp (∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ))))) Filter.atTop K := by
          exact GammaSeq_product_part_tendstoUniformlyOn K hK hK_pos
        apply_rules [ tendstoUniformlyOn_mul_of_compact ];
        · exact continuousOn_of_forall_continuousAt fun x hx => ContinuousAt.mul ( continuousAt_const.div continuousAt_id <| by specialize hK_pos hx; aesop ) <| Complex.continuous_exp.continuousAt.comp <| ContinuousAt.mul continuousAt_id <| continuousAt_const;
        · refine' ContinuousOn.cexp _;
          have h_uniform : TendstoUniformlyOn (fun (n : ℕ) x => ∑ k ∈ Finset.range n, (x / (k + 1 : ℂ) - Complex.log (1 + x / (k + 1 : ℂ)))) (fun z => ∑' k : ℕ, (z / (k + 1 : ℂ) - Complex.log (1 + z / (k + 1 : ℂ)))) Filter.atTop K := by
            apply_rules [ GammaSeq_log_term_summable_uniform ];
          have h_cont : ContinuousOn (fun x => ∑' k : ℕ, (x / (k + 1 : ℂ) - Complex.log (1 + x / (k + 1 : ℂ)))) K := by
            have h_cont : ∀ n, ContinuousOn (fun x => ∑ k ∈ Finset.range n, (x / (k + 1 : ℂ) - Complex.log (1 + x / (k + 1 : ℂ)))) K := by
              intro n;
              refine' continuousOn_finset_sum _ fun i hi => ContinuousOn.sub _ _;
              · exact continuousOn_id.div_const _;
              · refine' ContinuousOn.clog _ _;
                · exact ContinuousOn.add continuousOn_const ( continuousOn_id.div_const _ );
                · intro x hx; simp_all +decide [ Complex.slitPlane, Complex.div_re, Complex.div_im ];
                  exact Or.inl ( add_pos_of_pos_of_nonneg zero_lt_one ( div_nonneg ( mul_nonneg ( le_of_lt ( hK_pos hx ) ) ( by positivity ) ) ( Complex.normSq_nonneg _ ) ) )
            exact h_uniform.continuousOn ( Filter.Frequently.of_forall h_cont );
          convert h_cont using 1;
      -- Since `GammaSeq` is equal to the product for `n ≥ 1`, we can conclude the proof.
      have h_eq : ∀ n ≥ 1, ∀ z ∈ K, Complex.GammaSeq z n = (1 / z) * Complex.exp (z * (Real.log (n : ℝ) - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ))) := by
        intros n hn z hz
        have h_eq : Complex.GammaSeq z n = (1 / z) * Complex.exp (z * (Real.log (n : ℝ) - ∑ k ∈ Finset.range n, 1 / ((k : ℝ) + 1))) * ∏ k ∈ Finset.range n, ((1 + z / (k + 1 : ℂ))⁻¹ * Complex.exp (z / (k + 1 : ℂ))) := by
          apply GammaSeq_eq_product z n hn (fun k hk => by
            exact ne_of_apply_ne Complex.re ( by norm_num; linarith [ Set.mem_setOf.mp ( hK_pos hz ) ] ))
        exact h_eq;
      exact fun ε hε => by filter_upwards [ h_uniform ε hε, Filter.eventually_ge_atTop 1 ] with n hn hn' using fun z hz => by simpa only [ h_eq n hn' z hz, Gamma_product_limit ] using hn z hz;

