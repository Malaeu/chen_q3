/-
Definitions of normSq, quadForm, rayleighQ, rankOne, and rho_one.
-/
open scoped BigOperators
open Finset Real

noncomputable def normSq {M : ℕ} (v : Fin M → ℝ) : ℝ := ∑ i, (v i) ^ 2

noncomputable def quadForm {M : ℕ} (A : Matrix (Fin M) (Fin M) ℝ) (v : Fin M → ℝ) : ℝ :=
  ∑ i, ∑ j, v i * A i j * v j

noncomputable def rayleighQ {M : ℕ} (A : Matrix (Fin M) (Fin M) ℝ) (v : Fin M → ℝ) : ℝ :=
  quadForm A v / normSq v

noncomputable def rankOne {M : ℕ} (α : ℝ) (u : Fin M → ℝ) : Matrix (Fin M) (Fin M) ℝ :=
  fun i j => α * u i * u j

noncomputable def rho_one : ℝ := 1 / 25

/-
For normalized u (||u||² = 1) and any v, the square of the inner product is bounded by the norm squared of v.
-/
lemma inner_sq_le_normSq {M : ℕ} (u v : Fin M → ℝ)
    (hu : ∑ i, (u i)^2 = 1) :
    (∑ i, u i * v i)^2 ≤ ∑ i, (v i)^2 := by
  -- By Cauchy-Schwarz inequality, we have (∑ i, u i * v i)^2 ≤ (∑ i, u i^2) * (∑ i, v i^2).
  have h_cauchy_schwarz : (∑ i, u i * v i)^2 ≤ (∑ i, u i^2) * (∑ i, v i^2) := by
    exact sum_mul_sq_le_sq_mul_sq univ u v
  aesop

/-
The quadratic form of a rank-one matrix α * |u⟩⟨u| applied to v is α * ⟨u,v⟩².
-/
lemma quadForm_rankOne {M : ℕ} (α : ℝ) (u v : Fin M → ℝ) :
    quadForm (rankOne α u) v = α * (∑ i, u i * v i)^2 := by
  simp +decide [ Finset.mul_sum _ _ _, Finset.sum_mul, sq, mul_assoc, mul_comm, mul_left_comm, rankOne, quadForm ]

/-
The quadratic form of a sum of matrices is the sum of their quadratic forms.
-/
lemma quadForm_sum {M : ℕ} {ι : Type*} [Fintype ι]
    (As : ι → Matrix (Fin M) (Fin M) ℝ) (v : Fin M → ℝ) :
    quadForm (∑ n, As n) v = ∑ n, quadForm (As n) v := by
  unfold quadForm; simp +decide only [mul_comm] ;
  simp +decide only [Matrix.sum_apply, Finset.mul_sum _ _ _];
  exact Eq.symm ( by rw [ Finset.sum_comm ] ; exact Finset.sum_congr rfl fun _ _ => Finset.sum_comm.trans ( Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring ) )

/-
The Rayleigh quotient of a sum of rank-one matrices (weighted by non-negative coefficients) is bounded by the sum of the coefficients, provided the basis vectors are normalized.
-/
lemma rayleighQ_rankone_sum_le
    {M : ℕ} [NeZero M] {NodesK : Type} [Fintype NodesK] [DecidableEq NodesK]
    (coeff : NodesK → ℝ) (basis : NodesK → Fin M → ℝ)
    (v : Fin M → ℝ)
    (h_coeff_nonneg : ∀ n, 0 ≤ coeff n)
    (h_basis_norm : ∀ n, ∑ i : Fin M, (basis n i)^2 = 1)
    (hv : v ≠ 0) :
    rayleighQ (fun i j => ∑ n : NodesK, coeff n * basis n i * basis n j) v
      ≤ ∑ n : NodesK, coeff n := by
  refine' div_le_of_le_mul₀ _ _ _;
  · exact Finset.sum_nonneg fun _ _ => sq_nonneg _;
  · exact Finset.sum_nonneg fun _ _ => h_coeff_nonneg _;
  · -- By Lemma 2, the quadratic form of a sum of matrices is the sum of their quadratic forms.
    have h_quadForm_sum : quadForm (fun i j => ∑ n, coeff n * basis n i * basis n j) v = ∑ n, coeff n * (∑ i, basis n i * v i)^2 := by
      unfold quadForm;
      simp +decide only [mul_comm, mul_left_comm, Finset.mul_sum _ _ _, pow_two];
      exact Eq.symm ( by rw [ Finset.sum_comm ] ; exact Finset.sum_congr rfl fun _ _ => Finset.sum_comm.trans ( Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring ) );
    -- By Lemma 1, the square of the inner product is bounded by the norm squared of v.
    have h_inner_sq_le_normSq : ∀ n, (∑ i, basis n i * v i)^2 ≤ normSq v := by
      intros n
      have h_inner_sq_le_normSq : (∑ i, basis n i * v i)^2 ≤ (∑ i, (basis n i)^2) * (∑ i, (v i)^2) := by
        exact sum_mul_sq_le_sq_mul_sq univ (basis n) v
      aesop;
    simpa only [ h_quadForm_sum, Finset.sum_mul _ _ _ ] using Finset.sum_le_sum fun n _ => mul_le_mul_of_nonneg_left ( h_inner_sq_le_normSq n ) ( h_coeff_nonneg n )

/-
The Rayleigh quotient of the compressed operator is bounded by rho_one (1/25).
-/
theorem rkhs_cap_rayleigh_t1
    {M : ℕ} [NeZero M] {NodesK : Type} [Fintype NodesK] [DecidableEq NodesK]
    (coeff : NodesK → ℝ) (basis : NodesK → Fin M → ℝ)
    (h_coeff_nonneg : ∀ n, 0 ≤ coeff n)
    (h_basis_norm : ∀ n, ∑ i : Fin M, (basis n i)^2 = 1)
    (h_coeff_sum : ∑ n : NodesK, coeff n ≤ rho_one)
    : ∀ v : Fin M → ℝ, v ≠ 0 →
        rayleighQ (fun i j => ∑ n : NodesK, coeff n * basis n i * basis n j) v
          ≤ rho_one := by
  intro v hv
  calc rayleighQ (fun i j => ∑ n : NodesK, coeff n * basis n i * basis n j) v
      ≤ ∑ n : NodesK, coeff n := rayleighQ_rankone_sum_le coeff basis v h_coeff_nonneg h_basis_norm hv
    _ ≤ rho_one := h_coeff_sum
