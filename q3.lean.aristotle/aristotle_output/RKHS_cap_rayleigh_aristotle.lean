lemma rayleighQ_rankOne_sum_le
    {M : ℕ} {ι : Type*} [Fintype ι]
    (α : ι → ℝ) (u : ι → Fin M → ℝ) (v : Fin M → ℝ)
    (hα : ∀ i, 0 ≤ α i)
    (hu : ∀ i, ∑ j : Fin M, (u i j)^2 = 1)
    (hv : v ≠ 0) :
    rayleighQ (fun i j => ∑ n, α n * u n i * u n j) v ≤ ∑ n, α n := by
  -- By the properties of the quadratic form, we can expand $\text{quadForm}(\sum_{n} \alpha_n u_n u_n^T, v)$ as $\sum_{n} \alpha_n (\sum_{i} u_n[i] v[i])^2$.
