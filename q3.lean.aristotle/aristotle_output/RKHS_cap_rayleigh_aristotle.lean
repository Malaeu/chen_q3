  -- By definition of quadratic form, we can expand both sides.
  have h_expand : ∑ x : Fin M × Fin M, v x.1 * (∑ i, A i x.1 x.2) * v x.2 = ∑ x : Fin M × Fin M, (∑ i, v x.1 * (A i x.1 x.2) * v x.2) := by
    simp +decide only [Finset.mul_sum _ _ _, sum_mul, mul_assoc];
