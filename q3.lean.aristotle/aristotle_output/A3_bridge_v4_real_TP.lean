          simp +decide only [T_P_matrix, Finset.sum_mul _ _ _];
          exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring;
        linarith;
      -- By the properties of the RKHS matrix, we know that $\sum_{j} |T_P_{ij}| \leq w_{\text{max}} (1 + S_{\text{off}})$.
      have h_row_sum_bound : ∀ i : Fin M, ∑ j, |T_P_matrix (T / 2) M i j| ≤ w_max * (1 + S_off (T / 2) (δ_min M)) := by
        exact fun i => T_P_row_sum_bound ( T / 2 ) ( half_pos hT_pos ) M i;
      refine' ⟨ half_pos hT_pos, fun v hv => div_le_of_le_mul₀ _ _ _ ⟩;
      · exact Finset.sum_nonneg fun _ _ => sq_nonneg _;
      · exact div_nonneg ( mul_nonneg zero_le_three ( by rw [ show c_star = 11 / 10 by rfl ] ; norm_num ) ) zero_le_four;
      · exact le_trans ( h_symm_pos_def v ) ( by rw [ Finset.mul_sum _ _ _ ] ; exact Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_right ( h_row_sum_bound i |> le_trans <| hT _ ⟨ by positivity, by linarith ⟩ ) <| sq_nonneg _ )
