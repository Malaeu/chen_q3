        have := Metric.tendsto_nhdsWithin_nhds.mp h_lim;
        obtain ⟨ δ, hδ, H ⟩ := this ( ( 3 * c_star / 4 - w_max ) / 2 ) ( by linarith [ show w_max < 3 * c_star / 4 by rw [ show c_star = 11 / 10 by rfl ] ; rw [ show w_max = 2 / Real.exp 1 by rfl ] ; rw [ div_lt_iff₀ <| by positivity ] ; have := Real.exp_one_gt_d9.le; norm_num1 at *; linarith ] ) ; exact ⟨ δ / 2, half_pos hδ, fun t ht => by linarith [ abs_lt.mp ( H ht.1 <| abs_lt.mpr ⟨ by linarith, by linarith ⟩ ) ] ⟩ ;
      -- By choosing $t$ small enough, we can bound the quadratic form.
      obtain ⟨T, hT_pos, hT⟩ := ht_exists
      use T / 2;
      -- By the properties of the RKHS matrix, we know that $T_P(t)$ is symmetric and positive semi-definite.
      have h_symm_pos_def : ∀ v : Fin M → ℝ, (∑ i, ∑ j, v i * T_P_matrix (T / 2) M i j * v j) ≤ (∑ i, (∑ j, |T_P_matrix (T / 2) M i j|) * (v i ^ 2)) := by
        intro v
        have h_symm_pos_def : ∀ i j : Fin M, v i * T_P_matrix (T / 2) M i j * v j ≤ |T_P_matrix (T / 2) M i j| * (v i ^ 2 + v j ^ 2) / 2 := by
          intro i j; cases abs_cases ( T_P_matrix ( T / 2 ) M i j ) <;> nlinarith [ sq_nonneg ( v i - v j ), sq_nonneg ( v i + v j ) ] ;
        have h_symm_pos_def : ∑ i, ∑ j, v i * T_P_matrix (T / 2) M i j * v j ≤ ∑ i, ∑ j, |T_P_matrix (T / 2) M i j| * (v i ^ 2 + v j ^ 2) / 2 := by
          exact Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => h_symm_pos_def i j;
        have h_symm_pos_def : ∑ i, ∑ j, |T_P_matrix (T / 2) M i j| * (v i ^ 2 + v j ^ 2) / 2 = (∑ i, (∑ j, |T_P_matrix (T / 2) M i j|) * v i ^ 2) / 2 + (∑ j, (∑ i, |T_P_matrix (T / 2) M i j|) * v j ^ 2) / 2 := by
          simp +decide [ Finset.sum_div _ _ _, Finset.sum_add_distrib, mul_add, add_div, Finset.mul_sum _ _ _, Finset.sum_mul ];
