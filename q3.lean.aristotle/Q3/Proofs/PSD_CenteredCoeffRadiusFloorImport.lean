    (M : Matrix CoeffIndex23 CoeffIndex23 Real)
    (Q : Matrix BoundaryIndex2 CoeffIndex23 Real)
    (hbox : Q3.Proofs.matrixEntrywiseAbsLe
      (Q3.Proofs.penaltyMatrix M Q controlK9TauR)
