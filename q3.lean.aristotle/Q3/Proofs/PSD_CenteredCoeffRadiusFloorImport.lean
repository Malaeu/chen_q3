  exact_mod_cast controlK9DIntervalFloorRat_pos

theorem controlK9DMidpointLowerBound_with_radius_floor :
    ∀ v : CoeffIndex23 -> Real,
      (controlK9DIntervalFloor + controlK9DPenaltyRadiusFloor) *
          Q3.Proofs.euclideanEnergy v <=
        Q3.Proofs.quadForm
          (Q3.Proofs.penaltyMatrix controlK9D controlK9Q controlK9TauD) v := by
  intro v
  have hfloor : controlK9DIntervalFloor + controlK9DPenaltyRadiusFloor = controlK9DFloor := by
    norm_num [controlK9DIntervalFloor, controlK9DIntervalFloorRat,
      controlK9DPenaltyRadiusFloor, controlK9DPenaltyRadiusFloorRat, controlK9DFloor, controlK9DFloorRat]
  have hbase := controlK9DLowerBound_ldl v
  rw [Q3.Proofs.penaltyForm_eq_quadForm_penaltyMatrix] at hbase
  simpa [hfloor] using hbase

