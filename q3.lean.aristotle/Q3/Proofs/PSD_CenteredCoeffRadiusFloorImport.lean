def controlK9DPenaltyRadiusFloor : Real := (controlK9DPenaltyRadiusFloorRat : Real)

def controlK9DIntervalFloorRat : Rat :=
  controlK9DFloorRat - controlK9DPenaltyRadiusFloorRat
def controlK9DIntervalFloor : Real :=
  (controlK9DIntervalFloorRat : Real)

theorem controlK9DPenaltyRadiusRat_nonneg :
    ∀ i j : CoeffIndex23, 0 <= controlK9DPenaltyRadiusRat i j := by
  native_decide

theorem controlK9DPenaltyRadius_nonneg :
    ∀ i j : CoeffIndex23, 0 <= controlK9DPenaltyRadius i j := by
  intro i j
  change 0 <= (controlK9DPenaltyRadiusRat i j : Real)
  exact_mod_cast controlK9DPenaltyRadiusRat_nonneg i j

theorem controlK9DPenaltyRadiusTotalRat_eq :
    (∑ i : CoeffIndex23, ∑ j : CoeffIndex23, controlK9DPenaltyRadiusRat i j) =
      controlK9DPenaltyRadiusFloorRat := by
  native_decide

theorem controlK9DPenaltyRadiusTotal_le :
    (∑ i : CoeffIndex23, ∑ j : CoeffIndex23, controlK9DPenaltyRadius i j) <=
      controlK9DPenaltyRadiusFloor := by
  change ((∑ i : CoeffIndex23, ∑ j : CoeffIndex23, controlK9DPenaltyRadiusRat i j) : Real) <=
      (controlK9DPenaltyRadiusFloorRat : Real)
  exact_mod_cast le_of_eq controlK9DPenaltyRadiusTotalRat_eq

theorem controlK9DPenaltyRadiusEnergy_le :
    ∀ v : CoeffIndex23 -> Real,
      Q3.Proofs.quadFormAbsRadius controlK9DPenaltyRadius v <=
        controlK9DPenaltyRadiusFloor * Q3.Proofs.euclideanEnergy v :=
  Q3.Proofs.quadFormAbsRadius_le_radiusFloor_mul_euclideanEnergy
    controlK9DPenaltyRadius controlK9DPenaltyRadiusFloor controlK9DPenaltyRadius_nonneg controlK9DPenaltyRadiusTotal_le

