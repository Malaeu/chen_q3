  change 0 < (controlK9RIntervalFloorRat : Real)
  exact_mod_cast controlK9RIntervalFloorRat_pos

theorem controlK9RMidpointLowerBound_with_radius_floor :
    ∀ v : CoeffIndex23 -> Real,
      (controlK9RIntervalFloor + controlK9RPenaltyRadiusFloor) *
          Q3.Proofs.euclideanEnergy v <=
        Q3.Proofs.quadForm
          (Q3.Proofs.penaltyMatrix controlK9R controlK9Q controlK9TauR) v := by
  intro v
  have hfloor : controlK9RIntervalFloor + controlK9RPenaltyRadiusFloor = controlK9RFloor := by
    norm_num [controlK9RIntervalFloor, controlK9RIntervalFloorRat,
      controlK9RPenaltyRadiusFloor, controlK9RPenaltyRadiusFloorRat, controlK9RFloor, controlK9RFloorRat]
  have hbase := controlK9RLowerBound_ldl v
  rw [Q3.Proofs.penaltyForm_eq_quadForm_penaltyMatrix] at hbase
  simpa [hfloor] using hbase

