      controlK9RIntervalFloor * Q3.Proofs.euclideanEnergy v <=
        Q3.Proofs.penaltyForm M Q controlK9TauR v :=
  Q3.Proofs.penaltyForm_lower_bound_of_midpoint_lower_bound_and_radius_floor
    M Q controlK9TauR controlK9RIntervalFloor controlK9RPenaltyRadiusFloor
    (Q3.Proofs.penaltyMatrix controlK9R controlK9Q controlK9TauR)
