def primaryK11RationalDeltaLiveDeclaredNonzeroSubsetLive : Prop :=
  ∀ δInt n,
    n.1 ∈ primaryK11RationalDeltaLiveDeclaredNonzeroShiftSetByDelta δInt ->
      n ∈ primaryK11LivePrimeShiftSet (((δInt : Int) : Real) / 4)

