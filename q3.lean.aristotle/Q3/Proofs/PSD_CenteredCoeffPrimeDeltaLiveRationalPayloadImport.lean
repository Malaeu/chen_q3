private theorem primaryK11_mem_live_delta_m22_shift45_of_val_eq
    (n : PrimeShiftIndexL3) (hv : n.1 = 45) :
    n ∈ primaryK11LivePrimeShiftSet (((-22 : Int) : Real) / 4) := by
  cases n with
  | mk val hval =>
    simp at hv
    subst val
    exact primaryK11_mem_live_of_plus_shift_tight_bounds (((-22 : Int) : Real) / 4)
      (Fin.mk 45 hval)
      (by
        rw [activeL3PrimeShiftLower, activeL3PrimeLogLower,
          activeL3PrimeExponent]
        change (-2 : Real) <
          (((-22 : Int) : Real) / 4 +
            ((activeL3PrimeExponentEntry 45 : Nat) : Real) *
              activeL3PrimeLogLowerEntry 45) / primaryK11Ell
        rw [show activeL3PrimeExponentEntry 45 = 1 by rfl,
          show activeL3PrimeLogLowerEntry 45 =
            _root_.Q3.Proofs.PrimeCert.l_137 by rfl]
        norm_num [primaryK11Ell, primaryK11EllRat,
          _root_.Q3.Proofs.PrimeCert.l_137])
      (by
        rw [activeL3PrimeShiftUpper, activeL3PrimeLogUpper,
          activeL3PrimeExponent]
        change (((-22 : Int) : Real) / 4 +
            ((activeL3PrimeExponentEntry 45 : Nat) : Real) *
              activeL3PrimeLogUpperEntry 45) / primaryK11Ell <
          (2 : Real)
        rw [show activeL3PrimeExponentEntry 45 = 1 by rfl,
          show activeL3PrimeLogUpperEntry 45 =
            _root_.Q3.Proofs.PrimeCert.u_137 by rfl]
        norm_num [primaryK11Ell, primaryK11EllRat,
          _root_.Q3.Proofs.PrimeCert.u_137])


