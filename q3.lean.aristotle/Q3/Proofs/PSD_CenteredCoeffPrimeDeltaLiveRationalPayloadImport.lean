      ((((δInt : Int) : Real) / 4 - primaryK11PrimeShift n) /
        primaryK11Ell) = 0 := by
  have hb := primaryK11RationalDeltaLiveRMinus_arg_bounds δInt n
  exact
    _root_.Q3.PSDpd.CenteredBSplineRBoundsImport.centeredBSplineR11_eq_zero_of_le_neg_two
      (le_trans hb.2 h)

