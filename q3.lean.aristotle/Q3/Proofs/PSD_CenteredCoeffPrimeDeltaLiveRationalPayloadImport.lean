    PsdStep33FiniteAnalyticPositivity cert ∧
      PsdStep33SingletonDirectedFamilyHandoff cert := by
  exact
    psd_step33_closed_from_rationalDeltaLiveGeneratedFactorHboxes
      primary_hA
      (primaryK11RationalPrimeWeight_hbox_of_active hweight)
