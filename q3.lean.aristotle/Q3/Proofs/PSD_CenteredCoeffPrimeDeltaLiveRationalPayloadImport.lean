theorem controlK9RationalDeltaLiveRPairHboxBridge_of_split_R_hboxes
    (minusMid minusRad plusMid plusRad :
      CoeffIndex23 -> CoeffIndex23 -> PrimeShiftIndexL3 -> Real)
