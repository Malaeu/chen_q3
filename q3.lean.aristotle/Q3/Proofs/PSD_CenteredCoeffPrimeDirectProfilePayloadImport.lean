/-- Global lower/upper interval payload certificate for the generated
primaryK11 direct-profile replay.  A correlated replay generator should prove this
single bundled contract rather than emitting unrelated scalar hboxes by hand. -/
structure PrimaryK11DirectFinitePrimeProfileIntervalPayloadCert : Prop where
  hLower :
    ∀ i j,
      primaryK11DirectFinitePrimeProfileEntryLower i j <=
        primaryK11DirectFinitePrimeProfileEntryValue i j
  hUpper :
    ∀ i j,
      primaryK11DirectFinitePrimeProfileEntryValue i j <=
        primaryK11DirectFinitePrimeProfileEntryUpper i j

/-- The global interval payload gives every scalar interval certificate. -/
theorem primaryK11DirectFinitePrimeProfileEntryIntervalCert_of_interval_payload_cert
    (cert : PrimaryK11DirectFinitePrimeProfileIntervalPayloadCert)
    (i j : CoeffIndex23) :
    PrimaryK11DirectFinitePrimeProfileEntryIntervalCert i j :=
  ⟨cert.hLower i j, cert.hUpper i j⟩

/-- A generated global interval payload gives the primaryK11 direct-profile hbox. -/
theorem primaryK11DirectFinitePrimeProfilePayloadHbox_of_interval_payload_cert
    (cert : PrimaryK11DirectFinitePrimeProfileIntervalPayloadCert) :
    primaryK11DirectFinitePrimeProfilePayloadHbox := by
  intro i j
  exact primaryK11DirectFinitePrimeProfileEntryHbox_of_interval_cert
    (primaryK11DirectFinitePrimeProfileEntryIntervalCert_of_interval_payload_cert
      cert i j)

/-- Coefficient index delta for the primaryK11 direct-profile replay. -/
def primaryK11DirectFinitePrimeProfileEntryDelta
    (i j : CoeffIndex23) : Int :=
  (j.1 : Int) - (i.1 : Int)

theorem primaryK11DirectFinitePrimeProfileEntryDelta_ge_neg22
    (i j : CoeffIndex23) :
    -22 <= primaryK11DirectFinitePrimeProfileEntryDelta i j := by
  unfold primaryK11DirectFinitePrimeProfileEntryDelta
  omega

theorem primaryK11DirectFinitePrimeProfileEntryDelta_le_22
    (i j : CoeffIndex23) :
    primaryK11DirectFinitePrimeProfileEntryDelta i j <= 22 := by
  unfold primaryK11DirectFinitePrimeProfileEntryDelta
  omega

/-- Delta-compressed primaryK11 direct finite-prime profile value. -/
def primaryK11DirectFinitePrimeProfileDeltaValue (delta : Int) : Real :=
  centeredBSplineFinitePrimeKernelProfile
    11 primaryK11Ell primaryK11PrimeWeight primaryK11PrimeShift
    ((delta : Real) / 4)

theorem primaryK11DirectFinitePrimeProfileEntryValue_eq_deltaValue
    (i j : CoeffIndex23) :
    primaryK11DirectFinitePrimeProfileEntryValue i j =
      primaryK11DirectFinitePrimeProfileDeltaValue
        (primaryK11DirectFinitePrimeProfileEntryDelta i j) := by
  unfold primaryK11DirectFinitePrimeProfileEntryValue
  unfold primaryK11DirectFinitePrimeProfileDeltaValue
  unfold primaryK11DirectFinitePrimeProfileEntryDelta
  rw [primaryK11Center_sub_eq_index_delta]
  congr 1
  norm_num

