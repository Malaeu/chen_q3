/-- Scalar direct-profile value for the controlK9 block. -/
def controlK9DirectFinitePrimeProfileEntryValue
    (i j : CoeffIndex23) : Real :=
  centeredBSplineFinitePrimeKernelProfile
    9 controlK9Ell controlK9PrimeWeight controlK9PrimeShift
    (controlK9Center j - controlK9Center i)

/-- Lower endpoint for the synchronized controlK9 direct-profile entry box. -/
def controlK9DirectFinitePrimeProfileEntryLower
    (i j : CoeffIndex23) : Real :=
  controlK9DirectFinitePrimeProfileMid i j -
    controlK9DirectFinitePrimeProfileRad i j

/-- Upper endpoint for the synchronized controlK9 direct-profile entry box. -/
def controlK9DirectFinitePrimeProfileEntryUpper
    (i j : CoeffIndex23) : Real :=
  controlK9DirectFinitePrimeProfileMid i j +
    controlK9DirectFinitePrimeProfileRad i j

/-- Scalar direct-profile payload hbox for the controlK9 block. -/
def controlK9DirectFinitePrimeProfileEntryHbox
    (i j : CoeffIndex23) : Prop :=
  |controlK9DirectFinitePrimeProfileEntryValue i j -
    controlK9DirectFinitePrimeProfileMid i j| <=
      controlK9DirectFinitePrimeProfileRad i j

/-- Lower/upper interval certificate for one controlK9 scalar entry. -/
structure ControlK9DirectFinitePrimeProfileEntryIntervalCert
    (i j : CoeffIndex23) : Prop where
  hLower :
    controlK9DirectFinitePrimeProfileEntryLower i j <=
      controlK9DirectFinitePrimeProfileEntryValue i j
  hUpper :
    controlK9DirectFinitePrimeProfileEntryValue i j <=
      controlK9DirectFinitePrimeProfileEntryUpper i j

/-- A generated lower/upper interval certificate gives the scalar hbox. -/
theorem controlK9DirectFinitePrimeProfileEntryHbox_of_interval_cert
    {i j : CoeffIndex23}
    (cert : ControlK9DirectFinitePrimeProfileEntryIntervalCert i j) :
    controlK9DirectFinitePrimeProfileEntryHbox i j := by
  unfold controlK9DirectFinitePrimeProfileEntryHbox
  exact abs_sub_le_of_lower_upper
    (x := controlK9DirectFinitePrimeProfileEntryValue i j)
    (mid := controlK9DirectFinitePrimeProfileMid i j)
    (rad := controlK9DirectFinitePrimeProfileRad i j)
    (by simpa [controlK9DirectFinitePrimeProfileEntryLower] using cert.hLower)
    (by simpa [controlK9DirectFinitePrimeProfileEntryUpper] using cert.hUpper)

/-- A scalar hbox gives the equivalent lower/upper interval certificate. -/
theorem controlK9DirectFinitePrimeProfileEntryIntervalCert_of_hbox
    {i j : CoeffIndex23}
    (h : controlK9DirectFinitePrimeProfileEntryHbox i j) :
    ControlK9DirectFinitePrimeProfileEntryIntervalCert i j := by
  unfold controlK9DirectFinitePrimeProfileEntryHbox at h
  rcases lower_upper_of_abs_sub_le
    (x := controlK9DirectFinitePrimeProfileEntryValue i j)
    (mid := controlK9DirectFinitePrimeProfileMid i j)
    (rad := controlK9DirectFinitePrimeProfileRad i j)
    h with ⟨hLower, hUpper⟩
  exact ⟨
    by simpa [controlK9DirectFinitePrimeProfileEntryLower] using hLower,
    by simpa [controlK9DirectFinitePrimeProfileEntryUpper] using hUpper
  ⟩

