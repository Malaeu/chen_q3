/-- Exact table-envelope check connecting entry boxes to the
delta-compressed controlK9 boxes.  This is separate from the analytic
direct-profile replay: it is only a rational table containment layer. -/
structure ControlK9DirectFinitePrimeProfileDeltaEnvelopeCert : Prop where
  hLower :
    forall i j,
      controlK9DirectFinitePrimeProfileEntryLower i j <=
        controlK9DirectFinitePrimeProfileDeltaLower
          (controlK9DirectFinitePrimeProfileEntryDelta i j)
  hUpper :
    forall i j,
      controlK9DirectFinitePrimeProfileDeltaUpper
          (controlK9DirectFinitePrimeProfileEntryDelta i j) <=
        controlK9DirectFinitePrimeProfileEntryUpper i j

/-- Delta-compressed analytic interval payload for the controlK9
direct-profile replay.  Proving this contract needs only the 45
index-delta profiles, not 529 unrelated entry profiles. -/
structure ControlK9DirectFinitePrimeProfileDeltaIntervalPayloadCert : Prop where
  hLower :
    forall delta : Int,
      -22 <= delta ->
      delta <= 22 ->
      controlK9DirectFinitePrimeProfileDeltaLower delta <=
        controlK9DirectFinitePrimeProfileDeltaValue delta
  hUpper :
    forall delta : Int,
      -22 <= delta ->
      delta <= 22 ->
      controlK9DirectFinitePrimeProfileDeltaValue delta <=
        controlK9DirectFinitePrimeProfileDeltaUpper delta

/-- Delta interval payload plus the exact table envelope gives the
global controlK9 direct-profile interval payload. -/
theorem controlK9DirectFinitePrimeProfileIntervalPayloadCert_of_delta_interval_payload_cert
    (envelope : ControlK9DirectFinitePrimeProfileDeltaEnvelopeCert)
    (delta_cert : ControlK9DirectFinitePrimeProfileDeltaIntervalPayloadCert) :
    ControlK9DirectFinitePrimeProfileIntervalPayloadCert := by
  constructor
  · intro i j
    have henv := envelope.hLower i j
    have hdelta := delta_cert.hLower
      (controlK9DirectFinitePrimeProfileEntryDelta i j)
      (controlK9DirectFinitePrimeProfileEntryDelta_ge_neg22 i j)
      (controlK9DirectFinitePrimeProfileEntryDelta_le_22 i j)
    rw [controlK9DirectFinitePrimeProfileEntryValue_eq_deltaValue i j]
    exact le_trans henv hdelta
  · intro i j
    have hdelta := delta_cert.hUpper
      (controlK9DirectFinitePrimeProfileEntryDelta i j)
      (controlK9DirectFinitePrimeProfileEntryDelta_ge_neg22 i j)
      (controlK9DirectFinitePrimeProfileEntryDelta_le_22 i j)
    have henv := envelope.hUpper i j
    rw [controlK9DirectFinitePrimeProfileEntryValue_eq_deltaValue i j]
    exact le_trans hdelta henv

/-- Delta interval payload plus the exact table envelope gives the
controlK9 direct-profile hbox payload. -/
theorem controlK9DirectFinitePrimeProfilePayloadHbox_of_delta_interval_payload_cert
    (envelope : ControlK9DirectFinitePrimeProfileDeltaEnvelopeCert)
    (delta_cert : ControlK9DirectFinitePrimeProfileDeltaIntervalPayloadCert) :
    controlK9DirectFinitePrimeProfilePayloadHbox := by
  exact controlK9DirectFinitePrimeProfilePayloadHbox_of_interval_payload_cert
    (controlK9DirectFinitePrimeProfileIntervalPayloadCert_of_delta_interval_payload_cert
      envelope delta_cert)

