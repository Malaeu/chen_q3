/-- Exact table-envelope check connecting entry boxes to the
delta-compressed primaryK11 boxes.  This is separate from the analytic
direct-profile replay: it is only a rational table containment layer. -/
structure PrimaryK11DirectFinitePrimeProfileDeltaEnvelopeCert : Prop where
  hLower :
    forall i j,
      primaryK11DirectFinitePrimeProfileEntryLower i j <=
        primaryK11DirectFinitePrimeProfileDeltaLower
          (primaryK11DirectFinitePrimeProfileEntryDelta i j)
  hUpper :
    forall i j,
      primaryK11DirectFinitePrimeProfileDeltaUpper
          (primaryK11DirectFinitePrimeProfileEntryDelta i j) <=
        primaryK11DirectFinitePrimeProfileEntryUpper i j

/-- Delta-compressed analytic interval payload for the primaryK11
direct-profile replay.  Proving this contract needs only the 45
index-delta profiles, not 529 unrelated entry profiles. -/
structure PrimaryK11DirectFinitePrimeProfileDeltaIntervalPayloadCert : Prop where
  hLower :
    forall delta : Int,
      -22 <= delta ->
      delta <= 22 ->
      primaryK11DirectFinitePrimeProfileDeltaLower delta <=
        primaryK11DirectFinitePrimeProfileDeltaValue delta
  hUpper :
    forall delta : Int,
      -22 <= delta ->
      delta <= 22 ->
      primaryK11DirectFinitePrimeProfileDeltaValue delta <=
        primaryK11DirectFinitePrimeProfileDeltaUpper delta

/-- Delta interval payload plus the exact table envelope gives the
global primaryK11 direct-profile interval payload. -/
theorem primaryK11DirectFinitePrimeProfileIntervalPayloadCert_of_delta_interval_payload_cert
    (envelope : PrimaryK11DirectFinitePrimeProfileDeltaEnvelopeCert)
    (delta_cert : PrimaryK11DirectFinitePrimeProfileDeltaIntervalPayloadCert) :
    PrimaryK11DirectFinitePrimeProfileIntervalPayloadCert := by
  constructor
  · intro i j
    have henv := envelope.hLower i j
    have hdelta := delta_cert.hLower
      (primaryK11DirectFinitePrimeProfileEntryDelta i j)
      (primaryK11DirectFinitePrimeProfileEntryDelta_ge_neg22 i j)
      (primaryK11DirectFinitePrimeProfileEntryDelta_le_22 i j)
    rw [primaryK11DirectFinitePrimeProfileEntryValue_eq_deltaValue i j]
    exact le_trans henv hdelta
  · intro i j
    have hdelta := delta_cert.hUpper
      (primaryK11DirectFinitePrimeProfileEntryDelta i j)
      (primaryK11DirectFinitePrimeProfileEntryDelta_ge_neg22 i j)
      (primaryK11DirectFinitePrimeProfileEntryDelta_le_22 i j)
    have henv := envelope.hUpper i j
    rw [primaryK11DirectFinitePrimeProfileEntryValue_eq_deltaValue i j]
    exact le_trans hdelta henv

/-- Delta interval payload plus the exact table envelope gives the
primaryK11 direct-profile hbox payload. -/
theorem primaryK11DirectFinitePrimeProfilePayloadHbox_of_delta_interval_payload_cert
    (envelope : PrimaryK11DirectFinitePrimeProfileDeltaEnvelopeCert)
    (delta_cert : PrimaryK11DirectFinitePrimeProfileDeltaIntervalPayloadCert) :
    primaryK11DirectFinitePrimeProfilePayloadHbox := by
  exact primaryK11DirectFinitePrimeProfilePayloadHbox_of_interval_payload_cert
    (primaryK11DirectFinitePrimeProfileIntervalPayloadCert_of_delta_interval_payload_cert
      envelope delta_cert)

