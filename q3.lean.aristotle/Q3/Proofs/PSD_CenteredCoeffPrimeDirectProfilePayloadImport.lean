/-- Global lower/upper interval payload certificate for the generated
controlK9 direct-profile replay.  A correlated replay generator should prove this
single bundled contract rather than emitting unrelated scalar hboxes by hand. -/
structure ControlK9DirectFinitePrimeProfileIntervalPayloadCert : Prop where
  hLower :
    ∀ i j,
      controlK9DirectFinitePrimeProfileEntryLower i j <=
        controlK9DirectFinitePrimeProfileEntryValue i j
  hUpper :
    ∀ i j,
      controlK9DirectFinitePrimeProfileEntryValue i j <=
        controlK9DirectFinitePrimeProfileEntryUpper i j

/-- The global interval payload gives every scalar interval certificate. -/
theorem controlK9DirectFinitePrimeProfileEntryIntervalCert_of_interval_payload_cert
    (cert : ControlK9DirectFinitePrimeProfileIntervalPayloadCert)
    (i j : CoeffIndex23) :
    ControlK9DirectFinitePrimeProfileEntryIntervalCert i j :=
  ⟨cert.hLower i j, cert.hUpper i j⟩

/-- A generated global interval payload gives the controlK9 direct-profile hbox. -/
theorem controlK9DirectFinitePrimeProfilePayloadHbox_of_interval_payload_cert
    (cert : ControlK9DirectFinitePrimeProfileIntervalPayloadCert) :
    controlK9DirectFinitePrimeProfilePayloadHbox := by
  intro i j
  exact controlK9DirectFinitePrimeProfileEntryHbox_of_interval_cert
    (controlK9DirectFinitePrimeProfileEntryIntervalCert_of_interval_payload_cert
      cert i j)

/-- Coefficient index delta for the controlK9 direct-profile replay. -/
def controlK9DirectFinitePrimeProfileEntryDelta
    (i j : CoeffIndex23) : Int :=
  (j.1 : Int) - (i.1 : Int)

theorem controlK9DirectFinitePrimeProfileEntryDelta_ge_neg22
    (i j : CoeffIndex23) :
    -22 <= controlK9DirectFinitePrimeProfileEntryDelta i j := by
  unfold controlK9DirectFinitePrimeProfileEntryDelta
  omega

theorem controlK9DirectFinitePrimeProfileEntryDelta_le_22
    (i j : CoeffIndex23) :
    controlK9DirectFinitePrimeProfileEntryDelta i j <= 22 := by
  unfold controlK9DirectFinitePrimeProfileEntryDelta
  omega

/-- Delta-compressed controlK9 direct finite-prime profile value. -/
def controlK9DirectFinitePrimeProfileDeltaValue (delta : Int) : Real :=
  centeredBSplineFinitePrimeKernelProfile
    9 controlK9Ell controlK9PrimeWeight controlK9PrimeShift
    ((delta : Real) / 4)

theorem controlK9DirectFinitePrimeProfileEntryValue_eq_deltaValue
    (i j : CoeffIndex23) :
    controlK9DirectFinitePrimeProfileEntryValue i j =
      controlK9DirectFinitePrimeProfileDeltaValue
        (controlK9DirectFinitePrimeProfileEntryDelta i j) := by
  unfold controlK9DirectFinitePrimeProfileEntryValue
  unfold controlK9DirectFinitePrimeProfileDeltaValue
  unfold controlK9DirectFinitePrimeProfileEntryDelta
  rw [controlK9Center_sub_eq_index_delta]
  congr 1
  norm_num

