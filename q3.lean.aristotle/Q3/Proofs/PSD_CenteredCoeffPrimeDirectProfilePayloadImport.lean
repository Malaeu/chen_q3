private theorem abs_sub_le_of_lower_upper
    (x mid rad : Real)
    (hLower : mid - rad <= x)
    (hUpper : x <= mid + rad) :
    |x - mid| <= rad := by
  rw [abs_sub_le_iff]
  constructor <;> linarith

private theorem lower_upper_of_abs_sub_le
    (x mid rad : Real)
    (h : |x - mid| <= rad) :
    mid - rad <= x ∧ x <= mid + rad := by
  rw [abs_sub_le_iff] at h
  constructor <;> linarith


/-- Scalar direct-profile value for the primaryK11 block. -/
def primaryK11DirectFinitePrimeProfileEntryValue
    (i j : CoeffIndex23) : Real :=
  centeredBSplineFinitePrimeKernelProfile
    11 primaryK11Ell primaryK11PrimeWeight primaryK11PrimeShift
    (primaryK11Center j - primaryK11Center i)

/-- Lower endpoint for the synchronized primaryK11 direct-profile entry box. -/
def primaryK11DirectFinitePrimeProfileEntryLower
    (i j : CoeffIndex23) : Real :=
  primaryK11DirectFinitePrimeProfileMid i j -
    primaryK11DirectFinitePrimeProfileRad i j

/-- Upper endpoint for the synchronized primaryK11 direct-profile entry box. -/
def primaryK11DirectFinitePrimeProfileEntryUpper
    (i j : CoeffIndex23) : Real :=
  primaryK11DirectFinitePrimeProfileMid i j +
    primaryK11DirectFinitePrimeProfileRad i j

/-- Scalar direct-profile payload hbox for the primaryK11 block. -/
def primaryK11DirectFinitePrimeProfileEntryHbox
    (i j : CoeffIndex23) : Prop :=
  |primaryK11DirectFinitePrimeProfileEntryValue i j -
    primaryK11DirectFinitePrimeProfileMid i j| <=
      primaryK11DirectFinitePrimeProfileRad i j

/-- Lower/upper interval certificate for one primaryK11 scalar entry. -/
structure PrimaryK11DirectFinitePrimeProfileEntryIntervalCert
    (i j : CoeffIndex23) : Prop where
  hLower :
    primaryK11DirectFinitePrimeProfileEntryLower i j <=
      primaryK11DirectFinitePrimeProfileEntryValue i j
  hUpper :
    primaryK11DirectFinitePrimeProfileEntryValue i j <=
      primaryK11DirectFinitePrimeProfileEntryUpper i j

/-- A generated lower/upper interval certificate gives the scalar hbox. -/
theorem primaryK11DirectFinitePrimeProfileEntryHbox_of_interval_cert
    {i j : CoeffIndex23}
    (cert : PrimaryK11DirectFinitePrimeProfileEntryIntervalCert i j) :
    primaryK11DirectFinitePrimeProfileEntryHbox i j := by
  unfold primaryK11DirectFinitePrimeProfileEntryHbox
  exact abs_sub_le_of_lower_upper
    (x := primaryK11DirectFinitePrimeProfileEntryValue i j)
    (mid := primaryK11DirectFinitePrimeProfileMid i j)
    (rad := primaryK11DirectFinitePrimeProfileRad i j)
    (by simpa [primaryK11DirectFinitePrimeProfileEntryLower] using cert.hLower)
    (by simpa [primaryK11DirectFinitePrimeProfileEntryUpper] using cert.hUpper)

/-- A scalar hbox gives the equivalent lower/upper interval certificate. -/
theorem primaryK11DirectFinitePrimeProfileEntryIntervalCert_of_hbox
    {i j : CoeffIndex23}
    (h : primaryK11DirectFinitePrimeProfileEntryHbox i j) :
    PrimaryK11DirectFinitePrimeProfileEntryIntervalCert i j := by
  unfold primaryK11DirectFinitePrimeProfileEntryHbox at h
  rcases lower_upper_of_abs_sub_le
    (x := primaryK11DirectFinitePrimeProfileEntryValue i j)
    (mid := primaryK11DirectFinitePrimeProfileMid i j)
    (rad := primaryK11DirectFinitePrimeProfileRad i j)
    h with ⟨hLower, hUpper⟩
  exact ⟨
    by simpa [primaryK11DirectFinitePrimeProfileEntryLower] using hLower,
    by simpa [primaryK11DirectFinitePrimeProfileEntryUpper] using hUpper
  ⟩

