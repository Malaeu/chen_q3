/-- Mercator series with explicit remainder at `x = 1/k`. -/
lemma ccm_log_series_bound (k : ℕ) (hk : 2 ≤ k) (n : ℕ) :
    |(∑ i ∈ Finset.range n, ((1:ℝ)/(k:ℝ))^(i+1)/((i : ℝ)+1)) + Real.log (1 - 1/(k:ℝ))|
      ≤ ((1:ℝ)/(k:ℝ))^(n+1)/(1 - 1/(k:ℝ)) := by
  have hk1 : (1:ℝ) ≤ (k:ℝ) := by exact_mod_cast Nat.one_le_of_lt hk
  have hx : |(1:ℝ)/(k:ℝ)| < 1 := by
    rw [abs_of_nonneg (by positivity), div_lt_one (by linarith)]
    exact_mod_cast lt_of_lt_of_le one_lt_two (by exact_mod_cast hk)
  have := Real.abs_log_sub_add_sum_range_le hx n
  rwa [abs_of_nonneg (by positivity : (0:ℝ) ≤ 1/(k:ℝ))] at this

