Heat kernel is nonnegative.
-/
theorem HeatKernel_nonneg (t : ℝ) (ht : t > 0) (x : ℝ) : HeatKernel t x ≥ 0 := by
  exact mul_nonneg ( by positivity ) ( Real.exp_nonneg _ )

/-
Fejér kernel bounds: 0 <= FejerKernel B x <= 1.
-/
theorem FejerKernel_bounds (B : ℝ) (hB : B > 0) (x : ℝ) :
  0 ≤ FejerKernel B x ∧ FejerKernel B x ≤ 1 := by
    refine' ⟨ _, _ ⟩;
    · exact le_max_right _ _;
    · exact max_le_iff.mpr ⟨ sub_le_self _ ( by positivity ), by norm_num ⟩

/-
Corrected Fejér kernel approximation: For B > K, 1 - K/B <= FejerKernel B x <= 1 on [-K, K].
-/
