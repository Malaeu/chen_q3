/-
Definitions of Fejér kernel and Heat kernel.
-/
noncomputable def FejerKernel (B : ℝ) (x : ℝ) : ℝ := max (1 - |x| / B) 0

noncomputable def HeatKernel (t : ℝ) (x : ℝ) : ℝ :=
  (1 / Real.sqrt (4 * Real.pi * t)) * Real.exp (-x^2 / (4 * t))

/-
Definition of Fejér-heat atoms as symmetrized products.
-/
noncomputable def FejerHeatAtom (B t tau xi : ℝ) : ℝ :=
  FejerKernel B (xi - tau) * HeatKernel t (xi - tau) +
  FejerKernel B (xi + tau) * HeatKernel t (xi + tau)

/-
Definition of the space W_K of test functions.
-/
def W_K (K : ℝ) : Set (ℝ → ℝ) :=
  { Φ | Continuous Φ ∧
        Function.support Φ ⊆ Set.Ioo (-K) K ∧
        (∀ x, Φ (-x) = Φ x) ∧
        (∀ x, Φ x ≥ 0) }

/-
