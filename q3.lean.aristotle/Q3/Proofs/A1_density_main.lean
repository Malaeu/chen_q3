/-
If g approximates an even function f on [-K, K], then the symmetrization of g also approximates f on [-K, K].
-/
def Symmetrize (g : ℝ → ℝ) : ℝ → ℝ := fun x => (g x + g (-x)) / 2

theorem symmetrize_approx_even (K : ℝ) (f g : ℝ → ℝ) (hf_even : ∀ x, f (-x) = f x) (ε : ℝ)
  (h_approx : ∀ x ∈ Set.Icc (-K) K, |f x - g x| < ε) :
  ∀ x ∈ Set.Icc (-K) K, |f x - Symmetrize g x| < ε := by
    -- By definition of Symmetrize, we have Symmetrize g x = (g x + g (-x)) / 2.
    have h_symm : ∀ x, Symmetrize g x = (g x + g (-x)) / 2 := by
      intro x
      rfl
    aesop;
    exact abs_lt.mpr ⟨ by linarith [ abs_lt.mp ( h_approx x left right ), abs_lt.mp ( h_approx ( -x ) ( by linarith ) ( by linarith ) ), hf_even x ], by linarith [ abs_lt.mp ( h_approx x left right ), abs_lt.mp ( h_approx ( -x ) ( by linarith ) ( by linarith ) ), hf_even x ] ⟩

/-
Definition of the map from [-K, K] to C([-K, K]).
-/
noncomputable def MapToContinuous (K t : ℝ) (ht : t > 0) (Φ : ℝ → ℝ) : ℝ → C(Set.Icc (-K) K, ℝ) :=
  fun y => ⟨fun x => Φ y * ModifiedKernel K t (x - y), by
    have h_cont := ModifiedKernel_continuous K t ht
    fun_prop⟩

/-
The map y -> Phi(y) * ModifiedKernel(.-y) is continuous from [-K, K] to C([-K, K]).
-/
theorem MapToContinuous_continuous (K t : ℝ) (ht : t > 0) (Φ : ℝ → ℝ) (hΦ : ContinuousOn Φ (Set.Icc (-K) K)) :
  ContinuousOn (MapToContinuous K t ht Φ) (Set.Icc (-K) K) := by
    intro y hy
    apply ContinuousOn.smul hΦ (ModifiedKernel_uniform_continuity K t ht);
    exact hy

