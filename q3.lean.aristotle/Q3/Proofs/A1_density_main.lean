  ∀ x ∈ Set.Icc (-K) K, 1 - K / B ≤ FejerKernel B x ∧ FejerKernel B x ≤ 1 := by
    intros x _hx_range; (unfold FejerKernel; aesop);
    · exact Or.inl ( by cases abs_cases x <;> ring_nf <;> nlinarith [ inv_mul_cancel₀ ( by linarith : B ≠ 0 ) ] );
    · exact div_nonneg ( abs_nonneg x ) ( by linarith )

