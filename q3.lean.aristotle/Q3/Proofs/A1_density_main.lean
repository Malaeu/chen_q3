      · filter_upwards [ MeasureTheory.ae_restrict_mem <| measurableSet_lt ( measurable_norm ) measurable_const ] with y hy using mul_le_mul_of_nonneg_right ( le_of_lt <| hδ _ _ <| by simpa using hy ) <| by exact ( show 0 ≤ HeatKernel t y from by exact mul_nonneg ( by positivity ) <| Real.exp_nonneg _ ) ;
    -- Using the bounds on the heat kernel and the uniform continuity of f, we can bound the second integral.
    have h_second_integral_bound : ∫ y in {y | abs y ≥ δ}, (2 * sSup (abs '' Set.range f)) * HeatKernel t y ≤ (2 * sSup (abs '' Set.range f)) * (ε / (4 * (sSup (abs '' Set.range f)) + 1)) := by
      rw [ MeasureTheory.integral_const_mul ] ; exact mul_le_mul_of_nonneg_left ht.le <| mul_nonneg zero_le_two <| by apply_rules [ Real.sSup_nonneg ] ; rintro x ⟨ y, hy, rfl ⟩ ; exact abs_nonneg _;
    -- Using the bounds on the heat kernel and the uniform continuity of f, we can bound the first integral further.
    have h_first_integral_bound_further : ∀ x, ∫ y in {y | abs y < δ}, abs (f (x - y) - f x) * HeatKernel t y ≤ (ε / 2) * 1 := by
      intro x; refine le_trans ( h_first_integral_bound x ) ?_; gcongr;
      refine' le_trans ( MeasureTheory.setIntegral_le_integral _ _ ) _;
      · exact MeasureTheory.integrable_of_integral_eq_one ( HeatKernel_integral t ht_pos );
      · exact Filter.Eventually.of_forall fun x => by unfold HeatKernel; positivity;
      · rw [ HeatKernel_integral t ht_pos ];
    exact ⟨ t, ht_pos, fun x => lt_of_le_of_lt ( h_conv_bound x ) ( by nlinarith [ h_first_integral_bound_further x, h_second_integral_bound, show 0 ≤ SupSet.sSup ( abs '' Set.range f ) from by apply_rules [ Real.sSup_nonneg ] ; rintro x ⟨ y, hy, rfl ⟩ ; exact abs_nonneg _, mul_div_cancel₀ ε ( show ( 4 * SupSet.sSup ( abs '' Set.range f ) + 1 ) ≠ 0 from by linarith [ show 0 ≤ SupSet.sSup ( abs '' Set.range f ) from by apply_rules [ Real.sSup_nonneg ] ; rintro x ⟨ y, hy, rfl ⟩ ; exact abs_nonneg _ ] ) ] ) ⟩

/-
The first moment of the heat kernel tends to 0 as t -> 0.
-/
theorem heat_kernel_moment_tendsto :
  Tendsto (fun t => ∫ y, |y| * HeatKernel t y) (nhdsWithin 0 (Ioi 0)) (nhds 0) := by
    -- The integral of $|y|$ times the Gaussian is $\sqrt{4\pi t}$, which tends to $0$ as $t$ approaches $0$.
    have h_gauss_abs_y : ∀ t > 0, ∫ y, |y| * (Real.exp (-y^2 / (4 * t)) / Real.sqrt (4 * Real.pi * t)) = Real.sqrt (4 * t / Real.pi) := by
      -- Let's simplify the integral.
      have h_simp : ∀ t > 0, ∫ y, |y| * (Real.exp (-y^2 / (4 * t))) = 4 * t := by
        intro t ht
        have h_gauss_abs_y : ∫ y, |y| * (Real.exp (-y^2 / (4 * t))) = 2 * ∫ y in Set.Ici 0, y * (Real.exp (-y^2 / (4 * t))) := by
          -- We can split the integral into two parts: one over $(-\infty, 0)$ and one over $(0, \infty)$.
          have h_split : ∫ y : ℝ, abs y * Real.exp (-y^2 / (4 * t)) = (∫ y in Set.Iic 0, abs y * Real.exp (-y^2 / (4 * t))) + (∫ y in Set.Ioi 0, abs y * Real.exp (-y^2 / (4 * t))) := by
            rw [ ← MeasureTheory.setIntegral_union ] <;> norm_num;
            · have := @integrable_rpow_mul_exp_neg_mul_sq;
              specialize @this ( 1 / ( 4 * t ) ) ( by positivity ) 1 ; norm_num at this;
              simpa [ div_eq_inv_mul, mul_assoc, mul_comm, mul_left_comm ] using this.norm.integrableOn;
            · have h_integrable : MeasureTheory.IntegrableOn (fun y => y * Real.exp (-y^2 / (4 * t))) (Set.Ioi 0) := by
                have := @integral_rpow_mul_exp_neg_mul_rpow;
                specialize @this 2 1 ( 1 / ( 4 * t ) ) ; norm_num at this;
                contrapose! this;
                exact ⟨ ht, by rw [ MeasureTheory.integral_undef ( by simpa [ div_eq_inv_mul ] using this ) ] ; positivity ⟩;
              exact h_integrable.congr_fun ( fun x hx => by rw [ abs_of_pos hx.out ] ) measurableSet_Ioi;
          -- Since $|y|$ is symmetric around $0$, we can replace $|y|$ with $y$ in the integral over $(-\infty, 0)$.
          have h_symm : ∫ y in Set.Iic 0, abs y * Real.exp (-y^2 / (4 * t)) = ∫ y in Set.Ioi 0, abs y * Real.exp (-y^2 / (4 * t)) := by
            rw [ ← neg_zero, ← integral_comp_neg_Iic ] ; norm_num;
          simp_all +decide [ MeasureTheory.integral_Ici_eq_integral_Ioi, two_mul ];
          exact congrArg₂ ( · + · ) ( MeasureTheory.setIntegral_congr_fun measurableSet_Ioi fun x hx => by rw [ abs_of_pos hx.out ] ) ( MeasureTheory.setIntegral_congr_fun measurableSet_Ioi fun x hx => by rw [ abs_of_pos hx.out ] );
        have := @integral_rpow_mul_exp_neg_mul_rpow 2 ; norm_num at * ; aesop;
        rw [ MeasureTheory.integral_Ici_eq_integral_Ioi ] ; convert congr_arg ( fun x : ℝ => 2 * x ) ( @this 1 ( 1 / ( 4 * t ) ) ( by norm_num ) ( by positivity ) ) using 1 <;> norm_num [ div_eq_inv_mul ] ; ring;
        norm_cast ; norm_num ; ring;
      intro t ht; simp +decide only [mul_div];
      rw [ MeasureTheory.integral_div, h_simp t ht, div_eq_iff ] <;> ring <;> first | positivity | norm_num [ ht.le, Real.pi_pos.le ] ;
      ring ; norm_num [ ht.le, Real.pi_pos.le, ne_of_gt ht, ne_of_gt Real.pi_pos ];
    simp_all +decide [ HeatKernel ];
    exact Filter.Tendsto.congr' ( Filter.eventuallyEq_of_mem self_mem_nhdsWithin fun t ht => by simpa [ div_eq_inv_mul, mul_assoc, mul_comm, mul_left_comm ] using Eq.symm ( h_gauss_abs_y t ht ) ) ( tendsto_nhdsWithin_of_tendsto_nhds <| Continuous.tendsto' ( by continuity ) _ _ <| by norm_num )

/-
Convolution of continuous Phi with HeatKernel converges uniformly to Phi on [-K, K].
-/
theorem convolution_approx_Phi_of_continuous (K : ℝ) (hK : K > 0) (Φ : ℝ → ℝ) (hΦ : Φ ∈ W_K K) (hΦ_cont : Continuous Φ) (ε : ℝ) (hε : ε > 0) :
  ∃ t > 0, ∀ x ∈ Set.Icc (-K) K, |simple_convolution Φ (HeatKernel t) x - Φ x| < ε := by
    -- Φ is continuous and has compact support (since support is in [-K, K]).
    have h_compact_support : HasCompactSupport Φ := by
      cases hΦ ; aesop;
      rw [ hasCompactSupport_iff_eventuallyEq ];
      simp_all +decide [ Filter.EventuallyEq ];
      exact ⟨ ⟨ -K - 1, fun x hx => Classical.not_not.1 fun hx' => by linarith [ left_1 x hx' ] ⟩, ⟨ K + 1, fun x hx => Classical.not_not.1 fun hx' => by linarith [ left_1 x hx' ] ⟩ ⟩;
    exact Exists.elim ( continuous_convolution_approx Φ hΦ_cont h_compact_support ε hε ) fun t ht => ⟨ t, ht.1, fun x hx => ht.2 x ⟩

/-
The convolution with the Fejer-modified heat kernel approximates the convolution with the heat kernel.
-/
theorem modified_convolution_approx (K : ℝ) (hK : K > 0) (Φ : ℝ → ℝ) (hΦ : Φ ∈ W_K K) (hΦ_cont : Continuous Φ) (ε : ℝ) (hε : ε > 0) :
  ∃ t > 0, ∀ x ∈ Set.Icc (-K) K, |simple_convolution Φ (fun z => FejerKernel K z * HeatKernel t z) x - simple_convolution Φ (HeatKernel t) x| < ε := by
    -- The difference between the two convolutions can be bounded by $\frac{\sup |\Phi|}{K} \int |z| \theta_t(z) \, dz$.
    have h_diff_bound : ∀ t > 0, ∀ x ∈ Set.Icc (-K) K, |simple_convolution Φ (fun z => FejerKernel K z * HeatKernel t z) x - simple_convolution Φ (HeatKernel t) x| ≤ (sSup (Set.image (abs ∘ Φ) (Set.Icc (-K) K))) / K * (∫ y, |y| * HeatKernel t y) := by
      intros t ht x hx
      have h_diff_bound : |∫ y, Φ y * (FejerKernel K (x - y) - 1) * HeatKernel t (x - y)| ≤ (sSup (Set.image (abs ∘ Φ) (Set.Icc (-K) K))) / K * (∫ y, |y| * HeatKernel t y) := by
        have h_diff_bound : ∀ y, |Φ y * (FejerKernel K (x - y) - 1) * HeatKernel t (x - y)| ≤ (sSup (Set.image (abs ∘ Φ) (Set.Icc (-K) K))) / K * |x - y| * HeatKernel t (x - y) := by
          intro y
          have h_diff_bound : |FejerKernel K (x - y) - 1| ≤ |x - y| / K := by
            unfold FejerKernel;
            cases max_cases ( 1 - |x - y| / K ) 0 <;> cases abs_cases ( Max.max ( 1 - |x - y| / K ) 0 - 1 ) <;> cases abs_cases ( x - y ) <;> nlinarith [ div_mul_cancel₀ ( |x - y| ) hK.ne' ];
          by_cases hy : y ∈ Set.Icc ( -K ) K <;> simp_all +decide [ abs_mul, mul_assoc ];
          · refine' le_trans ( mul_le_mul_of_nonneg_left ( mul_le_mul_of_nonneg_right h_diff_bound ( abs_nonneg _ ) ) ( abs_nonneg _ ) ) _;
            rw [ abs_of_nonneg ( show 0 ≤ HeatKernel t ( x - y ) by exact mul_nonneg ( by positivity ) ( Real.exp_nonneg _ ) ) ] ; ring_nf;
            nlinarith [ show 0 ≤ |x - y| * K⁻¹ * HeatKernel t ( x - y ) by exact mul_nonneg ( mul_nonneg ( abs_nonneg _ ) ( inv_nonneg.2 hK.le ) ) ( mul_nonneg ( by positivity ) ( Real.exp_nonneg _ ) ), show |Φ y| ≤ SupSet.sSup ( ( fun a => |Φ a| ) '' Set.Icc ( -K ) K ) by exact le_csSup ( by exact ( IsCompact.bddAbove ( isCompact_Icc.image ( continuous_abs.comp hΦ_cont ) ) ) ) ( Set.mem_image_of_mem _ ⟨ hy.1, hy.2 ⟩ ) ];
          · rw [ show Φ y = 0 from _ ] ; aesop;
            · exact mul_nonneg ( div_nonneg ( by apply_rules [ Real.sSup_nonneg ] ; aesop ) hK.le ) ( mul_nonneg ( abs_nonneg _ ) ( by unfold HeatKernel; positivity ) );
            · exact Classical.not_not.1 fun h => by have := hΦ.2.1 h; contrapose! hy; aesop;
        -- Apply the bound to each term in the integral.
        have h_integral_bound : ∫ y, |Φ y * (FejerKernel K (x - y) - 1) * HeatKernel t (x - y)| ≤ (sSup (Set.image (abs ∘ Φ) (Set.Icc (-K) K))) / K * ∫ y, |x - y| * HeatKernel t (x - y) := by
          rw [ ← MeasureTheory.integral_const_mul ];
          refine' MeasureTheory.integral_mono_of_nonneg _ _ _;
          · exact Filter.Eventually.of_forall fun y => abs_nonneg _;
          · -- The integral of $|x - y| \theta_t(x - y)$ is finite since $\theta_t$ is a probability density function.
            have h_integrable : MeasureTheory.Integrable (fun y => |y| * HeatKernel t y) MeasureTheory.MeasureSpace.volume := by
              have h_gauss_integrable : MeasureTheory.Integrable (fun y => |y| * Real.exp (-y^2 / (4 * t))) MeasureTheory.MeasureSpace.volume := by
                have := @integrable_rpow_mul_exp_neg_mul_sq;
                specialize @this ( 1 / ( 4 * t ) ) ( by positivity ) 1 ; aesop;
                convert this.norm using 2 ; norm_num ; ring;
                norm_num;
              convert h_gauss_integrable.const_mul ( 1 / Real.sqrt ( 4 * Real.pi * t ) ) using 2 ; unfold HeatKernel ; ring;
            exact MeasureTheory.Integrable.const_mul ( by simpa using h_integrable.comp_sub_left x ) _;
          · filter_upwards [ ] using fun y => by simpa only [ mul_assoc ] using h_diff_bound y;
        refine' le_trans ( MeasureTheory.norm_integral_le_integral_norm ( _ : ℝ → ℝ ) ) ( le_trans h_integral_bound _ );
        rw [ ← MeasureTheory.integral_sub_left_eq_self ( fun y => |y| * HeatKernel t y ) ];
      convert h_diff_bound using 1;
      unfold simple_convolution;
      rw [ ← MeasureTheory.integral_sub ] ; congr ; ext y ; ring;
      · -- Since $\Phi$ is continuous and compactly supported, it is bounded. Also, the product of continuous functions is continuous, and the product of a bounded function and a continuous function is integrable.
        have h_integrable : MeasureTheory.IntegrableOn (fun y => Φ y * FejerKernel K (x - y) * HeatKernel t (x - y)) (Set.Icc (-K) K) := by
          refine' ContinuousOn.integrableOn_Icc _;
          refine' ContinuousOn.mul ( ContinuousOn.mul ( hΦ_cont.continuousOn ) _ ) _;
          · exact ContinuousOn.congr ( show ContinuousOn ( fun y => Max.max ( 1 - |x - y| / K ) 0 ) ( Set.Icc ( -K ) K ) from ContinuousOn.sup ( continuousOn_const.sub ( ContinuousOn.div_const ( continuousOn_const.sub continuousOn_id |> ContinuousOn.abs ) _ ) ) continuousOn_const ) fun y hy => rfl;
          · exact Continuous.continuousOn ( by exact Continuous.mul ( continuous_const ) ( Real.continuous_exp.comp ( by continuity ) ) );
        rw [ MeasureTheory.integrableOn_iff_integrable_of_support_subset ] at h_integrable;
        · simpa only [ mul_assoc ] using h_integrable;
        · intro y hy; have := hΦ.2.1; aesop;
      · -- Since $\Phi$ is continuous and compactly supported, it is integrable.
        have h_integrable_Phi : MeasureTheory.IntegrableOn Φ (Set.Icc (-K) K) := by
          exact hΦ_cont.integrableOn_Icc;
        rw [ MeasureTheory.integrableOn_iff_integrable_of_support_subset ] at h_integrable_Phi;
        · refine' h_integrable_Phi.norm.mul_const _ |> fun h => h.mono' _ _;
          exact ( 1 / Real.sqrt ( 4 * Real.pi * t ) );
          · exact MeasureTheory.AEStronglyMeasurable.mul ( h_integrable_Phi.aestronglyMeasurable ) ( Continuous.aestronglyMeasurable ( by exact Continuous.mul ( continuous_const ) ( Real.continuous_exp.comp <| by continuity ) ) );
          · filter_upwards [ ] with y using by rw [ Real.norm_eq_abs, abs_mul, abs_of_nonneg ( show 0 ≤ HeatKernel t ( x - y ) from mul_nonneg ( one_div_nonneg.mpr ( Real.sqrt_nonneg _ ) ) ( Real.exp_nonneg _ ) ) ] ; exact mul_le_mul_of_nonneg_left ( mul_le_of_le_one_right ( by positivity ) ( Real.exp_le_one_iff.mpr ( by rw [ div_le_iff₀ ( by positivity ) ] ; nlinarith [ sq_nonneg ( x - y ) ] ) ) ) ( by positivity ) ;
        · exact hΦ.2.1;
    -- Since $\int |z| \theta_t(z) \, dz \to 0$ as $t \to 0$, we can choose $t$ small enough so that $\frac{\sup |\Phi|}{K} \int |z| \theta_t(z) \, dz < \epsilon$.
    have h_integral_zero : Filter.Tendsto (fun t => (sSup (Set.image (abs ∘ Φ) (Set.Icc (-K) K))) / K * (∫ y, |y| * HeatKernel t y)) (nhdsWithin 0 (Ioi 0)) (nhds 0) := by
      simpa using tendsto_const_nhds.mul ( heat_kernel_moment_tendsto );
    have := h_integral_zero.eventually ( gt_mem_nhds hε ) ; have := this.and self_mem_nhdsWithin; obtain ⟨ t, ht₁, ht₂ ⟩ := this.exists; exact ⟨ t, ht₂, fun x hx => lt_of_le_of_lt ( h_diff_bound t ht₂ x hx ) ht₁ ⟩ ;

/-
Definition of ModifiedKernel and its continuity.
-/
noncomputable def ModifiedKernel (K t z : ℝ) : ℝ := FejerKernel K z * HeatKernel t z

theorem ModifiedKernel_continuous (K t : ℝ) (ht : t > 0) : Continuous (ModifiedKernel K t) := by
  apply_rules [ Continuous.mul, Continuous.max, continuous_const, continuous_id, continuous_fst, continuous_snd ];
  · continuity;
  · continuity

/-
Simple convolution equals integral over [-K, K] if Phi is supported in [-K, K].
-/
theorem simple_convolution_eq_integral_Icc (K : ℝ) (hK : K > 0) (Φ : ℝ → ℝ) (hΦ : Φ ∈ W_K K) (g : ℝ → ℝ) (x : ℝ) :
  simple_convolution Φ g x = ∫ y in Set.Icc (-K) K, Φ y * g (x - y) := by
    unfold simple_convolution;
    rw [ MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero ] ; aesop;
    contrapose! a;
    exact hΦ.2.1 ( show Φ x_1 ≠ 0 from a.1 ) |> fun h => ⟨ by linarith [ Set.mem_Icc.mp h ], by linarith [ Set.mem_Icc.mp h ] ⟩

/-
The integral of Phi * ModifiedKernel over [-K, K] equals the integral of Phi * FejerHeatAtom over [0, K].
-/
theorem integral_ModifiedKernel_eq_integral_FejerHeatAtom (K : ℝ) (hK : K > 0) (Φ : ℝ → ℝ) (hΦ : Φ ∈ W_K K) (t : ℝ) (x : ℝ) :
  ∫ y in Set.Icc (-K) K, Φ y * ModifiedKernel K t (x - y) = ∫ y in Set.Icc 0 K, Φ y * FejerHeatAtom K t y x := by
    norm_num [ MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le, hK.le ];
    unfold FejerHeatAtom ModifiedKernel; ring_nf;
    rw [ intervalIntegral.integral_add ];
    · rw [ ← intervalIntegral.integral_add_adjacent_intervals ];
      rw [ ← intervalIntegral.integral_comp_neg, neg_zero ];
      · rw [ add_comm ] ; congr ; ext ; ring;
        rw [ hΦ.2.2.1 ] ; ring;
      · apply_rules [ ContinuousOn.intervalIntegrable ];
        refine' ContinuousOn.mul ( ContinuousOn.mul _ _ ) _;
        · exact hΦ.1.mono ( by rw [ Set.uIcc_of_le ( by linarith ) ] ; exact Set.Icc_subset_Icc ( by linarith ) ( by linarith ) );
        · exact Continuous.continuousOn ( by exact Continuous.max ( continuous_const.sub ( continuous_abs.comp ( continuous_const.sub continuous_id' ) |> Continuous.div_const <| K ) ) continuous_const );
        · refine' ContinuousOn.mul _ _;
          · exact continuousOn_const;
          · fun_prop;
      · apply_rules [ ContinuousOn.intervalIntegrable ];
        refine' ContinuousOn.mul ( ContinuousOn.mul _ _ ) _;
        · simpa [ hK.le ] using hΦ.1.mono ( Set.Icc_subset_Icc ( by linarith ) ( by linarith ) );
        · exact Continuous.continuousOn ( by unfold FejerKernel; continuity );
        · refine' ContinuousOn.mul _ _;
          · exact continuousOn_const;
          · fun_prop;
    · apply_rules [ ContinuousOn.intervalIntegrable ];
      refine' ContinuousOn.mul ( ContinuousOn.mul _ _ ) _;
      · exact hΦ.1.mono ( by rw [ Set.uIcc_of_le hK.le ] ; exact Set.Icc_subset_Icc ( by linarith ) le_rfl );
      · exact Continuous.continuousOn ( by unfold FejerKernel; continuity );
      · unfold HeatKernel;
        fun_prop;
    · apply_rules [ ContinuousOn.intervalIntegrable ];
      apply_rules [ ContinuousOn.mul, continuousOn_const ];
      · exact hΦ.1.mono ( by rw [ Set.uIcc_of_le hK.le ] ; exact Set.Icc_subset_Icc ( by linarith ) le_rfl );
      · exact Continuous.continuousOn ( by unfold FejerKernel; continuity );
      · fun_prop

/-
The map y -> ModifiedKernel(.-y) is continuous from [-K, K] to C([-K, K]).
-/
theorem ModifiedKernel_uniform_continuity (K t : ℝ) (ht : t > 0) :
  ContinuousOn (fun y => (⟨fun x : Set.Icc (-K) K => ModifiedKernel K t (x - y), by
    refine Continuous.comp (ModifiedKernel_continuous K t ht) (Continuous.sub (Continuous.subtype_val continuous_id) continuous_const)⟩ : C(Set.Icc (-K) K, ℝ))) (Set.Icc (-K) K) := by
      -- The function (y, x) → ModifiedKernel K t (x - y) is a product of continuous functions: ModifiedKernel is continuous, and (x - y) is linear (hence continuous). Therefore, by the properties of continuous functions, this product is continuous.
      have h_cont : Continuous (fun p : ℝ × ℝ => ModifiedKernel K t (p.2 - p.1)) := by
        unfold ModifiedKernel
        generalize_proofs at *;
        unfold FejerKernel HeatKernel; continuity;
      generalize_proofs at *;
      rw [ continuousOn_iff_continuous_restrict ];
      refine' ContinuousMap.continuous_of_continuous_uncurry _ _;
      exact h_cont.comp ( Continuous.prodMk ( continuous_subtype_val.comp continuous_fst ) ( continuous_subtype_val.comp continuous_snd ) )

/-
ModifiedKernel is an even function.
-/
theorem ModifiedKernel_even (K t z : ℝ) : ModifiedKernel K t (-z) = ModifiedKernel K t z := by
  unfold ModifiedKernel;
  unfold FejerKernel HeatKernel;
  norm_num

/-
Convolution of even functions is even.
-/
theorem simple_convolution_even (f g : ℝ → ℝ) (hf : ∀ x, f (-x) = f x) (hg : ∀ x, g (-x) = g x) :
  ∀ x, simple_convolution f g (-x) = simple_convolution f g x := by
    unfold simple_convolution;
    intro x; rw [ ← MeasureTheory.integral_neg_eq_self ] ; congr; ext y; aesop;
    exact Or.inl ( by rw [ ← hg ] ; ring )

/-
This is not quite the right lemma. I want to approximate the *integral*, not the function itself by a constant (which is what the sum is).
Let's go back to the integral approximation.

I want to prove:
`‖∫ y in Set.Icc a b, f y - ∑ y ∈ s, w y • f y‖ < ε`

Strategy:
1. Use uniform continuity to find $\delta$.
2. Partition $[a, b]$ into $n$ intervals of size $< \delta$.
3. Let $y_i$ be points in the intervals (e.g. left endpoints).
4. Let $w_i$ be the lengths of the intervals.
5. Then $\int f \approx \sum \int_{I_i} f \approx \sum w_i f(y_i)$.

Let's try to guide the ATP to this proof.
I will state a lemma that splits the integral into small intervals where the function is nearly constant.
-/
theorem continuous_approx_by_step_function {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {a b : ℝ} (hab : a ≤ b) {f : ℝ → E} (hf : ContinuousOn f (Set.Icc a b)) {ε : ℝ} (hε : ε > 0) :
  ∃ (s : Finset ℝ) (w : ℝ → ℝ), (∀ y ∈ s, y ∈ Set.Icc a b) ∧ (∀ y ∈ s, w y > 0) ∧
  (∀ x ∈ Set.Icc a b, ‖f x - ∑ y ∈ s, (w y / (b - a)) • f y‖ < ε + ‖f x‖) := by
    exact ⟨ ∅, fun _ => 1, by simp +decide, by simp +decide, fun _ _ => by simpa using hε ⟩

/-
If f is close to v on [a, b], then the integral of f is close to (b-a)v.
-/
theorem norm_integral_sub_const_le {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {a b : ℝ} (hab : a ≤ b) {f : ℝ → E} {v : E} {ε : ℝ}
  (hf : ContinuousOn f (Set.Icc a b)) (h_bound : ∀ x ∈ Set.Icc a b, ‖f x - v‖ ≤ ε) :
  ‖(∫ x in Set.Icc a b, f x) - (b - a) • v‖ ≤ (b - a) * ε := by
    -- Apply the fact that the integral of a continuous function over a compact interval is the function evaluated at the midpoint times the length of the interval.
    have h_integral : ‖∫ x in (Set.Icc a b), (f x - v)‖ ≤ (b - a) * ε := by
      exact le_trans ( MeasureTheory.norm_integral_le_integral_norm ( f - fun _ => v ) ) ( le_trans ( MeasureTheory.setIntegral_mono_on ( by exact ContinuousOn.integrableOn_Icc ( by exact ContinuousOn.norm ( hf.sub continuousOn_const ) ) ) ( by exact Continuous.integrableOn_Icc ( by continuity ) ) measurableSet_Icc fun x hx => h_bound x hx ) ( by simp +decide [ hab ] ) );
    rw [ MeasureTheory.integral_sub ( hf.integrableOn_Icc ) ] at h_integral <;> aesop

/-
The integral of a continuous function can be approximated by a Riemann sum.
-/
theorem continuous_map_integral_approx_by_sum {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {a b : ℝ} (hab : a ≤ b) {f : ℝ → E} (hf : ContinuousOn f (Set.Icc a b)) {ε : ℝ} (hε : ε > 0) :
  ∃ (s : Finset ℝ) (w : ℝ → ℝ), (∀ y ∈ s, y ∈ Set.Icc a b) ∧ (∀ y ∈ s, w y > 0) ∧ ‖(∫ y in Set.Icc a b, f y) - ∑ y ∈ s, w y • f y‖ < ε := by
    by_contra h_contra;
    -- Choose n such that (b - a) / n < δ.
    obtain ⟨δ, hδ_pos, hδ⟩ : ∃ δ > 0, ∀ x ∈ Set.Icc a b, ∀ y ∈ Set.Icc a b, abs (x - y) < δ → ‖f x - f y‖ < ε / (2 * (b - a + 1)) := by
      have := Metric.uniformContinuousOn_iff.mp ( isCompact_Icc.uniformContinuousOn_of_continuous hf ) ( ε / ( 2 * ( b - a + 1 ) ) ) ( div_pos hε ( by linarith ) ) ; aesop;
      exact ⟨ w, left, fun x hx₁ hx₂ y hy₁ hy₂ hxy => by simpa only [ dist_eq_norm ] using right x hx₁ hx₂ y hy₁ hy₂ hxy ⟩;
    -- Choose n such that (b - a) / n < δ. Let t_i = a + i * (b - a) / n for i = 0, ..., n.
    obtain ⟨n, hn⟩ : ∃ n : ℕ, 0 < n ∧ (b - a) / n < δ := by
      exact ⟨ ⌊ ( b - a ) / δ⌋₊ + 1, Nat.succ_pos _, by rw [ div_lt_iff₀ ] <;> push_cast <;> nlinarith [ Nat.lt_floor_add_one ( ( b - a ) / δ ), mul_div_cancel₀ ( b - a ) hδ_pos.ne' ] ⟩;
    -- Let t_i = a + i * (b - a) / n for i = 0, ..., n.
    set t : Fin n → ℝ := fun i => a + (i : ℝ) * (b - a) / n;
    -- Then ∫_a^b f = ∑ ∫_{t_i}^{t_{i+1}} f.
    have h_integral_sum : ∫ y in Set.Icc a b, f y = ∑ i : Fin n, ∫ y in (a + (i : ℝ) * (b - a) / n).. (a + ((i + 1) : ℝ) * (b - a) / n), f y := by
      rw [ MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab ];
      have h_partition : ∑ i ∈ Finset.range n, ∫ y in (a + i * (b - a) / n).. (a + (i + 1) * (b - a) / n), f y = ∫ y in a..b, f y := by
        convert intervalIntegral.sum_integral_adjacent_intervals _ <;> norm_num;
        · rw [ mul_div_cancel_left₀ _ ( Nat.cast_ne_zero.mpr hn.1.ne' ), add_sub_cancel ];
        · intro k hk;
          apply_rules [ ContinuousOn.intervalIntegrable, hf.mono ];
          exact fun x hx => ⟨ by cases Set.mem_uIcc.mp hx <;> nlinarith [ show ( k : ℝ ) + 1 ≤ n by norm_cast, mul_div_cancel₀ ( ( k : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( k : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ], by cases Set.mem_uIcc.mp hx <;> nlinarith [ show ( k : ℝ ) + 1 ≤ n by norm_cast, mul_div_cancel₀ ( ( k : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( k : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ⟩;
      rw [ ← h_partition, Finset.sum_range ];
    -- On each interval [t_i, t_{i+1}], ‖f x - f(t_i)‖ < ε / (2 * (b - a + 1)).
    have h_interval_bound : ∀ i : Fin n, ‖∫ y in (a + (i : ℝ) * (b - a) / n).. (a + ((i + 1) : ℝ) * (b - a) / n), f y - f (a + (i : ℝ) * (b - a) / n)‖ ≤ (b - a) / n * ε / (2 * (b - a + 1)) := by
      intro i
      have h_interval_bound_i : ∀ y ∈ Set.Icc (a + (i : ℝ) * (b - a) / n) (a + ((i + 1) : ℝ) * (b - a) / n), ‖f y - f (a + (i : ℝ) * (b - a) / n)‖ ≤ ε / (2 * (b - a + 1)) := by
        intro y hy;
        refine' le_of_lt ( hδ _ _ _ _ _ );
        · constructor <;> nlinarith [ hy.1, hy.2, show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ];
        · exact ⟨ le_add_of_nonneg_right ( div_nonneg ( mul_nonneg ( Nat.cast_nonneg _ ) ( sub_nonneg.mpr hab ) ) ( Nat.cast_nonneg _ ) ), by nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], div_mul_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ⟩;
        · exact abs_lt.mpr ⟨ by nlinarith [ hy.1, hy.2, show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( b - a ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ], by nlinarith [ hy.1, hy.2, show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( b - a ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ⟩;
      refine' le_trans ( intervalIntegral.norm_integral_le_of_norm_le_const _ ) _;
      exact ε / ( 2 * ( b - a + 1 ) );
      · exact fun x hx => h_interval_bound_i x <| by constructor <;> cases Set.mem_uIoc.mp hx <;> nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ;
      · rw [ abs_of_nonneg ( by ring_nf; nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_inv_cancel₀ ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ) ] ; ring_nf; norm_num;
    -- Summing over i, the total error is ≤ (b - a) * ε / (2 * (b - a + 1)) < ε.
    have h_total_error : ‖∑ i : Fin n, (∫ y in (a + (i : ℝ) * (b - a) / n).. (a + ((i + 1) : ℝ) * (b - a) / n), f y) - ∑ i : Fin n, ((b - a) / n) • f (a + (i : ℝ) * (b - a) / n)‖ ≤ (b - a) * ε / (2 * (b - a + 1)) := by
      convert le_trans ( norm_sum_le _ _ ) ( Finset.sum_le_sum fun i _ => h_interval_bound i ) using 1;
      any_goals exact Finset.univ;
      · rw [ ← Finset.sum_sub_distrib, Finset.sum_congr rfl ] ; intros ; rw [ intervalIntegral.integral_sub ] <;> norm_num;
        · ring;
        · apply_rules [ ContinuousOn.intervalIntegrable, hf ];
          exact hf.mono ( by rw [ Set.uIcc_of_le ( by nlinarith [ show ( ↑‹Fin n› : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt ‹_› ], mul_div_cancel₀ ( ( ↑‹Fin n› : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( ↑‹Fin n› : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ) ] ; exact Set.Icc_subset_Icc ( by nlinarith [ show ( ↑‹Fin n› : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt ‹_› ], mul_div_cancel₀ ( ( ↑‹Fin n› : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( ↑‹Fin n› : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ) ( by nlinarith [ show ( ↑‹Fin n› : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt ‹_› ], mul_div_cancel₀ ( ( ↑‹Fin n› : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( ↑‹Fin n› : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( n : ℝ ) ≠ 0 ) ] ) );
      · simp +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm, hn.1.ne' ];
    refine' h_contra ⟨ Finset.image t Finset.univ, fun x => if hx : x ∈ Finset.image t Finset.univ then ( b - a ) / n else 0, _, _, _ ⟩ <;> simp +decide [ Finset.sum_image, * ];
    · simp +zetaDelta at *;
      exact fun i => ⟨ div_nonneg ( mul_nonneg ( Nat.cast_nonneg _ ) ( sub_nonneg.mpr hab ) ) ( Nat.cast_nonneg _ ), by rw [ add_div', div_le_iff₀ ] <;> nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ] ] ⟩;
    · intro i; cases lt_or_eq_of_le hab <;> simp_all +decide ;
      specialize h_contra ∅ ; aesop;
      linarith;
    · rw [ Finset.sum_image ] <;> simp +decide [ * ];
      · exact lt_of_le_of_lt h_total_error ( by rw [ div_lt_iff₀ ] <;> nlinarith );
      · intro i _ j _ hij; aesop;
        simp_all +decide [ div_eq_mul_inv, ne_of_gt left ];
        exact Fin.ext ( hij.resolve_right ( sub_ne_zero_of_ne ( by rintro rfl; exact absurd ( h_contra ∅ ( by simp +decide ) ( fun _ => 1 ) ( by simp +decide ) ) ( by simp +decide [ hε ] ) ) ) )

/-
If a function is close to a step function on a uniform partition, its integral is close to the Riemann sum.
-/
theorem integral_approx_uniform_partition_sum {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {a b : ℝ} (hab : a ≤ b) {f : ℝ → E} (hf : ContinuousOn f (Set.Icc a b))
  (n : ℕ) (hn : n > 0) (ε : ℝ) (hε : ε > 0)
  (h_bound : ∀ i : Fin n, ∀ x ∈ Set.Icc (a + i * (b - a) / n) (a + (i + 1) * (b - a) / n), ‖f x - f (a + i * (b - a) / n)‖ ≤ ε) :
  ‖(∫ x in Set.Icc a b, f x) - ∑ i : Fin n, ((b - a) / n) • f (a + i * (b - a) / n)‖ ≤ (b - a) * ε := by
    -- On each subinterval, we can approximate the integral by $(t_{i+1} - t_i) \cdot f(t_i)$.
    have h_integral_approx : ∀ i : Fin n, ‖(∫ x in (a + (i : ℝ) * (b - a) / n).. (a + ((i : ℝ) + 1) * (b - a) / n), f x) - ((b - a) / n) • f (a + (i : ℝ) * (b - a) / n)‖ ≤ ((b - a) / n) * ε := by
      intro i
      have h_integral_subinterval : ‖(∫ x in (a + (i : ℝ) * (b - a) / n).. (a + ((i : ℝ) + 1) * (b - a) / n), (f x - f (a + (i : ℝ) * (b - a) / n)))‖ ≤ ((b - a) / n) * ε := by
        refine' le_trans ( intervalIntegral.norm_integral_le_of_norm_le_const _ ) _;
        exacts [ ε, fun x hx => h_bound i x <| by constructor <;> cases Set.mem_uIoc.mp hx <;> nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ) ], by rw [ abs_of_nonneg ] <;> nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ), div_mul_cancel₀ ( b - a ) ( by positivity : ( n : ℝ ) ≠ 0 ) ] ];
      rw [ intervalIntegral.integral_sub ] at h_integral_subinterval <;> aesop;
      · convert h_integral_subinterval using 2 ; ring;
      · apply_rules [ ContinuousOn.intervalIntegrable, hf.mono ];
        rw [ Set.uIcc_of_le ( by exact add_le_add_left ( div_le_div_of_nonneg_right ( by linarith ) ( by positivity ) ) _ ) ] ; exact Set.Icc_subset_Icc ( by nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ) ] ) ( by nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ) ] ) ;
    -- The integral over [a, b] can be written as the sum of integrals over the subintervals.
    have h_integral_sum : ∫ x in Set.Icc a b, f x = ∑ i : Fin n, ∫ x in (a + (i : ℝ) * (b - a) / n).. (a + ((i : ℝ) + 1) * (b - a) / n), f x := by
      rw [ MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab ];
      have h_integral_sum : ∫ x in a..b, f x = ∑ i ∈ Finset.range n, ∫ x in (a + (i : ℝ) * (b - a) / n).. (a + ((i : ℝ) + 1) * (b - a) / n), f x := by
        symm;
        convert intervalIntegral.sum_integral_adjacent_intervals _ <;> aesop;
        · rw [ mul_div_cancel_left₀ _ ( by positivity ), add_sub_cancel ];
        · apply_rules [ ContinuousOn.intervalIntegrable, hf.mono ];
          exact fun x hx => ⟨ by cases Set.mem_uIcc.mp hx <;> nlinarith [ show ( k : ℝ ) + 1 ≤ n by norm_cast, mul_div_cancel₀ ( ( k : ℝ ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( k : ℝ ) + 1 ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ) ], by cases Set.mem_uIcc.mp hx <;> nlinarith [ show ( k : ℝ ) + 1 ≤ n by norm_cast, mul_div_cancel₀ ( ( k : ℝ ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( k : ℝ ) + 1 ) * ( b - a ) ) ( by positivity : ( n : ℝ ) ≠ 0 ) ] ⟩;
      rw [ h_integral_sum, Finset.sum_range ];
    rw [ h_integral_sum ];
    simpa only [ Finset.sum_sub_distrib, norm_smul, Real.norm_eq_abs, abs_of_nonneg ( div_nonneg ( sub_nonneg.mpr hab ) ( Nat.cast_nonneg n ) ) ] using le_trans ( norm_sum_le _ _ ) ( le_trans ( Finset.sum_le_sum fun i _ => h_integral_approx i ) ( by simp +decide [ mul_assoc, mul_comm, mul_left_comm, div_eq_mul_inv, hn.ne' ] ) )

