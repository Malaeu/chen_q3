/-
Quotient of locally uniformly convergent sequences converges locally uniformly if the denominator limit is non-zero and continuous.
-/
lemma TendstoLocallyUniformlyOn_div {ι : Type*} [Preorder ι] {F : ι → ℂ → ℂ} {f : ℂ → ℂ} {G : ι → ℂ → ℂ} {g : ℂ → ℂ} {S : Set ℂ}
    (hf : TendstoLocallyUniformlyOn F f Filter.atTop S)
    (hg : TendstoLocallyUniformlyOn G g Filter.atTop S)
    (hf_cont : ContinuousOn f S)
    (hg_cont : ContinuousOn g S)
    (hg_ne_zero : ∀ z ∈ S, g z ≠ 0) :
    TendstoLocallyUniformlyOn (fun i z => F i z / G i z) (fun z => f z / g z) Filter.atTop S := by
      rw [ Metric.tendstoLocallyUniformlyOn_iff ] at *;
      intro ε hε x hx;
      -- Since $g$ is continuous and $g(x) \neq 0$, there exists a neighborhood $U$ of $x$ and $\delta > 0$ such that $|g(z)| > \delta$ for all $z \in U \cap S$.
      obtain ⟨δ, hδ_pos, hδ⟩ : ∃ δ > 0, ∀ᶠ y in nhdsWithin x S, δ ≤ ‖g y‖ := by
        have := hg_cont x hx;
        have := this.norm;
        exact ⟨ ‖g x‖ / 2, half_pos ( norm_pos_iff.mpr ( hg_ne_zero x hx ) ), this.eventually ( le_mem_nhds ( half_lt_self ( norm_pos_iff.mpr ( hg_ne_zero x hx ) ) ) ) ⟩;
      -- Since $f$ and $g$ are continuous on $S$, there exists a neighborhood $U$ of $x$ such that $|f(y)| \leq M$ and $|g(y)| \leq M$ for all $y \in U \cap S$.
      obtain ⟨M, hM⟩ : ∃ M > 0, ∀ᶠ y in nhdsWithin x S, ‖f y‖ ≤ M ∧ ‖g y‖ ≤ M := by
        have h_cont : ContinuousOn (fun y => ‖f y‖ + ‖g y‖) S := by
          exact ContinuousOn.add ( hf_cont.norm ) ( hg_cont.norm );
        have := h_cont.continuousWithinAt hx;
        exact ⟨ ‖f x‖ + ‖g x‖ + 1, by positivity, this.eventually ( ge_mem_nhds <| show ‖f x‖ + ‖g x‖ < ‖f x‖ + ‖g x‖ + 1 by linarith ) |> fun h => h.mono fun y hy => ⟨ by linarith [ norm_nonneg ( f y ), norm_nonneg ( g y ) ], by linarith [ norm_nonneg ( f y ), norm_nonneg ( g y ) ] ⟩ ⟩;
      -- Choose $\epsilon' = \min(\frac{\epsilon \delta^2}{4M}, \frac{\delta}{2})$.
      set ε' := min (ε * δ^2 / (4 * M)) (δ / 2) with hε'_def
      have hε'_pos : ε' > 0 := by
        exact lt_min ( div_pos ( mul_pos hε ( sq_pos_of_pos hδ_pos ) ) ( mul_pos zero_lt_four hM.1 ) ) ( half_pos hδ_pos );
      obtain ⟨ t₁, ht₁, ht₁' ⟩ := hf ε' hε'_pos x hx;
      obtain ⟨ t₂, ht₂, ht₂' ⟩ := hg ε' hε'_pos x hx;
      refine' ⟨ t₁ ∩ t₂ ∩ { y | δ ≤ ‖g y‖ ∧ ‖f y‖ ≤ M ∧ ‖g y‖ ≤ M }, _, _ ⟩ <;> simp_all +decide [ dist_eq_norm ];
      · exact Filter.inter_mem ( hδ ) ( Filter.inter_mem hM.2.1 hM.2.2 );
      · filter_upwards [ ht₁', ht₂' ] with n hn hn';
        intro y hy₁ hy₂ hy₃ hy₄ hy₅;
        -- Using the triangle inequality and the bounds on $f$ and $g$, we get:
        have h_triangle : ‖f y / g y - F n y / G n y‖ ≤ (‖f y - F n y‖ * ‖g y‖ + ‖f y‖ * ‖g y - G n y‖) / (‖g y‖ * ‖G n y‖) := by
          rw [ div_sub_div ];
          · rw [ norm_div, norm_mul ];
            gcongr;
            convert norm_add_le ( ( f y - F n y ) * g y ) ( f y * ( G n y - g y ) ) using 1 ; ring;
            simp +decide [ norm_mul, norm_sub_rev ];
          · exact fun h => by norm_num [ h ] at hy₃; linarith;
          · intro H; specialize hn' y hy₂; simp_all +decide [ sub_eq_iff_eq_add ] ;
            linarith;
        -- Using the bounds on $f$ and $g$, we get:
        have h_bounds : ‖f y - F n y‖ * ‖g y‖ + ‖f y‖ * ‖g y - G n y‖ < ε * δ^2 / 2 := by
          have := hn y hy₁; have := hn' y hy₂; nlinarith [ norm_nonneg ( f y - F n y ), norm_nonneg ( g y - G n y ), mul_div_cancel₀ ( ε * δ ^ 2 ) ( by linarith : ( 4 * M ) ≠ 0 ) ] ;
        -- Using the bounds on $g$, we get:
        have h_g_bounds : ‖g y‖ * ‖G n y‖ ≥ δ^2 / 2 := by
          have := hn' y hy₂;
          nlinarith [ norm_nonneg ( g y - G n y ), norm_sub_norm_le ( g y ) ( G n y ) ];
        exact h_triangle.trans_lt ( by rw [ div_lt_iff₀ ] <;> nlinarith [ show 0 < δ ^ 2 by positivity ] )

/-
Gamma is continuous on the right half-plane.
-/
lemma Complex.continuousOn_Gamma_of_re_pos {S : Set ℂ} (hS : S ⊆ {z | 0 < z.re}) :
    ContinuousOn Complex.Gamma S := by
      -- The Gamma function is differentiable on the set where its real part is positive, hence it is continuous.
      have h_diff : ∀ z : ℂ, 0 < z.re → DifferentiableAt ℂ Complex.Gamma z := by
        intro z hz_pos
        apply Complex.differentiableAt_Gamma;
        exact fun m => ne_of_apply_ne Complex.re <| by norm_num; linarith;
      exact fun z hz => DifferentiableAt.continuousAt ( h_diff z ( hS hz ) ) |> ContinuousAt.continuousWithinAt

/-
Quotient of locally uniformly convergent sequences converges locally uniformly if the denominator limit is non-zero and continuous.
-/
lemma TendstoLocallyUniformlyOn_div_v2 {ι : Type*} [Preorder ι] {F : ι → ℂ → ℂ} {f : ℂ → ℂ} {G : ι → ℂ → ℂ} {g : ℂ → ℂ} {S : Set ℂ}
    (hf : TendstoLocallyUniformlyOn F f Filter.atTop S)
    (hg : TendstoLocallyUniformlyOn G g Filter.atTop S)
    (hf_cont : ContinuousOn f S)
    (hg_cont : ContinuousOn g S)
    (hg_ne_zero : ∀ z ∈ S, g z ≠ 0) :
    TendstoLocallyUniformlyOn (fun i z => F i z / G i z) (fun z => f z / g z) Filter.atTop S := by
      exact?

/-
The derivative of Gamma is continuous on the right half-plane.
-/
lemma Complex.continuousOn_deriv_Gamma_of_re_pos {S : Set ℂ} (hS : S ⊆ {z | 0 < z.re}) :
    ContinuousOn (deriv Complex.Gamma) S := by
      have h_diff : ∀ z ∈ {z : ℂ | 0 < z.re}, AnalyticAt ℂ Complex.Gamma z := by
        intro z hz;
        refine' DifferentiableOn.analyticAt _ _;
        exact { w : ℂ | 0 < w.re };
        · refine' fun w hw => DifferentiableAt.differentiableWithinAt _;
          apply_rules [ Complex.differentiableAt_Gamma ];
          exact fun m => ne_of_apply_ne Complex.re <| by norm_num; linarith [ hw.out ];
        · exact IsOpen.mem_nhds ( isOpen_lt continuous_const Complex.continuous_re ) hz;
      -- Since $\Gamma$ is analytic on $S$, its derivative $\Gamma'$ is also analytic on $S$.
      have h_deriv_analytic : ∀ z ∈ {z : ℂ | 0 < z.re}, AnalyticAt ℂ (deriv Complex.Gamma) z := by
        exact?;
      exact fun z hz => ( h_deriv_analytic z ( hS hz ) |> AnalyticAt.continuousAt |> ContinuousAt.continuousWithinAt )

/-
digammaSeq converges locally uniformly to digamma on the right half-plane.
-/
lemma digammaSeq_tendstoLocallyUniformlyOn (S : Set ℂ)
    (hS : S ⊆ {z | 0 < z.re}) (hS_open : IsOpen S) :
    TendstoLocallyUniformlyOn (fun n z => digammaSeq z n) digamma Filter.atTop S := by
      -- Since `digammaSeq z n` is eventually equal to `F n z / G n z` for all `z ∈ S`, they have the same limit.
      have h_eventually_equal : ∀ᶠ n in Filter.atTop, ∀ z ∈ S, digammaSeq z n = (deriv (Complex.GammaSeq · n) z) / (Complex.GammaSeq z n) := by
        filter_upwards [ Filter.eventually_ne_atTop 0 ] with n hn z hz using digammaSeq_eq_logDeriv_GammaSeq hn fun k hk => by exact fun h => absurd ( hS hz ) ( by norm_num [ h ] ) ;
      rw [ Metric.tendstoLocallyUniformlyOn_iff ] at *;
      norm_num +zetaDelta at *;
      intro ε hε x hx;
      -- By the properties of the Gamma function and its derivatives, we know that the quotient of the derivatives converges locally uniformly to the quotient of the derivatives.
      have h_quotient_converge : TendstoLocallyUniformlyOn (fun n z => (deriv (Complex.GammaSeq · n) z) / (Complex.GammaSeq z n)) (fun z => (deriv Complex.Gamma z) / (Complex.Gamma z)) Filter.atTop S := by
        apply_rules [ TendstoLocallyUniformlyOn_div_v2 ];
        · exact?;
        · exact?;
        · exact?;
        · exact?;
        · exact fun z hz => Complex.Gamma_ne_zero_of_re_pos <| hS hz;
      rw [ Metric.tendstoLocallyUniformlyOn_iff ] at h_quotient_converge;
      obtain ⟨ t, ht₁, ht₂ ⟩ := h_quotient_converge ε hε x hx;
      obtain ⟨ N, hN ⟩ := Filter.eventually_atTop.mp ht₂;
      obtain ⟨ M, hM ⟩ := h_eventually_equal;
      exact ⟨ t ∩ S, Filter.inter_mem ht₁ ( Filter.mem_of_superset self_mem_nhdsWithin fun y hy => hy ), Max.max N M, fun n hn y hy => by simpa only [ hM n ( le_trans ( le_max_right _ _ ) hn ) y hy.2, dist_comm ] using hN n ( le_trans ( le_max_left _ _ ) hn ) y hy.1 ⟩

