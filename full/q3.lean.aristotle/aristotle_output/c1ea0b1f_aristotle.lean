#check TendstoLocallyUniformlyOn.deriv

/-
digammaSeq is differentiable on the right half-plane.
-/
lemma differentiableOn_digammaSeq (S : Set ℂ) (hS : S ⊆ {z | 0 < z.re}) (n : ℕ) :
    DifferentiableOn ℂ (fun z => digammaSeq z n) S := by
      refine' DifferentiableOn.const_sub _ _ |> DifferentiableOn.congr <| fun z hz => _;
      exact fun z => ( ∑ k ∈ Finset.range ( n + 1 ), ( k + z ) ⁻¹ );
      -- Each term (k + z)⁻¹ is differentiable on S because the denominator k + z is never zero for z in S.
      have h_diff : ∀ k ∈ Finset.range (n + 1), DifferentiableOn ℂ (fun z => (k + z : ℂ)⁻¹) S := by
        exact fun k hk => DifferentiableOn.inv ( differentiableOn_id.const_add _ ) fun z hz => ne_of_apply_ne Complex.re <| by norm_num; linarith [ Set.mem_setOf.mp ( hS hz ) ] ;
      exact?;
      exact ( Real.log n : ℂ );
      unfold digammaSeq; ring;

/-
The derivative of digamma is trigamma on the right half-plane.
-/
theorem deriv_digamma_eq_trigamma {z : ℂ} (hz : 0 < z.re) :
    deriv digamma z = trigamma z := by
      -- By definition of digamma, we know that its derivative is trigamma. Use this fact.
      have h_deriv : Filter.Tendsto (fun n => deriv (fun z => digammaSeq z n) z) Filter.atTop (nhds (deriv digamma z)) := by
        have h_deriv : TendstoLocallyUniformlyOn (fun n z => deriv (fun z => digammaSeq z n) z) (deriv digamma) Filter.atTop {w | 0 < w.re} := by
          apply_rules [ TendstoLocallyUniformlyOn.deriv ];
          · apply_rules [ digammaSeq_tendstoLocallyUniformlyOn ];
            · exact Set.Subset.rfl;
            · exact isOpen_lt continuous_const Complex.continuous_re;
          · exact Filter.Eventually.of_forall fun n => differentiableOn_digammaSeq _ ( fun w hw => hw ) n;
          · exact isOpen_lt continuous_const Complex.continuous_re;
        have := h_deriv.tendsto_at ( show z ∈ { w : ℂ | 0 < w.re } from hz );
        convert this using 1;
      exact tendsto_nhds_unique h_deriv ( deriv_digammaSeq_tendsto_trigamma z hz )

/-
The derivative of digammaSeq converges locally uniformly to the derivative of digamma.
-/
lemma deriv_digammaSeq_tendstoLocallyUniformlyOn (S : Set ℂ)
    (hS : S ⊆ {z | 0 < z.re}) (hS_open : IsOpen S) :
    TendstoLocallyUniformlyOn (fun n z => deriv (fun w => digammaSeq w n) z) (deriv digamma) Filter.atTop S := by
      apply_rules [ TendstoLocallyUniformlyOn.deriv ];
      · exact?;
      · exact Filter.Eventually.of_forall fun n => differentiableOn_digammaSeq S hS n

