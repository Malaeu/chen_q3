lemma deriv_GammaSeq_tendstoLocallyUniformlyOn (S : Set ℂ)
    (hS : S ⊆ {z | 0 < z.re}) (hS_open : IsOpen S) :
    TendstoLocallyUniformlyOn (fun n z => deriv (fun w => Complex.GammaSeq w n) z)
      (deriv Complex.Gamma) Filter.atTop S := by
        -- By definition of $GammaSeq$, we know that it converges locally uniformly to $Gamma$ on $S$.
        have h_local_uniform_converge : TendstoLocallyUniformlyOn (fun n : ℕ => fun w => Complex.GammaSeq w n) Complex.Gamma Filter.atTop S := by
          exact?;
        apply_rules [ h_local_uniform_converge.deriv ];
        refine' Filter.Eventually.of_forall fun n => _;
        intro w hw;
        refine' DifferentiableAt.differentiableWithinAt _;
        refine' DifferentiableAt.mul _ _;
        · by_cases hn : n = 0 <;> simp_all +decide [ Complex.cpow_def ];
          · exact DifferentiableAt.congr_of_eventuallyEq ( differentiableAt_const 0 ) ( by filter_upwards [ IsOpen.mem_nhds ( isOpen_compl_singleton.preimage continuous_id' ) ( show w ≠ 0 from by rintro rfl; exact absurd ( hS hw ) ( by norm_num ) ) ] with x hx using if_neg hx );
          · exact DifferentiableAt.mul ( Complex.differentiableAt_exp.comp _ ( differentiableAt_id.const_mul _ ) ) ( differentiableAt_const _ );
        · refine' DifferentiableAt.inv _ _;
          · fun_prop;
          · exact Finset.prod_ne_zero_iff.mpr fun i hi => ne_of_apply_ne Complex.re <| by norm_num; linarith [ Set.mem_setOf.mp <| hS hw ] ;

