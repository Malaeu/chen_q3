/-
Definition of the Fejer Kernel (hat function) with width δ.
-/
noncomputable def FejerKernel (δ : ℝ) (x : ℝ) : ℝ := max (1 - |x| / δ) 0

/-
Counterexample showing that the hat interpolation theorem fails for non-vanishing functions due to the margin condition.
-/
theorem hat_interpolation_counterexample :
    ∃ (K : ℝ) (hK : K > 0) (f : ℝ → ℝ) (hf_cont : ContinuousOn f (Set.Icc (-K) K))
      (hf_nonneg : ∀ x ∈ Set.Icc (-K) K, 0 ≤ f x) (ε : ℝ) (hε : ε > 0),
      ¬ ∃ (n : ℕ) (τ : Fin n → ℝ) (δ : ℝ),
        n > 0 ∧ δ > 0 ∧
        (∀ i, τ i ∈ Set.Ioo (-K) K) ∧
        (∀ i, |τ i| + δ ≤ K) ∧
        (∀ x ∈ Set.Icc (-K) K,
          |∑ i, f (τ i) * FejerKernel δ (x - τ i) - f x| < ε) := by
            use 1; norm_num;
            refine' ⟨ fun _ => 1, _, _, 1 / 2, _, _ ⟩ <;> norm_num;
            · fun_prop (disch := norm_num);
            · intro n hn τ δ hδ hτ hδ';
              refine' ⟨ 1, _, _, _ ⟩ <;> norm_num;
