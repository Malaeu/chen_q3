                exact fun i => max_eq_right ( by cases abs_cases ( τ i ) <;> cases abs_cases ( 1 - τ i ) <;> nlinarith [ hδ' i, mul_div_cancel₀ ( |1 - τ i| ) hδ.ne' ] );
              norm_num [ h_fejer_zero ]

/-
On the interval [τ_k, τ_{k+1}], the two adjacent hat functions sum to 1.
-/
lemma fejer_partition_of_unity (δ : ℝ) (hδ : δ > 0) (x : ℝ) (a : ℝ) (k : ℕ)
    (h_range : x ∈ Set.Icc (a + k * δ) (a + (k + 1) * δ)) :
    FejerKernel δ (x - (a + k * δ)) + FejerKernel δ (x - (a + (k + 1) * δ)) = 1 := by
      field_simp;
      unfold FejerKernel;
      rw [ max_eq_left, max_eq_left ] <;> cases abs_cases ( x - ( a + k * δ ) ) <;> cases abs_cases ( x - ( a + δ * ( k + 1 ) ) ) <;> nlinarith [ h_range.1, h_range.2, mul_div_cancel₀ ( |x - ( a + k * δ )| ) hδ.ne', mul_div_cancel₀ ( |x - ( a + δ * ( k + 1 ) )| ) hδ.ne' ]

/-
Points on a grid with constant spacing δ form an arithmetic progression.
-/
lemma grid_arithmetic_progression (n : ℕ) (hn : n > 0) (τ : Fin n → ℝ) (δ : ℝ)
    (h_step : ∀ i : Fin n, (h : (i : ℕ) + 1 < n) → τ ⟨i + 1, h⟩ = τ i + δ) :
    ∀ i : Fin n, τ i = τ ⟨0, hn⟩ + (i : ℝ) * δ := by
      -- We proceed by induction on $i$.
      intro i
      induction' i with i ih;
      induction' i with i ih;
      · norm_num;
      · grind

