            · apply mul_le_mul_of_nonneg_right (le_of_lt (hf_unif (τ i) x (by
              constructor <;> nlinarith [ h_grid i, show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( 2 * K ) ( by positivity : ( n : ℝ ) + 1 ≠ 0 ) ]) hx (by
              rwa [ abs_sub_comm ]))) (by
              exact le_max_right _ _);
            · rw [ FejerKernel ];
              rw [ max_eq_right ( by nlinarith [ abs_nonneg ( x - τ i ), mul_div_cancel₀ ( |x - τ i| ) hδ.ne' ] ) ] ; norm_num;
          exact lt_of_le_of_lt ‹_› ( lt_of_le_of_lt ( Finset.sum_le_sum fun _ _ => h_interior_approx _ ) ( by rw [ ← Finset.mul_sum _ _ _ ] ; nlinarith ) );
        exact h_interior_approx

/-
If f vanishes at the boundaries, we can approximate it with hat functions supported strictly inside [-K, K].
-/
lemma hat_interpolation_approx_of_boundary_vanish (K : ℝ) (hK : K > 0) (f : ℝ → ℝ)
    (hf_cont : ContinuousOn f (Set.Icc (-K) K)) (hf_nonneg : ∀ x ∈ Set.Icc (-K) K, 0 ≤ f x)
    (hf_boundary : f (-K) = 0 ∧ f K = 0)
    (ε : ℝ) (hε : ε > 0) :
    ∃ (n : ℕ) (τ : Fin n → ℝ) (δ : ℝ),
      n > 0 ∧ δ > 0 ∧
      (∀ i, τ i ∈ Set.Ioo (-K) K) ∧
      (∀ i, |τ i| + δ ≤ K) ∧
      (∀ x ∈ Set.Icc (-K) K,
        |∑ i, f (τ i) * FejerKernel δ (x - τ i) - f x| < ε) ∧
      (∀ x ∈ Set.Icc (-K) K,
        0 ≤ ∑ i, f (τ i) * FejerKernel δ (x - τ i)) := by
          obtain ⟨δ₀, hδ₀_pos, hδ₀⟩ : ∃ δ₀ > 0, ∀ x y, x ∈ Set.Icc (-K) K → y ∈ Set.Icc (-K) K → |x - y| < δ₀ → |f x - f y| < ε / 2 := by
            have := Metric.uniformContinuousOn_iff.mp ( isCompact_Icc.uniformContinuousOn_of_continuous hf_cont ) ( ε / 2 ) ( half_pos hε ) ; aesop;
          -- Since `f` is continuous at `-K` and `f(-K)=0`, there exists `d1 > 0` such that `|x - (-K)| < d1 → |f x| < ε/2`.
          -- Since `f` is continuous at `K` and `f(K)=0`, there exists `d2 > 0` such that `|x - K| < d2 → |f x| < ε/2`.
          -- Let `δ₁ = min(d1, d2)`. Then `|x ± K| < δ₁ → |f x| < ε/2`.
          obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ : ∃ δ₁ > 0, ∀ x, x ∈ Set.Icc (-K) K → |x + K| < δ₁ ∨ |x - K| < δ₁ → |f x| < ε / 2 := by
            grind;
          -- Let `δ_target = min(δ₀, δ₁, K)`.
          set δ_target := min δ₀ (min δ₁ K) with hδ_target_def;
          -- Use `exists_suitable_grid` to find `n, δ` such that `δ < δ_target` and `δ = 2K/(n+1)`.
          obtain ⟨n, hn, δ, hδ, hδ_lt, hδ_eq⟩ : ∃ n : ℕ, ∃ δ : ℝ, n > 0 ∧ δ > 0 ∧ δ < δ_target ∧ δ = 2 * K / (n + 1) := by
            exact exists_suitable_grid K hK δ_target ( lt_min hδ₀_pos ( lt_min hδ₁_pos hK ) ) |> fun ⟨ n, δ, hn, hδ, hδ_lt, hδ_eq ⟩ => ⟨ n, δ, hn, hδ, hδ_lt, hδ_eq ⟩;
          refine' ⟨ n, fun i => -K + ( i + 1 ) * hn, hn, δ, hδ, _, _, _, _ ⟩ <;> norm_num [ hδ_eq ];
          · exact fun i => ⟨ by positivity, by nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( 2 * K ) ( by positivity : ( n : ℝ ) + 1 ≠ 0 ) ] ⟩;
          · field_simp;
            intro i; rw [ abs_div, abs_of_nonneg ( by positivity : ( 0 : ℝ ) ≤ ( n : ℝ ) + 1 ) ] ; rw [ mul_div_cancel₀ _ ( by positivity ) ] ; ring_nf;
            cases abs_cases ( K - K * n + K * i * 2 ) <;> nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ] ];
          · intro x hx₁ hx₂;
            convert hat_interpolation_verify K hK f ε hε n δ ( fun i => -K + ( i + 1 ) * ( 2 * K / ( n + 1 ) ) ) ( 2 * K / ( n + 1 ) ) ( by positivity ) ( fun i => rfl ) rfl _ _ _ x ⟨ hx₁, hx₂ ⟩ using 1;
            · exact fun x y hx hy hxy => hδ₀ x y hx hy <| lt_of_le_of_lt hxy <| by linarith [ min_le_left δ₀ ( Min.min δ₁ K ), min_le_right δ₀ ( Min.min δ₁ K ), min_le_left δ₁ K, min_le_right δ₁ K ] ;
            · exact fun x hx hx' => hδ₁ x hx <| Or.imp ( fun hx'' => lt_of_lt_of_le hx'' <| by linarith [ min_le_left δ₀ ( Min.min δ₁ K ), min_le_right δ₀ ( Min.min δ₁ K ), min_le_left δ₁ K, min_le_right δ₁ K ] ) ( fun hx'' => lt_of_lt_of_le hx'' <| by linarith [ min_le_left δ₀ ( Min.min δ₁ K ), min_le_right δ₀ ( Min.min δ₁ K ), min_le_left δ₁ K, min_le_right δ₁ K ] ) hx';
            · tauto;
          · exact fun x hx₁ hx₂ => Finset.sum_nonneg fun i _ => mul_nonneg ( hf_nonneg _ ⟨ by nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( 2 * K ) ( by positivity : ( n : ℝ ) + 1 ≠ 0 ) ], by nlinarith [ show ( i : ℝ ) + 1 ≤ n by norm_cast; linarith [ Fin.is_lt i ], mul_div_cancel₀ ( 2 * K ) ( by positivity : ( n : ℝ ) + 1 ≠ 0 ) ] ⟩ ) ( by unfold FejerKernel; positivity ) ;

/-
Corrected version of the user's theorem, assuming boundary vanishing.
-/
lemma hat_interpolation_approx (K : ℝ) (hK : K > 0) (f : ℝ → ℝ)
    (hf_cont : ContinuousOn f (Set.Icc (-K) K)) (hf_nonneg : ∀ x ∈ Set.Icc (-K) K, 0 ≤ f x)
    (hf_boundary : f (-K) = 0 ∧ f K = 0)
    (ε : ℝ) (hε : ε > 0) :
    ∃ (n : ℕ) (τ : Fin n → ℝ) (δ : ℝ),
      n > 0 ∧ δ > 0 ∧
      (∀ i, τ i ∈ Set.Ioo (-K) K) ∧
      (∀ i, |τ i| + δ ≤ K) ∧
      (∀ x ∈ Set.Icc (-K) K,
        |∑ i, f (τ i) * FejerKernel δ (x - τ i) - f x| < ε) ∧
      (∀ x ∈ Set.Icc (-K) K,
        0 ≤ ∑ i, f (τ i) * FejerKernel δ (x - τ i)) := by
          exact hat_interpolation_approx_of_boundary_vanish K hK f hf_cont hf_nonneg hf_boundary ε hε

end HatInterp

