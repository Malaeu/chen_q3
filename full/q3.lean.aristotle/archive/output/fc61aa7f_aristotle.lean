          exact fun z hz n hn => Real.exp_le_exp.mpr ( le_trans ( hC z hz n hn ) ( div_le_self ( show 0 ≤ C by exact le_trans ( norm_nonneg _ ) ( hC _ hz 1 le_rfl ) |> le_trans <| by norm_num ) <| mod_cast hn ) );
        use C^2 * D;
        intro z hz n hn; convert le_trans ( h_exp_bound.choose_spec z hz n hn ) _ using 1; ring;
        convert mul_le_mul ( pow_le_pow_left₀ ( norm_nonneg _ ) ( show ‖z * Complex.log ( 1 + ( n : ℂ ) ⁻¹ )‖ ≤ C / ( n : ℝ ) from by simpa using hC z hz n hn ) 2 ) ( hD z hz n hn ) ( by positivity ) ( by positivity ) using 1 ; ring;
        ring;
      obtain ⟨ C₁, hC₁ ⟩ := h_log_bound; obtain ⟨ C₂, hC₂ ⟩ := h_exp_bound; use C₁ + C₂; intros z hz n hn; convert le_trans ( norm_add_le _ _ ) ( add_le_add ( hC₁ z hz n hn ) ( hC₂ z hz n hn ) ) using 1 ; ring;
      · rw [ Complex.cpow_def_of_ne_zero ( by exact ne_of_apply_ne Complex.re <| by norm_num; linarith [ inv_pos.mpr ( by positivity : 0 < ( n : ℝ ) ) ] ), mul_comm ];
        ring;
      · ring
    skip;
    exact h_log_expansion;
  -- By definition of $f$, we know that $‖1 + z / (n : ℂ)‖ ≥ 1$ for all $z \in K$ and $n ≥ 1$.
  have h_denom_bound : ∃ D : ℝ, ∀ z ∈ K, ∀ n : ℕ, 1 ≤ n → 1 ≤ ‖1 + z / (n : ℂ)‖ := by
    norm_num [ Complex.norm_def, Complex.normSq ];
    exact fun z hz n hn => by nlinarith only [ show 0 ≤ z.re / ( n : ℝ ) by exact div_nonneg ( le_of_lt ( hK_pos z hz ) ) ( Nat.cast_nonneg n ) ] ;
  -- By combining the bounds from hC and h_denom_bound, we can conclude the proof.
  obtain ⟨D, hD⟩ := h_denom_bound;
  use C;
  intro z hz n hn;
  have h_diff : ‖(1 + 1 / (n : ℂ))^z - (1 + z / (n : ℂ))‖ ≤ C / (n : ℝ)^2 := hC z hz n hn;
  have h_denom : 1 ≤ ‖1 + z / (n : ℂ)‖ := hD z hz n hn;
  have h_final : ‖(1 + 1 / (n : ℂ))^z / (1 + z / (n : ℂ)) - 1‖ ≤ C / (n : ℝ)^2 := by
    rw [ div_sub_one ];
    · simpa only [ norm_div ] using div_le_self ( norm_nonneg _ ) h_denom |> le_trans <| h_diff;
    · exact fun h => by norm_num [ h ] at h_denom;;
  exact h_final

/-
The Gamma sequence can be written as a product involving terms of the form (1+1/k)^z / (1+z/k).
-/
lemma GammaSeq_eq_product (z : ℂ) (n : ℕ) (hn : n ≠ 0) (hz : ∀ k : ℕ, z ≠ -k) :
    Complex.GammaSeq z n = 1 / z * (∏ k ∈ Finset.range n, (1 + 1 / ((k + 1) : ℂ)) ^ z / (1 + z / (k + 1))) * (n / (n + 1 : ℂ)) ^ z := by
  -- Now use the fact that $\prod_{k=1}^n (1+1/k) = n+1$.
  have h_prod : ∏ k ∈ Finset.range n, (1 + 1 / (k + 1 : ℂ)) ^ z = (n + 1 : ℂ) ^ z := by
    induction' n with n ih;
    · contradiction;
    · by_cases hn : n = 0 <;> simp_all +decide [ Finset.prod_range_succ ];
      rw [ ← mul_comm, Complex.cpow_def_of_ne_zero, Complex.cpow_def_of_ne_zero, Complex.cpow_def_of_ne_zero ] <;> norm_num [ Nat.cast_add_one_ne_zero ];
      · rw [ ← Complex.exp_add, Complex.log, Complex.log, Complex.log ];
        norm_num [ Complex.normSq, Complex.norm_def, Complex.arg ];
        field_simp;
        rw [ Real.sqrt_div ( by positivity ), Real.sqrt_sq ( by positivity ), Real.sqrt_sq ( by positivity ) ] ; norm_num [ add_nonneg, Nat.cast_nonneg ];
        rw [ Real.log_div ( by positivity ) ( by positivity ) ] ; push_cast ; ring;
      · norm_cast;
      · exact ne_of_apply_ne Complex.re ( by norm_num [ Complex.normSq, Complex.div_re ] ; positivity );
  by_cases h : z = 0 <;> simp_all +decide [ Complex.GammaSeq ];
  field_simp [h_prod];
  rw [ div_eq_div_iff ];
  · rw [ Finset.prod_range_succ' ] ; norm_num [ add_comm, add_left_comm, add_assoc, Finset.prod_range_succ ] ; ring;
    rw [ show ( ∏ x ∈ Finset.range n, ( 1 + ( x : ℂ ) ) ) = ( n ! : ℂ ) from ?_ ];
    · rw [ Complex.cpow_def_of_ne_zero, Complex.cpow_def_of_ne_zero ] <;> norm_num [ hn, h ] ; ring;
      · rw [ Complex.cpow_def_of_ne_zero ] <;> norm_num [ hn, h ] ; ring;
        · rw [ Complex.log_mul ] <;> norm_num [ hn, h ] ; ring;
          · rw [ Complex.log_inv ] ; norm_num [ Nat.factorial_ne_zero, mul_assoc, mul_comm, mul_left_comm, ← Complex.exp_add ] ; ring;
            · norm_num [ mul_assoc, ← Complex.exp_add ] ; ring ; aesop;
            · rw [ Ne.eq_def, Complex.arg_eq_pi_iff ] ; norm_cast ; aesop;
          · exact mod_cast by positivity;
          · norm_num [ Complex.arg ];
            split_ifs <;> constructor <;> linarith [ Real.pi_pos ];
        · exact mod_cast by positivity;
      · exact mod_cast by positivity;
    · exact mod_cast by simp +decide [ add_comm, Finset.prod_range_succ' ] ;
  · exact Finset.prod_ne_zero_iff.mpr fun i hi => add_eq_zero_iff_eq_neg.not.mpr <| hz i;
  · exact Finset.prod_ne_zero_iff.mpr fun x hx => div_ne_zero ( add_eq_zero_iff_eq_neg.not.mpr <| by intro H; exact hz ( x + 1 ) <| by push_cast; linear_combination' H ) <| Nat.cast_add_one_ne_zero _