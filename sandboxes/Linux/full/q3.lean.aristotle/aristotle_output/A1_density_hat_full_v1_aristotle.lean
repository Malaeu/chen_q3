    unfold FejerKernel;
    field_simp;
    constructor <;> intro h <;> rw [ max_def, max_def ] at * <;> split_ifs at * <;> try nlinarith [ mul_div_cancel₀ ( δ - |x| ) hδ.ne', mul_div_cancel₀ ( δ - |x - δ| ) hδ.ne' ];
    all_goals simp_all +decide [ abs_of_nonneg, abs_of_nonpos, le_div_iff₀, div_le_iff₀ ];
    · constructor <;> cases abs_cases x <;> cases abs_cases ( x - δ ) <;> nlinarith [ mul_div_cancel₀ ( δ - |x| ) hδ.ne', mul_div_cancel₀ ( δ - |x - δ| ) hδ.ne' ];
    · rw [ div_eq_iff ] at h <;> cases abs_cases x <;> cases abs_cases ( x - δ ) <;> linarith;
    · rw [ div_eq_iff ] at h <;> cases abs_cases ( x - δ ) <;> cases abs_cases x <;> linarith;
    · rw [ ← add_div, div_eq_iff ] <;> linarith

