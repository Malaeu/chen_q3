              constructor <;> nlinarith [ show ( i : ℝ ) + 1 ≤ M - 1 by exact le_tsub_of_add_le_right ( by norm_cast; linarith [ Fin.is_lt i, Nat.sub_add_cancel hM.1 ] ), hτ_bounds i |>.1, hτ_bounds i |>.2, mul_div_cancel₀ ( 2 * K ) ( show ( M : ℝ ) ≠ 0 by norm_cast; linarith ) ];
            cases abs_cases ( τ i ) <;> linarith [ hτ_bounds i |>.1, hτ_bounds i |>.2 ]
          have hτ_sum : ∀ x ∈ Set.Icc (-K) K, ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) ≤ 1 := by
            intro x hx
            have h_sum_le_one : ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) ≤ ∑ i : Fin (M - 1), FejerKernel δ (x - (-K + (i.val + 1) * δ)) := by
              rfl;
            -- Apply the lemma that the sum of Fejer kernels on a grid is at most 1.
            have h_sum_le_one : ∑ i : Fin (M - 1), FejerKernel δ (x - (-K + (i.val + 1) * δ)) ≤ ∑ i : Fin (M - 1 + 1), FejerKernel δ (x - (-K + i.val * δ)) := by
              simp +decide [ Fin.sum_univ_succ ];
              exact fejer_nonneg;
            refine le_trans ‹_› <| h_sum_le_one.trans ?_;
            convert sum_fejer_le_one ( M - 1 ) δ ( div_pos ( mul_pos zero_lt_two hK ) ( Nat.cast_pos.mpr hM.1 ) ) ( -K ) x using 1
          have hτ_sum_eq_one : ∀ x ∈ Set.Icc (-K + δ) (K - δ), ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) = 1 := by
            intro x hx
            have h_sum_eq_one : ∑ i ∈ Finset.range (M - 1), FejerKernel δ (x - (-K + (i + 1) * δ)) = 1 := by
              have h_sum_eq_one : ∑ i ∈ Finset.range (M - 1), FejerKernel δ (x - (-K + (i + 1) * δ)) = ∑ i ∈ Finset.range (M - 1), FejerKernel δ (x - (-K + δ) - i * δ) := by
                exact Finset.sum_congr rfl fun _ _ => by ring;
              have h_sum_eq_one : ∑ i ∈ Finset.range (M - 1), FejerKernel δ (x - (-K + δ) - i * δ) = 1 := by
                have h_sum_eq_one : ∑ i ∈ Finset.range (M - 1), FejerKernel δ (x - (-K + δ) - i * δ) = ∑ i ∈ Finset.range (M - 1 + 1), FejerKernel δ (x - (-K + δ) - i * δ) := by
                  simp +zetaDelta at *;
                  rw [ Finset.sum_range_succ ];
                  norm_num [ Nat.cast_sub hM.1 ];
                  exact FejerKernel_eq_zero_of_abs_ge ( by exact div_pos ( mul_pos zero_lt_two hK ) ( Nat.cast_pos.mpr hM.1 ) ) ( by cases abs_cases ( x - ( -K + 2 * K / M ) - ( M - 1 ) * ( 2 * K / M ) ) <;> nlinarith [ mul_div_cancel₀ ( 2 * K ) ( Nat.cast_ne_zero.mpr hM.1.ne' ) ] )
                rw [h_sum_eq_one];
                convert sum_fejer_grid_eq_one ( M - 1 ) δ ( show 0 < δ from div_pos ( mul_pos zero_lt_two hK ) ( Nat.cast_pos.mpr hM.1 ) ) ( -K + δ ) ( x ) _ using 1;
                · rw [ Finset.sum_range ] ; exact Finset.sum_congr rfl fun _ _ => by ring;
                · simp +zetaDelta at *;
                  exact ⟨ hx.1, by rw [ Nat.cast_pred hM.1 ] ; nlinarith [ mul_div_cancel₀ ( 2 * K ) ( by norm_cast; linarith : ( M : ℝ ) ≠ 0 ) ] ⟩;
              linarith;
            rwa [ Finset.sum_range ] at h_sum_eq_one;
          -- In interior [-K+δ, K-δ], use convex_combination_approx with ε/2.
          have h_interior : ∀ x ∈ Set.Icc (-K + δ) (K - δ), |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i) - f x| < ε := by
            intros x hx
            have h_convex : ∀ i, 0 ≤ FejerKernel δ (x - τ i) := by
              exact fun i => fejer_nonneg
            have h_convex_sum : ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) = 1 := by
              exact hτ_sum_eq_one x hx
            have h_convex_approx : ∀ i, FejerKernel δ (x - τ i) > 0 → |f (τ i) - f x| < ε / 2 := by
              intros i hi_pos
              have h_dist : |x - τ i| < 2 * δ_cont := by
                have h_dist : |x - τ i| < δ := by
                  unfold FejerKernel at hi_pos;
                  norm_num at *;
                  rwa [ div_lt_one ( show 0 < δ from div_pos ( mul_pos zero_lt_two hK ) ( Nat.cast_pos.mpr hM.1 ) ) ] at hi_pos;
                exact h_dist.trans_le ( by linarith [ min_le_left ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_right ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_left δ_cont δ_bound, min_le_right δ_cont δ_bound ] );
              exact hδ_cont.2 _ _ ( hτ_bounds i ) ( show x ∈ Set.Icc ( -K ) K from ⟨ by linarith [ hx.1, show 0 ≤ δ by exact div_nonneg ( mul_nonneg zero_le_two hK.le ) ( Nat.cast_nonneg M ) ], by linarith [ hx.2, show 0 ≤ δ by exact div_nonneg ( mul_nonneg zero_le_two hK.le ) ( Nat.cast_nonneg M ) ] ⟩ ) ( by rwa [ abs_sub_comm ] )
            have h_convex_final : |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i) - f x| < ε / 2 := by
              convert convex_combination_approx ( Finset.univ : Finset ( Fin ( M - 1 ) ) ) ( fun i => FejerKernel δ ( x - τ i ) ) ( fun i => f ( τ i ) ) ( f x ) ( ε / 2 ) ( fun i _ => h_convex i ) ( by simpa [ mul_comm ] using h_convex_sum ) ( fun i _ hi => h_convex_approx i hi ) using 1 ; simp +decide [ mul_comm, Finset.mul_sum _ _ _, Finset.sum_mul _ _ _, h_convex_sum ]
            exact h_convex_final.trans_le (by linarith);
          -- In boundary regions, use bounded_sum_approx with ε/2.
          have h_boundary : ∀ x ∈ Set.Icc (-K) K, x < -K + δ ∨ x > K - δ → |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i) - f x| < ε := by
            intros x hx hx_boundary
            have h_sum_le_one : ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) ≤ 1 := by
              exact hτ_sum x hx
            have h_f_x_small : |f x| < ε / 2 := by
              apply hδ_bound.right x hx;
              cases hx_boundary <;> cases abs_cases x <;> linarith [ hx.1, hx.2, min_le_left ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_right ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_left δ_cont δ_bound, min_le_right δ_cont δ_bound ]
            have h_f_tau_small : ∀ i, FejerKernel δ (x - τ i) > 0 → |f (τ i)| < ε / 2 := by
              intros i hi_pos
              have h_dist : |x - τ i| < δ := by
                unfold FejerKernel at hi_pos;
                norm_num at hi_pos;
                rwa [ div_lt_one ( div_pos ( mul_pos zero_lt_two hK ) ( Nat.cast_pos.mpr hM.1 ) ) ] at hi_pos;
              apply hδ_bound.right;
              · exact hτ_bounds i;
              · cases hx_boundary <;> cases abs_cases ( x - τ i ) <;> cases abs_cases ( τ i ) <;> linarith [ hτ_bounds i, hτ_dist i, min_le_left ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_right ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_left δ_cont δ_bound, min_le_right δ_cont δ_bound ];
            have h_bounded_sum : |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i)| ≤ ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) * (ε / 2) := by
              have h_bounded_sum : ∀ i, |f (τ i) * FejerKernel δ (x - τ i)| ≤ FejerKernel δ (x - τ i) * (ε / 2) := by
                intros i
                by_cases h_pos : FejerKernel δ (x - τ i) > 0;
                · rw [ abs_mul, abs_of_nonneg h_pos.le ] ; nlinarith [ h_f_tau_small i h_pos ];
                · norm_num [ show FejerKernel δ ( x - τ i ) = 0 by exact le_antisymm ( le_of_not_gt h_pos ) ( fejer_nonneg ) ];
              exact le_trans ( Finset.abs_sum_le_sum_abs _ _ ) ( Finset.sum_le_sum fun i _ => h_bounded_sum i );
            exact abs_lt.mpr ⟨ by nlinarith [ abs_lt.mp h_f_x_small, abs_le.mp h_bounded_sum, show ∑ i : Fin ( M - 1 ), FejerKernel ( 2 * K / M ) ( x - ( -K + ( i.val + 1 ) * ( 2 * K / M ) ) ) * ( ε / 2 ) ≤ ε / 2 by rw [ ← Finset.sum_mul _ _ _ ] ; nlinarith ], by nlinarith [ abs_lt.mp h_f_x_small, abs_le.mp h_bounded_sum, show ∑ i : Fin ( M - 1 ), FejerKernel ( 2 * K / M ) ( x - ( -K + ( i.val + 1 ) * ( 2 * K / M ) ) ) * ( ε / 2 ) ≤ ε / 2 by rw [ ← Finset.sum_mul _ _ _ ] ; nlinarith ] ⟩;
          refine h_contra ⟨ M - 1, τ, δ, Nat.sub_pos_of_lt <| lt_of_le_of_ne hM.1 <| Ne.symm ?_, div_pos ( mul_pos zero_lt_two hK ) <| Nat.cast_pos.mpr hM.1, hτ_bounds, hτ_dist, ?_ ⟩;
          · rintro rfl ; norm_num at *;
            linarith [ min_le_left ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_right ( Min.min δ_cont δ_bound ) ( K / 2 ), min_le_left δ_cont δ_bound, min_le_right δ_cont δ_bound ];
          · exact fun x hx => if hx' : x < -K + δ ∨ x > K - δ then h_boundary x hx hx' else h_interior x ⟨ by contrapose! hx'; tauto, by contrapose! hx'; tauto ⟩

/-
If the Fejer kernel is positive, the argument is within the bandwidth.
-/
lemma fejer_pos_imp_dist_lt {δ x : ℝ} (hδ : δ > 0) (h : FejerKernel δ x > 0) : |x| < δ := by
  contrapose! h;
  exact max_le_iff.mpr ⟨ by linarith, by nlinarith [ abs_nonneg x, mul_div_cancel₀ ( |x| : ℝ ) hδ.ne' ] ⟩

/-
Refined hat interpolation approximation with control over delta.
-/
lemma hat_interpolation_approx_small_delta (K : ℝ) (hK : K > 0) (f : ℝ → ℝ)
    (hf_cont : Continuous f)
    (hf_supp : Function.support f ⊆ Set.Icc (-K) K)
    (ε : ℝ) (hε : ε > 0) (δ_max : ℝ) (hδ_max : δ_max > 0) :
    ∃ (n : ℕ) (τ : Fin n → ℝ) (δ : ℝ),
      n > 0 ∧ δ > 0 ∧ δ < δ_max ∧
      (∀ i, τ i ∈ Set.Icc (-K) K) ∧
      (∀ i, |τ i| + δ ≤ K) ∧
      ∀ x ∈ Set.Icc (-K) K,
        |∑ i, f (τ i) * FejerKernel δ (x - τ i) - f x| < ε := by
          obtain ⟨δ_cont, hδ_cont_pos, hδ_cont⟩ : ∃ δ_cont > 0, ∀ x y, x ∈ Set.Icc (-K) K → y ∈ Set.Icc (-K) K → |x - y| < δ_cont → |f x - f y| < ε / 2 := by
            have h_unif_cont : UniformContinuousOn f (Set.Icc (-K) K) := by
              exact ( isCompact_Icc.uniformContinuousOn_of_continuous hf_cont.continuousOn );
            exact Metric.uniformContinuousOn_iff.mp h_unif_cont ( ε / 2 ) ( half_pos hε ) |> Exists.imp fun δ hδ => by tauto;
          obtain ⟨δ_bound, hδ_bound_pos, hδ_bound⟩ : ∃ δ_bound > 0, ∀ x, x ∈ Set.Icc (-K) K → |x + K| < 2 * δ_bound ∨ |x - K| < 2 * δ_bound → |f x| < ε / 2 := by
            -- Since $f$ is continuous at $-K$ and $K$, and $f(-K) = f(K) = 0$, we can use the definition of continuity to find such $\delta_bound$.
            have h_cont_negK : ∃ δ_bound_negK > 0, ∀ x ∈ Set.Icc (-K) K, |x + K| < δ_bound_negK → |f x| < ε / 2 := by
              have := Metric.continuous_iff.mp hf_cont ( -K ) ( ε / 2 ) ( half_pos hε );
              obtain ⟨ δ, hδ_pos, H ⟩ := this; use δ, hδ_pos; intro x hx hx'; specialize H x; simp_all +decide [ abs_lt ] ;
              have := H ( abs_lt.mpr ⟨ by linarith, by linarith ⟩ ) ; rw [ show f ( -K ) = 0 from _ ] at this; constructor <;> linarith [ abs_lt.mp this ] ;
              contrapose! hf_supp;
              -- Since $f(-K) \neq 0$, there exists a neighborhood around $-K$ where $f$ is non-zero.
              obtain ⟨δ', hδ'_pos, hδ'⟩ : ∃ δ' > 0, ∀ x, |x + K| < δ' → f x ≠ 0 := by
                exact Metric.mem_nhds_iff.mp ( hf_cont.continuousAt.eventually_ne hf_supp ) |> fun ⟨ δ', hδ'_pos, hδ' ⟩ => ⟨ δ', hδ'_pos, fun x hx => hδ' <| by simpa [ dist_eq_norm ] using hx ⟩;
              exact ⟨ -K - δ' / 2, hδ' _ <| by rw [ abs_of_neg ] <;> linarith, fun _ => by linarith ⟩
            have h_cont_K : ∃ δ_bound_K > 0, ∀ x ∈ Set.Icc (-K) K, |x - K| < δ_bound_K → |f x| < ε / 2 := by
              have := Metric.continuous_iff.mp hf_cont K ( ε / 2 ) ( half_pos hε );
              obtain ⟨ δ, hδ_pos, hδ ⟩ := this; use δ, hδ_pos; intro x hx hx'; have := hδ x hx'; by_cases h : f K = 0 <;> simp_all +decide [ abs_lt ] ;
              contrapose! hf_supp;
              -- Since $f(K) \neq 0$, there exists a neighborhood around $K$ where $f$ is non-zero.
              obtain ⟨δ', hδ'_pos, hδ'⟩ : ∃ δ' > 0, ∀ x, |x - K| < δ' → f x ≠ 0 := by
                exact Metric.mem_nhds_iff.mp ( hf_cont.continuousAt.eventually_ne h );
              exact ⟨ K + δ' / 2, hδ' _ <| abs_lt.mpr ⟨ by linarith, by linarith ⟩, fun _ => by linarith ⟩;
            obtain ⟨ δ_bound_negK, hδ_bound_negK_pos, hδ_bound_negK ⟩ := h_cont_negK; obtain ⟨ δ_bound_K, hδ_bound_K_pos, hδ_bound_K ⟩ := h_cont_K; exact ⟨ Min.min δ_bound_negK δ_bound_K / 2, by positivity, fun x hx hx' => by cases hx' <;> [ exact hδ_bound_negK x hx ( by linarith [ min_le_left δ_bound_negK δ_bound_K, min_le_right δ_bound_negK δ_bound_K ] ) ; exact hδ_bound_K x hx ( by linarith [ min_le_left δ_bound_negK δ_bound_K, min_le_right δ_bound_negK δ_bound_K ] ) ] ⟩ ;
          -- Choose M such that δ := 2K/M < min(δ_cont, δ_bound, K/2, δ_max).
          obtain ⟨M, hM⟩ : ∃ M : ℕ, M > 0 ∧ 2 * K / M < min δ_cont (min δ_bound (min (K / 2) δ_max)) := by
            exact ⟨ ⌊2 * K / Min.min δ_cont ( Min.min δ_bound ( Min.min ( K / 2 ) δ_max ) ) ⌋₊ + 1, Nat.succ_pos _, by rw [ div_lt_iff₀ ] <;> push_cast <;> nlinarith [ Nat.lt_floor_add_one ( 2 * K / Min.min δ_cont ( Min.min δ_bound ( Min.min ( K / 2 ) δ_max ) ) ), show 0 < Min.min δ_cont ( Min.min δ_bound ( Min.min ( K / 2 ) δ_max ) ) by exact lt_min hδ_cont_pos ( lt_min hδ_bound_pos ( lt_min ( half_pos hK ) hδ_max ) ), mul_div_cancel₀ ( 2 * K ) ( ne_of_gt ( lt_min hδ_cont_pos ( lt_min hδ_bound_pos ( lt_min ( half_pos hK ) hδ_max ) ) ) ) ] ⟩;
          -- Define the grid points τ_i = -K + (i+1)δ for i = 0 to M-2.
          set δ := 2 * K / M
          set τ : Fin (M - 1) → ℝ := fun i => -K + (i.val + 1) * δ;
          -- Now let's verify the conditions for the grid points τ and the bandwidth δ.
          have hτ_bounds : ∀ i : Fin (M - 1), τ i ∈ Set.Icc (-K) K := by
            simp +zetaDelta at *;
            exact fun i => ⟨ by positivity, by nlinarith [ show ( i : ℝ ) + 1 ≤ M by norm_cast; linarith [ Fin.is_lt i, Nat.sub_add_cancel hM.1 ], mul_div_cancel₀ ( 2 * K ) ( by norm_cast; linarith : ( M : ℝ ) ≠ 0 ) ] ⟩
          have hδ_bounds : δ > 0 ∧ δ < δ_max := by
            exact ⟨ div_pos ( mul_pos zero_lt_two hK ) ( Nat.cast_pos.mpr hM.1 ), lt_of_lt_of_le hM.2 ( min_le_right _ _ |> le_trans <| min_le_right _ _ |> le_trans <| min_le_right _ _ ) ⟩
          have hτδ_bounds : ∀ i : Fin (M - 1), |τ i| + δ ≤ K := by
            intro i
            have hτ_i_bounds : τ i ∈ Set.Icc (-K) K := hτ_bounds i
            have hτ_i_abs : |τ i| ≤ K - δ := by
              rw [ abs_le ];
              constructor <;> nlinarith [ show ( i : ℝ ) + 1 ≤ M - 1 by exact le_tsub_of_add_le_right ( by norm_cast; linarith [ Fin.is_lt i, Nat.sub_add_cancel hM.1 ] ), mul_div_cancel₀ ( 2 * K ) ( show ( M : ℝ ) ≠ 0 by norm_cast; linarith ) ];
            linarith
          have h_sum_fejer : ∀ x ∈ Set.Icc (-K) K, ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) ≤ 1 := by
            intro x hx
            have h_sum_fejer_le_one : ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) ≤ ∑ i : Fin (M), FejerKernel δ (x - (-K + i * δ)) := by
              rcases M with ( _ | M ) <;> norm_num [ Fin.sum_univ_succ ] at *;
              exact le_add_of_nonneg_left ( by exact le_max_left _ _ );
            refine le_trans h_sum_fejer_le_one ?_;
            convert sum_fejer_le_one ( M - 1 ) δ hδ_bounds.1 ( -K ) x using 1 ; cases M <;> norm_num at *;
            rfl
          have h_sum_fejer_interior : ∀ x ∈ Set.Icc (-K + δ) (K - δ), ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) = 1 := by
            intro x hx;
            convert sum_fejer_grid_eq_one ( M - 2 ) δ hδ_bounds.1 ( -K + δ ) x _ using 1;
            · rcases M with ( _ | _ | M ) <;> norm_num at *;
              · grind;
              · exact Finset.sum_congr rfl fun _ _ => by ring!;
            · rcases M with ( _ | _ | M ) <;> norm_num at *;
              · norm_num +zetaDelta at *;
                linarith;
              · norm_num +zetaDelta at *;
                exact ⟨ hx.1, by nlinarith [ mul_div_cancel₀ ( 2 * K ) ( by linarith : ( M : ℝ ) + 1 + 1 ≠ 0 ) ] ⟩
          have h_sum_fejer_boundary : ∀ x ∈ Set.Icc (-K) K, x < -K + δ ∨ x > K - δ → ∑ i : Fin (M - 1), FejerKernel δ (x - τ i) ≤ 1 := by
            exact fun x hx hx' => h_sum_fejer x hx
          have h_sum_fejer_boundary_approx : ∀ x ∈ Set.Icc (-K) K, x < -K + δ ∨ x > K - δ → |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i) - f x| < ε := by
            intros x hx hx_boundary
            have h_abs_f_x : |f x| < ε / 2 := by
              apply hδ_bound x hx;
              cases hx_boundary <;> [ left; right ] <;> rw [ abs_lt ] <;> constructor <;> linarith [ hx.1, hx.2, min_le_left δ_cont ( Min.min δ_bound ( Min.min ( K / 2 ) δ_max ) ), min_le_right δ_cont ( Min.min δ_bound ( Min.min ( K / 2 ) δ_max ) ), min_le_left δ_bound ( Min.min ( K / 2 ) δ_max ), min_le_right δ_bound ( Min.min ( K / 2 ) δ_max ), min_le_left ( K / 2 ) δ_max, min_le_right ( K / 2 ) δ_max ]
            have h_abs_f_tau_i : ∀ i : Fin (M - 1), FejerKernel δ (x - τ i) > 0 → |f (τ i)| < ε / 2 := by
              intros i hi_pos
              have h_dist_tau_i_boundary : |τ i + K| < 2 * δ_bound ∨ |τ i - K| < 2 * δ_bound := by
                have h_dist_tau_i_boundary : |x - τ i| < δ := by
                  exact fejer_pos_imp_dist_lt hδ_bounds.1 hi_pos;
                norm_num +zetaDelta at *;
                cases hx_boundary <;> first | left; rw [ abs_of_nonneg, abs_of_nonneg ] <;> nlinarith [ abs_lt.mp h_dist_tau_i_boundary, hτ_bounds i ] | right; rw [ abs_of_nonpos ] <;> nlinarith [ abs_lt.mp h_dist_tau_i_boundary, hτ_bounds i ] ;
              exact hδ_bound _ ( hτ_bounds i ) h_dist_tau_i_boundary;
            have h_sum_fejer_boundary_approx : |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i)| ≤ ∑ i : Fin (M - 1), |f (τ i)| * FejerKernel δ (x - τ i) := by
              exact le_trans ( Finset.abs_sum_le_sum_abs _ _ ) ( Finset.sum_le_sum fun i _ => by rw [ abs_mul, abs_of_nonneg ( show 0 ≤ FejerKernel δ ( x - τ i ) from fejer_nonneg ) ] );
            have h_sum_fejer_boundary_approx : ∑ i : Fin (M - 1), |f (τ i)| * FejerKernel δ (x - τ i) ≤ ∑ i : Fin (M - 1), (ε / 2) * FejerKernel δ (x - τ i) := by
              apply Finset.sum_le_sum;
              intros i hi;
              by_cases h_pos : FejerKernel δ (x - τ i) > 0;
              · exact mul_le_mul_of_nonneg_right ( le_of_lt ( h_abs_f_tau_i i h_pos ) ) h_pos.le;
              · norm_num [ show FejerKernel δ ( x - τ i ) = 0 by exact le_antisymm ( le_of_not_gt h_pos ) ( fejer_nonneg ) ];
            simp_all +decide [ ← Finset.mul_sum _ _ _ ];
            exact abs_lt.mpr ⟨ by nlinarith [ abs_lt.mp h_abs_f_x, abs_le.mp ‹_›, h_sum_fejer x hx.1 hx.2 ], by nlinarith [ abs_lt.mp h_abs_f_x, abs_le.mp ‹_›, h_sum_fejer x hx.1 hx.2 ] ⟩
          have h_sum_fejer_interior_approx : ∀ x ∈ Set.Icc (-K + δ) (K - δ), |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i) - f x| < ε := by
            intros x hx
            have h_sum_fejer_interior_approx : |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i) - f x| ≤ ∑ i : Fin (M - 1), |f (τ i) - f x| * FejerKernel δ (x - τ i) := by
              have h_sum_fejer_interior_approx : |∑ i : Fin (M - 1), f (τ i) * FejerKernel δ (x - τ i) - f x| ≤ ∑ i : Fin (M - 1), |f (τ i) * FejerKernel δ (x - τ i) - f x * FejerKernel δ (x - τ i)| := by
                convert Finset.abs_sum_le_sum_abs _ _ using 2 ; norm_num [ ← sub_mul, h_sum_fejer_interior x hx ];
                · simp +decide [ sub_mul, Finset.sum_sub_distrib, h_sum_fejer_interior x hx ];
                  rw [ ← Finset.mul_sum _ _ _, h_sum_fejer_interior x hx, mul_one ];
                · infer_instance;
              exact h_sum_fejer_interior_approx.trans ( Finset.sum_le_sum fun i _ => by rw [ show f ( τ i ) * FejerKernel δ ( x - τ i ) - f x * FejerKernel δ ( x - τ i ) = ( f ( τ i ) - f x ) * FejerKernel δ ( x - τ i ) by ring ] ; rw [ abs_mul, abs_of_nonneg ( show 0 ≤ FejerKernel δ ( x - τ i ) by exact fejer_nonneg ) ] );
            -- Since $|f(τ_i) - f(x)| < ε / 2$ for all $i$ such that $FejerKernel δ (x - τ i) > 0$, we can bound the sum.
            have h_bound : ∑ i : Fin (M - 1), |f (τ i) - f x| * FejerKernel δ (x - τ i) ≤ ∑ i : Fin (M - 1), (ε / 2) * FejerKernel δ (x - τ i) := by
              apply Finset.sum_le_sum
              intro i _
              by_cases h_pos : FejerKernel δ (x - τ i) > 0;
              · have h_dist : |x - τ i| < δ_cont := by
                  exact lt_of_lt_of_le ( fejer_pos_imp_dist_lt hδ_bounds.1 h_pos ) ( le_of_lt ( lt_of_lt_of_le hM.2 ( min_le_left _ _ ) ) );
                exact mul_le_mul_of_nonneg_right ( le_of_lt ( hδ_cont _ _ ( hτ_bounds i ) ( by constructor <;> linarith [ hx.1, hx.2, hδ_bounds.1 ] ) ( by simpa [ abs_sub_comm ] using h_dist ) ) ) ( le_of_lt h_pos );
              · norm_num [ show FejerKernel δ ( x - τ i ) = 0 by exact le_antisymm ( le_of_not_gt h_pos ) ( fejer_nonneg ) ];
            exact h_sum_fejer_interior_approx.trans_lt ( h_bound.trans_lt ( by rw [ ← Finset.mul_sum _ _ _ ] ; nlinarith [ h_sum_fejer_interior x hx ] ) );
          use M - 1, τ, δ;
          rcases M with ( _ | _ | M ) <;> norm_num at *;
          · norm_num +zetaDelta at *;
            linarith;
          · exact ⟨ hδ_bounds.1, hδ_bounds.2, hτ_bounds, hτδ_bounds, fun x hx₁ hx₂ => if hx₃ : K + x < δ ∨ K - δ < x then h_sum_fejer_boundary_approx x hx₁ hx₂ hx₃ else h_sum_fejer_interior_approx x ( by contrapose! hx₃; tauto ) ( by contrapose! hx₃; tauto ) ⟩

/-
Helper lemma: Error bound for hat interpolation on a specific grid.
-/
lemma hat_interpolation_error_bound (K : ℝ) (hK : K > 0) (f : ℝ → ℝ)
    (hf_supp : Function.support f ⊆ Set.Icc (-K) K)
    (ε : ℝ) (hε : ε > 0) (δ : ℝ) (hδ : δ > 0) (n : ℕ)
    (τ_start : ℝ) (h_start : τ_start = -K + δ)
    (h_end : τ_start + n * δ = K - δ)
    (h_lip : ∀ x y, x ∈ Set.Icc (-K) K → y ∈ Set.Icc (-K) K → |x - y| < δ → |f x - f y| < ε / 2)
    (h_bound : ∀ x, x ∈ Set.Icc (-K) K → (|x + K| < δ ∨ |x - K| < δ) → |f x| < ε / 2) :
    ∀ x ∈ Set.Icc (-K) K,
      |∑ i : Fin (n + 1), f (τ_start + i * δ) * FejerKernel δ (x - (τ_start + i * δ)) - f x| < ε := by
        -- Let's split into two cases: when x is in the interior and when x is in the boundary regions.
        intro x hx
        by_cases hx_interior : τ_start ≤ x ∧ x ≤ τ_start + n * δ;
        · -- Apply the convex combination approximation lemma with the given conditions.
          have h_convex : ∀ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) > 0 → |f (τ_start + i * δ) - f x| < ε / 2 := by
            intro i hi
            have h_dist : |x - (τ_start + i * δ)| < δ := by
              exact?;
            exact h_lip _ _ ⟨ by nlinarith [ hx.1, hx.2, show ( i : ℝ ) ≤ n by norm_cast; linarith [ Fin.is_le i ] ], by nlinarith [ hx.1, hx.2, show ( i : ℝ ) ≤ n by norm_cast; linarith [ Fin.is_le i ] ] ⟩ hx ( by rwa [ abs_sub_comm ] );
          have h_sum_convex : |∑ i : Fin (n + 1), (f (τ_start + i * δ) - f x) * FejerKernel δ (x - (τ_start + i * δ))| ≤ ∑ i : Fin (n + 1), |f (τ_start + i * δ) - f x| * FejerKernel δ (x - (τ_start + i * δ)) := by
            exact le_trans ( Finset.abs_sum_le_sum_abs _ _ ) ( Finset.sum_le_sum fun i _ => by rw [ abs_mul, abs_of_nonneg ( show 0 ≤ FejerKernel δ ( x - ( τ_start + i * δ ) ) from by unfold FejerKernel; positivity ) ] ) ;
          have h_sum_convex : ∑ i : Fin (n + 1), |f (τ_start + i * δ) - f x| * FejerKernel δ (x - (τ_start + i * δ)) ≤ ε / 2 * ∑ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) := by
            field_simp;
            rw [ Finset.mul_sum _ _ _ ];
            rw [ Finset.sum_mul _ _ _ ];
            refine Finset.sum_le_sum fun i _ => ?_;
            by_cases hi : FejerKernel δ ( x - ( τ_start + i * δ ) ) > 0 <;> simp_all +decide [ mul_comm ];
            · nlinarith [ h_convex i hi ];
            · norm_num [ show FejerKernel δ ( x - ( -K + δ + δ * i ) ) = 0 by exact le_antisymm hi ( fejer_nonneg ) ];
          have h_sum_convex : ∑ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) = 1 := by
            exact?;
          simp_all +decide [ sub_mul ];
          simp_all +decide [ ← Finset.mul_sum _ _ _, ← Finset.sum_mul ];
          linarith;
        · -- Since x is in the boundary regions, we have |f(x)| < ε / 2.
          have h_f_x_small : |f x| < ε / 2 := by
            apply h_bound x hx;
            contrapose! hx_interior;
            constructor <;> cases abs_cases ( x + K ) <;> cases abs_cases ( x - K ) <;> linarith [ hx.1, hx.2 ];
          -- Since x is in the boundary regions, we have |f(τ_i) - f(x)| < ε / 2 for all i such that FejerKernel(δ, x - τ_i) > 0.
          have h_f_tau_i_small : ∀ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) > 0 → |f (τ_start + i * δ) - f x| < ε / 2 := by
            intros i hi_pos
            have h_dist : |x - (τ_start + i * δ)| < δ := by
              exact?;
            exact h_lip _ _ ⟨ by nlinarith [ hx.1, hx.2, show ( i : ℝ ) ≤ n by norm_cast; linarith [ Fin.is_le i ] ], by nlinarith [ hx.1, hx.2, show ( i : ℝ ) ≤ n by norm_cast; linarith [ Fin.is_le i ] ] ⟩ hx ( by simpa [ abs_sub_comm ] using h_dist );
          -- Since x is in the boundary regions, we have ∑ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) ≤ 1.
          have h_sum_fejer_le_one : ∑ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) ≤ 1 := by
            exact?;
          -- Applying the triangle inequality and the bounds we have, we get:
          have h_triangle : |∑ i : Fin (n + 1), f (τ_start + i * δ) * FejerKernel δ (x - (τ_start + i * δ)) - f x| ≤ ∑ i : Fin (n + 1), |f (τ_start + i * δ) - f x| * FejerKernel δ (x - (τ_start + i * δ)) + |f x| * |∑ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) - 1| := by
            have h_triangle : |∑ i : Fin (n + 1), f (τ_start + i * δ) * FejerKernel δ (x - (τ_start + i * δ)) - f x| ≤ |∑ i : Fin (n + 1), (f (τ_start + i * δ) - f x) * FejerKernel δ (x - (τ_start + i * δ))| + |f x * (∑ i : Fin (n + 1), FejerKernel δ (x - (τ_start + i * δ)) - 1)| := by
              norm_num [ sub_mul, Finset.sum_sub_distrib ];
              norm_num [ ← abs_mul, ← Finset.mul_sum _ _ _, ← Finset.sum_mul ];
              cases abs_cases ( ∑ i : Fin ( n + 1 ), f ( τ_start + i * δ ) * FejerKernel δ ( x - ( τ_start + i * δ ) ) - f x ) <;> cases abs_cases ( ∑ i : Fin ( n + 1 ), f ( τ_start + i * δ ) * FejerKernel δ ( x - ( τ_start + i * δ ) ) - f x * ∑ i : Fin ( n + 1 ), FejerKernel δ ( x - ( τ_start + i * δ ) ) ) <;> cases abs_cases ( f x * ( ∑ i : Fin ( n + 1 ), FejerKernel δ ( x - ( τ_start + i * δ ) ) - 1 ) ) <;> linarith;
            exact h_triangle.trans ( add_le_add ( le_trans ( Finset.abs_sum_le_sum_abs _ _ ) ( Finset.sum_le_sum fun i _ => by rw [ abs_mul, abs_of_nonneg ( show 0 ≤ FejerKernel δ ( x - ( τ_start + i * δ ) ) from by exact le_max_of_le_left <| by positivity ) ] ) ) ( by rw [ abs_mul ] ) );
          -- Since $|f(\tau_i) - f(x)| < \epsilon / 2$ for all $i$ such that $FejerKernel(\delta, x - \tau_i) > 0$, we can bound the first term.
          have h_first_term : ∑ i : Fin (n + 1), |f (τ_start + i * δ) - f x| * FejerKernel δ (x - (τ_start + i * δ)) ≤ ∑ i : Fin (n + 1), (ε / 2) * FejerKernel δ (x - (τ_start + i * δ)) := by
            apply Finset.sum_le_sum;
            intro i hi;
            by_cases hi_pos : FejerKernel δ (x - (τ_start + i * δ)) > 0;
            · exact mul_le_mul_of_nonneg_right ( le_of_lt ( h_f_tau_i_small i hi_pos ) ) hi_pos.le;
            · norm_num [ show FejerKernel δ ( x - ( τ_start + i * δ ) ) = 0 by exact le_antisymm ( le_of_not_gt hi_pos ) ( fejer_nonneg ) ];
          norm_num [ ← Finset.mul_sum _ _ _ ] at *;
          exact h_triangle.trans_lt ( by nlinarith [ abs_nonneg ( ∑ i : Fin ( n + 1 ), FejerKernel δ ( x - ( τ_start + ( i : ℝ ) * δ ) ) - 1 ), abs_of_nonpos ( sub_nonpos_of_le h_sum_fejer_le_one ) ] )