              rw [ abs_of_nonneg ( show 0 ≤ HeatKernel t x from by exact mul_nonneg ( one_div_nonneg.mpr <| Real.sqrt_nonneg _ ) <| Real.exp_nonneg _ ) ];
              exact mul_le_mul_of_nonneg_right ( abs_le.mpr ⟨ by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |x| / B ) <;> nlinarith [ abs_nonneg x, div_nonneg ( abs_nonneg x ) hB.le ], by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |x| / B ) <;> nlinarith [ abs_nonneg x, div_nonneg ( abs_nonneg x ) hB.le ] ⟩ ) ( mul_nonneg ( one_div_nonneg.mpr <| Real.sqrt_nonneg _ ) <| Real.exp_nonneg _ );
