            · exact Continuous.aestronglyMeasurable ( by exact Continuous.mul ( continuous_const ) ( Real.continuous_exp.comp <| by continuity ) );
          · simp +zetaDelta at *;
            filter_upwards [ ] with y using mul_le_mul_of_nonneg_right ( mul_le_of_le_one_right ( abs_nonneg _ ) ( by unfold Q3.Fejer_kernel; exact abs_le.mpr ⟨ by cases max_cases ( 0 : ℝ ) ( 1 - |x - y| / B ) <;> nlinarith [ abs_nonneg ( x - y ), div_nonneg ( abs_nonneg ( x - y ) ) hB.le ], by cases max_cases ( 0 : ℝ ) ( 1 - |x - y| / B ) <;> nlinarith [ abs_nonneg ( x - y ), div_nonneg ( abs_nonneg ( x - y ) ) hB.le ] ⟩ ) ) ( abs_nonneg _ );
      simp_all +decide [ mul_assoc, mul_sub ];
      intro t ht ht' x; rw [ show real_convolution f ( FejerHeatKernel B t ) x = ∫ y, f y * ( Q3.Fejer_kernel B ( x - y ) * HeatKernel t ( x - y ) ) by rfl ] ; rw [ show real_convolution f ( HeatKernel t ) x = ∫ y, f y * HeatKernel t ( x - y ) by rfl ] ; cases abs_cases ( ( ∫ y, f y * HeatKernel t ( x - y ) ) - f x ) <;> cases abs_cases ( ( ∫ y, f y * ( Q3.Fejer_kernel B ( x - y ) * HeatKernel t ( x - y ) ) ) - f x ) <;> cases abs_cases ( ( ∫ y, f y * HeatKernel t ( x - y ) ) - ∫ y, f y * ( Q3.Fejer_kernel B ( x - y ) * HeatKernel t ( x - y ) ) ) <;> linarith;

/-
Uniform approximation of integral by Riemann sum for continuous family of functions.
-/
lemma uniform_riemann_sum (a b : ℝ) (hab : a < b) (X : Set ℝ) (hX : IsCompact X) (F : ℝ → ℝ → ℝ) (hF : ContinuousOn (Function.uncurry F) (X ×ˢ Set.Icc a b)) (ε : ℝ) (hε : ε > 0) :
  ∃ (s : Finset ℝ) (w : ℝ → ℝ), (∀ y ∈ s, w y > 0) ∧ (∀ y ∈ s, y ∈ Set.Icc a b) ∧
  ∀ x ∈ X, |(∫ y in Set.Icc a b, F x y) - ∑ y ∈ s, w y * F x y| < ε := by
    simp +zetaDelta at *;
    by_contra! h;
    have h_unif_cont : ∀ ε > 0, ∃ δ > 0, ∀ x ∈ X, ∀ y₁ y₂, y₁ ∈ Set.Icc a b → y₂ ∈ Set.Icc a b → |y₁ - y₂| < δ → |F x y₁ - F x y₂| < ε := by
      have h_unif_cont : UniformContinuousOn (Function.uncurry F) (X ×ˢ Set.Icc a b) := by
        exact IsCompact.uniformContinuousOn_of_continuous ( hX.prod CompactIccSpace.isCompact_Icc ) hF;
      rw [ Metric.uniformContinuousOn_iff ] at h_unif_cont;
      exact fun ε hε => by obtain ⟨ δ, hδ, H ⟩ := h_unif_cont ε hε; exact ⟨ δ, hδ, fun x hx y₁ y₂ hy₁ hy₂ hy => H ( x, y₁ ) ⟨ hx, hy₁ ⟩ ( x, y₂ ) ⟨ hx, hy₂ ⟩ <| by simpa using hy ⟩ ;
    obtain ⟨ δ, hδ_pos, hδ ⟩ := h_unif_cont ( ε / ( 2 * ( b - a ) ) ) ( div_pos hε ( mul_pos zero_lt_two ( sub_pos.mpr hab ) ) );
    -- Choose a partition of [a, b] into m intervals of size less than δ.
    obtain ⟨m, hm⟩ : ∃ m : ℕ, m > 0 ∧ (b - a) / m < δ := by
      exact ⟨ ⌊ ( b - a ) / δ⌋₊ + 1, Nat.succ_pos _, by rw [ div_lt_iff₀ ] <;> push_cast <;> nlinarith [ Nat.lt_floor_add_one ( ( b - a ) / δ ), mul_div_cancel₀ ( b - a ) hδ_pos.ne' ] ⟩;
    obtain ⟨x, hx⟩ : ∃ x ∈ X, ε ≤ |(∫ y in Set.Icc a b, F x y) - ∑ y ∈ Finset.image (fun i : ℕ => a + (i + 1 / 2) * (b - a) / m) (Finset.range m), (b - a) / m * F x y| := by
      convert h ( Finset.image ( fun i : ℕ => a + ( i + 1 / 2 ) * ( b - a ) / m ) ( Finset.range m ) ) ( fun y => ( b - a ) / m ) _ _ using 1 <;> norm_num;
      · exact fun _ _ => div_pos ( sub_pos.mpr hab ) ( Nat.cast_pos.mpr hm.1 );
      · exact fun i hi => ⟨ div_nonneg ( mul_nonneg ( by positivity ) ( by linarith ) ) ( by positivity ), by rw [ add_div', div_le_iff₀ ] <;> nlinarith [ show ( i : ℝ ) + 1 ≤ m by norm_cast ] ⟩;
    -- By the properties of the integral, we can bound the difference between the integral and the Riemann sum.
    have h_integral_bound : |(∫ y in Set.Icc a b, F x y) - ∑ i ∈ Finset.range m, (b - a) / m * F x (a + (i + 1 / 2) * (b - a) / m)| ≤ ∑ i ∈ Finset.range m, ∫ y in (a + i * (b - a) / m).. (a + (i + 1) * (b - a) / m), |F x y - F x (a + (i + 1 / 2) * (b - a) / m)| := by
      have h_integral_bound : ∫ y in Set.Icc a b, F x y = ∑ i ∈ Finset.range m, ∫ y in (a + i * (b - a) / m).. (a + (i + 1) * (b - a) / m), F x y := by
        rw [ MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab.le ];
        symm;
        convert intervalIntegral.sum_integral_adjacent_intervals _ <;> norm_num [ hm.1.ne' ];
        field_simp;
        intro k hk; apply_rules [ ContinuousOn.intervalIntegrable ];
        refine' hF.comp ( continuousOn_const.prodMk continuousOn_id ) fun y hy => _;
        simp +zetaDelta at *;
        exact ⟨ hx.1, by cases Set.mem_uIcc.mp hy <;> nlinarith [ show ( k : ℝ ) + 1 ≤ m by norm_cast, mul_div_cancel₀ ( ( k : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( b - a ) * ( ( k : ℝ ) + 1 ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) ], by cases Set.mem_uIcc.mp hy <;> nlinarith [ show ( k : ℝ ) + 1 ≤ m by norm_cast, mul_div_cancel₀ ( ( k : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( b - a ) * ( ( k : ℝ ) + 1 ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) ] ⟩;
      rw [ h_integral_bound, ← Finset.sum_sub_distrib ];
      refine' le_trans ( Finset.abs_sum_le_sum_abs _ _ ) ( Finset.sum_le_sum fun i hi => _ );
      convert intervalIntegral.abs_integral_le_integral_abs _ using 2 <;> ring;
      · rw [ intervalIntegral.integral_add ] <;> norm_num ; ring;
        apply_rules [ ContinuousOn.intervalIntegrable ];
        refine' hF.comp ( continuousOn_const.prodMk continuousOn_id ) fun y hy => _;
        simp +zetaDelta at *;
        exact ⟨ hx.1, by cases Set.mem_uIcc.mp hy <;> nlinarith [ show ( i : ℝ ) + 1 ≤ m by norm_cast, mul_inv_cancel_left₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) a, mul_inv_cancel_left₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) b ], by cases Set.mem_uIcc.mp hy <;> nlinarith [ show ( i : ℝ ) + 1 ≤ m by norm_cast, mul_inv_cancel_left₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) a, mul_inv_cancel_left₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) b ] ⟩;
      · nlinarith [ inv_mul_cancel_left₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) a, inv_mul_cancel_left₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) b ];
    -- By the properties of the integral, we can bound the difference between the integral and the Riemann sum using the uniform continuity of $F$.
    have h_integral_bound : ∑ i ∈ Finset.range m, ∫ y in (a + i * (b - a) / m).. (a + (i + 1) * (b - a) / m), |F x y - F x (a + (i + 1 / 2) * (b - a) / m)| ≤ ∑ i ∈ Finset.range m, (b - a) / m * (ε / (2 * (b - a))) := by
      refine' Finset.sum_le_sum fun i hi => _;
      refine' le_trans ( intervalIntegral.integral_mono_on _ _ _ _ ) _;
      use fun y => ε / ( 2 * ( b - a ) );
      · bound;
      · apply_rules [ ContinuousOn.intervalIntegrable ];
        refine' ContinuousOn.abs ( ContinuousOn.sub _ _ );
        · refine' hF.comp ( continuousOn_const.prodMk continuousOn_id ) fun y hy => _;
          simp +zetaDelta at *;
          exact ⟨ hx.1, by cases Set.mem_uIcc.mp hy <;> nlinarith [ show ( i : ℝ ) + 1 ≤ m by norm_cast, mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) ], by cases Set.mem_uIcc.mp hy <;> nlinarith [ show ( i : ℝ ) + 1 ≤ m by norm_cast, mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) ] ⟩;
        · exact continuousOn_const;
      · norm_num;
      · intro y hy;
        refine' le_of_lt ( hδ x hx.1 y ( a + ( i + 1 / 2 ) * ( b - a ) / m ) _ _ _ ) <;> norm_num at *;
        · constructor <;> nlinarith [ show ( i : ℝ ) + 1 ≤ m by norm_cast, mul_div_cancel₀ ( ( i : ℝ ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ), mul_div_cancel₀ ( ( ( i : ℝ ) + 1 ) * ( b - a ) ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) ];
        · exact ⟨ div_nonneg ( mul_nonneg ( by positivity ) ( by linarith ) ) ( by positivity ), by rw [ add_div', div_le_iff₀ ] <;> nlinarith [ show ( i : ℝ ) + 1 ≤ m by norm_cast ] ⟩;
        · exact abs_lt.mpr ⟨ by ring_nf at *; nlinarith [ mul_inv_cancel₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) ], by ring_nf at *; nlinarith [ mul_inv_cancel₀ ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ) ] ⟩;
      · norm_num [ add_mul, div_eq_mul_inv ];
        linarith;
    rw [ Finset.sum_image ] at hx <;> norm_num at *;
    · nlinarith [ mul_div_cancel₀ ( b - a ) ( by norm_cast; linarith : ( m : ℝ ) ≠ 0 ), mul_div_cancel₀ ε ( by linarith : ( 2 * ( b - a ) ) ≠ 0 ) ];
    · norm_num [ div_eq_mul_inv, ne_of_gt hm.1, ne_of_gt ( sub_pos.mpr hab ) ]

/-
Convolution of f with FejerHeatKernel can be approximated by a finite sum of FejerHeatKernels with non-negative weights.
-/
theorem convolution_approx_by_sum_fejer (K : ℝ) (hK : K > 0) (B : ℝ) (hB : B > 0)
  (f : ℝ → ℝ) (hf_cont : ContinuousOn f (Set.Icc (-K) K))
  (hf_supp : Function.support f ⊆ Set.Icc (-K) K)
  (hf_nonneg : ∀ x, 0 ≤ f x) (t : ℝ) (ht : t > 0)
  (ε : ℝ) (hε : ε > 0) :
  ∃ (s : Finset ℝ) (w : ℝ → ℝ),
    (∀ y ∈ s, w y ≥ 0) ∧ (∀ y ∈ s, y ∈ Set.Icc (-K) K) ∧
    ∀ x ∈ Set.Icc (-K) K,
      |real_convolution f (FejerHeatKernel B t) x - ∑ y ∈ s, w y * FejerHeatKernel B t (x - y)| < ε := by
        -- Apply `uniform_riemann_sum` to `F` on `X = [-K, K]` and `[a, b] = [-K, K]`.
        obtain ⟨s, w, hw_pos, hw_bounds, hw_approx⟩ : ∃ s : Finset ℝ, ∃ (w : ℝ → ℝ), (∀ y ∈ s, w y > 0) ∧ (∀ y ∈ s, y ∈ Set.Icc (-K) K) ∧ ∀ x ∈ Set.Icc (-K) K, |(∫ y in Set.Icc (-K) K, f y * FejerHeatKernel B t (x - y)) - ∑ y ∈ s, w y * f y * FejerHeatKernel B t (x - y)| < ε := by
          have := @uniform_riemann_sum ( -K ) K ( by linarith ) ( Set.Icc ( -K ) K ) ?_ ( fun x y => f y * FejerHeatKernel B t ( x - y ) ) ?_ ε hε;
          · simpa only [ mul_assoc ] using this;
          · exact CompactIccSpace.isCompact_Icc;
          · refine' ContinuousOn.mul _ _;
            · exact hf_cont.comp continuousOn_snd fun x hx => hx.2;
            · refine' ContinuousOn.mul _ _;
              · exact ContinuousOn.sup continuousOn_const <| ContinuousOn.sub continuousOn_const <| ContinuousOn.div_const ( ContinuousOn.abs <| continuousOn_fst.sub continuousOn_snd ) _;
              · exact ContinuousOn.mul ( continuousOn_const ) ( ContinuousOn.rexp ( ContinuousOn.div_const ( ContinuousOn.neg ( ContinuousOn.pow ( continuousOn_fst.sub continuousOn_snd ) 2 ) ) _ ) );
        use s, fun y => w y * f y;
        simp_all +decide [ mul_assoc, MeasureTheory.integral_mul_const ];
        convert hw_approx using 4;
        unfold real_convolution; rw [ ← MeasureTheory.integral_indicator ] <;> norm_num [ Set.indicator ] ;
        grind

/-
A sum of atoms with appropriate properties is in AtomCone_K.
-/
theorem sum_atoms_in_cone (K : ℝ) (hK : K > 0) (s : Finset ℝ) (w : ℝ → ℝ)
  (hw : ∀ y ∈ s, 0 ≤ w y) (B : ℝ) (hB : B > 0) (hBK : B ≤ K)
  (t : ℝ) (ht : t > 0) (hs : ∀ y ∈ s, y ∈ Set.Icc (-K) K)
  (h_sum_pos : ∑ y ∈ s, w y > 0)
  (hg_cont : ContinuousOn (fun x => ∑ y ∈ s, w y * Atom B t y x) (Set.Icc (-K) K))
  (hg_supp : Function.support (fun x => ∑ y ∈ s, w y * Atom B t y x) ⊆ Set.Icc (-K) K)
  (hg_even : Q3.IsEven (fun x => ∑ y ∈ s, w y * Atom B t y x))
  (hg_nonneg : ∀ x, 0 ≤ (fun x => ∑ y ∈ s, w y * Atom B t y x) x) :
  (fun x => ∑ y ∈ s, w y * Atom B t y x) ∈ Q3.AtomCone_K K := by
    constructor;
    obtain ⟨f, hf⟩ : ∃ f : Fin (Finset.card s) ≃ s, True := by
      exact ⟨ Fintype.equivOfCardEq <| by simp +decide, trivial ⟩;
    refine' ⟨ fun i => w ( f i ), fun i => B, fun i => t, fun i => f i, _, _, _, _, _, _ ⟩ <;> simp_all +decide [ Function.support ];
    · exact fun i => abs_le.mpr ⟨ by linarith [ hs _ ( f i |>.2 ) ], by linarith [ hs _ ( f i |>.2 ) ] ⟩;
    · refine' ⟨ _, ⟨ hg_cont, hg_supp, hg_even, hg_nonneg ⟩ ⟩;
      intro x; rw [ ← Finset.sum_coe_sort ] ;
      conv_lhs => rw [ ← Equiv.sum_comp f ] ;
      rfl

/-
Convolution of two even functions is even.
-/
lemma convolution_even (f g : ℝ → ℝ) (hf : Q3.IsEven f) (hg : Q3.IsEven g) :
  Q3.IsEven (real_convolution f g) := by
    unfold Q3.IsEven real_convolution;
    intro x; rw [ ← MeasureTheory.integral_neg_eq_self ] ; congr; ext y; rw [ ← hg, ← hf ] ; ring;

/-
Triangle inequality for absolute difference.
-/
lemma abs_sub_le_add_abs (a b c : ℝ) : |a - c| ≤ |a - b| + |b - c| := by
  exact abs_sub_le _ _ _

/-
The integral of |FejerKernel - 1| * HeatKernel tends to 0 as t -> 0.
-/
lemma integral_fejer_diff_heat_tendsto_zero (B : ℝ) (hB : B > 0) :
  Filter.Tendsto (fun t => ∫ z, |Q3.Fejer_kernel B z - 1| * HeatKernel t z) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
    -- Let's choose any $\delta > 0$.
    have h_delta : ∀ δ > 0, ∃ t₀ > 0, ∀ t ∈ Set.Ioo 0 t₀, ∫ z, |Q3.Fejer_kernel B z - 1| * HeatKernel t z ≤ δ / B + ∫ z in {y | |y| ≥ δ}, HeatKernel t z := by
      intro δ hδ_pos
      have h_split : ∀ t > 0, ∫ z, |Q3.Fejer_kernel B z - 1| * HeatKernel t z ≤ (∫ z in {y | |y| < δ}, |Q3.Fejer_kernel B z - 1| * HeatKernel t z) + (∫ z in {y | |y| ≥ δ}, |Q3.Fejer_kernel B z - 1| * HeatKernel t z) := by
        intro t ht_pos
        have h_split : ∫ z, |Q3.Fejer_kernel B z - 1| * HeatKernel t z = (∫ z in {y | |y| < δ}, |Q3.Fejer_kernel B z - 1| * HeatKernel t z) + (∫ z in {y | |y| ≥ δ}, |Q3.Fejer_kernel B z - 1| * HeatKernel t z) := by
          rw [ ← MeasureTheory.setIntegral_union ] <;> norm_num;
          · rw [ show { y : ℝ | |y| < δ } ∪ { y : ℝ | δ ≤ |y| } = Set.univ by ext x; by_cases hx : |x| < δ <;> aesop ] ; norm_num;
          · exact Set.disjoint_left.mpr fun x hx₁ hx₂ => hx₁.out.not_le hx₂.out;
          · exact measurableSet_Ici.mem.comp measurable_norm;
          · refine' MeasureTheory.Integrable.integrableOn _;
            refine' MeasureTheory.Integrable.mono' _ _ _;
            refine' fun x => 2 * HeatKernel t x;
            · refine' MeasureTheory.Integrable.const_mul _ _;
              have := @HeatKernel_integral t ht_pos;
              exact MeasureTheory.integrable_of_integral_eq_one this;
            · refine' Measurable.aestronglyMeasurable _;
              exact Measurable.mul ( Measurable.norm ( Measurable.sub ( show Measurable ( Q3.Fejer_kernel B ) from by exact Measurable.max measurable_const ( Measurable.sub measurable_const ( measurable_norm.div_const _ ) ) ) measurable_const ) ) ( show Measurable ( HeatKernel t ) from by exact Measurable.mul ( measurable_const ) ( Real.continuous_exp.measurable.comp ( measurable_neg.comp ( measurable_id'.pow_const 2 ) |> Measurable.div_const <| 4 * t ) ) );
            · filter_upwards [ ] with x using by rw [ Real.norm_eq_abs, abs_of_nonneg ( mul_nonneg ( abs_nonneg _ ) ( HeatKernel_nonneg t ht_pos x ) ) ] ; exact mul_le_mul_of_nonneg_right ( abs_le.mpr ⟨ by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |x| / B ) <;> linarith [ show 0 ≤ |x| / B by positivity ], by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |x| / B ) <;> linarith [ show 0 ≤ |x| / B by positivity ] ⟩ ) ( HeatKernel_nonneg t ht_pos x ) ;
          · refine' MeasureTheory.Integrable.integrableOn _;
            refine' MeasureTheory.Integrable.mono' _ _ _;
            refine' fun x => 2 * HeatKernel t x;
            · refine' MeasureTheory.Integrable.const_mul _ _;
              have := @HeatKernel_integral t ht_pos;
              exact MeasureTheory.integrable_of_integral_eq_one this;
            · refine' Measurable.aestronglyMeasurable _;
              exact Measurable.mul ( Measurable.norm ( Measurable.sub ( show Measurable ( Q3.Fejer_kernel B ) from by exact Measurable.max measurable_const ( Measurable.sub measurable_const ( measurable_norm.div_const _ ) ) ) measurable_const ) ) ( show Measurable ( HeatKernel t ) from by exact Measurable.mul ( measurable_const ) ( Real.continuous_exp.measurable.comp ( measurable_neg.comp ( measurable_id'.pow_const 2 ) |> Measurable.div_const <| 4 * t ) ) );
            · filter_upwards [ ] with x using by rw [ Real.norm_eq_abs, abs_of_nonneg ( mul_nonneg ( abs_nonneg _ ) ( HeatKernel_nonneg t ht_pos x ) ) ] ; exact mul_le_mul_of_nonneg_right ( abs_le.mpr ⟨ by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |x| / B ) <;> linarith [ show 0 ≤ |x| / B by positivity ], by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |x| / B ) <;> linarith [ show 0 ≤ |x| / B by positivity ] ⟩ ) ( HeatKernel_nonneg t ht_pos x ) ;
        rw [h_split];
      -- For $|z| < \delta$, $|FejerKernel B z - 1| \leq \delta / B$.
      have h_bound_small : ∀ t > 0, ∫ z in {y | |y| < δ}, |Q3.Fejer_kernel B z - 1| * HeatKernel t z ≤ δ / B * ∫ z, HeatKernel t z := by
        intro t ht_pos
        have h_bound_small : ∀ z ∈ {y | |y| < δ}, |Q3.Fejer_kernel B z - 1| * HeatKernel t z ≤ δ / B * HeatKernel t z := by
          intro z hz
          have h_bound_small : |Q3.Fejer_kernel B z - 1| ≤ δ / B := by
            unfold Q3.Fejer_kernel;
            cases max_cases ( 0 : ℝ ) ( 1 - |z| / B ) <;> cases abs_cases ( Max.max 0 ( 1 - |z| / B ) - 1 ) <;> nlinarith [ abs_nonneg z, div_mul_cancel₀ |z| hB.ne', div_mul_cancel₀ δ hB.ne', hz.out ];
          exact mul_le_mul_of_nonneg_right h_bound_small <| by exact mul_nonneg ( by positivity ) <| Real.exp_nonneg _;
        refine' le_trans ( MeasureTheory.integral_mono_of_nonneg _ _ _ ) _;
        refine' fun z => δ / B * HeatKernel t z;
        · exact Filter.Eventually.of_forall fun x => mul_nonneg ( abs_nonneg _ ) ( by exact mul_nonneg ( by positivity ) ( Real.exp_nonneg _ ) );
        · refine' MeasureTheory.Integrable.const_mul _ _;
          exact MeasureTheory.Integrable.integrableOn ( by exact MeasureTheory.integrable_of_integral_eq_one ( by rw [ HeatKernel_integral t ht_pos ] ) );
        · filter_upwards [ MeasureTheory.ae_restrict_mem <| measurableSet_lt ( measurable_norm ) measurable_const ] with z hz using h_bound_small z hz;
        · rw [ MeasureTheory.integral_const_mul ];
          refine' mul_le_mul_of_nonneg_left ( MeasureTheory.setIntegral_le_integral _ _ ) ( by positivity );
          · exact MeasureTheory.integrable_of_integral_eq_one ( HeatKernel_integral t ht_pos );
          · exact Filter.Eventually.of_forall fun x => by exact mul_nonneg ( by positivity ) ( Real.exp_nonneg _ ) ;
      -- For $|z| \geq \delta$, $|FejerKernel B z - 1| \leq 1$.
      have h_bound_large : ∀ t > 0, ∫ z in {y | |y| ≥ δ}, |Q3.Fejer_kernel B z - 1| * HeatKernel t z ≤ ∫ z in {y | |y| ≥ δ}, HeatKernel t z := by
        intro t ht; refine' MeasureTheory.integral_mono_of_nonneg _ _ _;
        · filter_upwards [ ] with z using mul_nonneg ( abs_nonneg _ ) ( by unfold HeatKernel; exact mul_nonneg ( by positivity ) ( Real.exp_nonneg _ ) );
        · refine' MeasureTheory.Integrable.integrableOn _;
          exact MeasureTheory.integrable_of_integral_eq_one ( HeatKernel_integral t ht );
        · filter_upwards [ MeasureTheory.ae_restrict_mem <| measurableSet_Ici.preimage <| measurable_norm ] with z hz;
          exact mul_le_of_le_one_left ( by exact div_nonneg zero_le_one ( Real.sqrt_nonneg _ ) |> mul_nonneg <| Real.exp_nonneg _ ) <| abs_le.mpr ⟨ by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |z| / B ) <;> nlinarith [ abs_nonneg z, div_mul_cancel₀ |z| hB.ne' ], by unfold Q3.Fejer_kernel; cases max_cases ( 0 : ℝ ) ( 1 - |z| / B ) <;> nlinarith [ abs_nonneg z, div_mul_cancel₀ |z| hB.ne' ] ⟩;
      -- Since $\int z, HeatKernel t z = 1$, we can simplify the bound.
      have h_integral_one : ∀ t > 0, ∫ z, HeatKernel t z = 1 := by
        exact?;
      exact ⟨ 1, zero_lt_one, fun t ht => le_trans ( h_split t ht.1 ) ( add_le_add ( h_bound_small t ht.1 |> le_trans <| by rw [ h_integral_one t ht.1 ] ; ring_nf; norm_num ) ( h_bound_large t ht.1 ) ) ⟩;
    -- As $t \to 0$, the tail integral $\int_{|z| \geq \delta} \text{HeatKernel } t z$ tends to $0$.
    have h_tail : ∀ δ > 0, Filter.Tendsto (fun t => ∫ z in {y | |y| ≥ δ}, HeatKernel t z) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
      intro δ hδ_pos
      have h_tail : Filter.Tendsto (fun t => ∫ z in {y | |y| > δ}, HeatKernel t z) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
        exact?;
      have h_eq : ∀ t > 0, ∫ z in {y | |y| ≥ δ}, HeatKernel t z = ∫ z in {y | |y| > δ}, HeatKernel t z := by
        intro t ht_pos
        have h_eq : {y | |y| ≥ δ} = {y | |y| > δ} ∪ {y | |y| = δ} := by
          exact Set.ext fun x => by simp +decide [ le_iff_lt_or_eq, eq_comm ] ;
        rw [ h_eq, MeasureTheory.setIntegral_union ] <;> norm_num;
        · rw [ MeasureTheory.Measure.restrict_eq_zero.mpr ] <;> norm_num;
