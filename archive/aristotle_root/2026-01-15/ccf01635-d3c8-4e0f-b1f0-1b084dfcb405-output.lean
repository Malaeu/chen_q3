          simp +zetaDelta at *;
          obtain ⟨ δ, hδ₁, hδ₂ ⟩ := this ( ε / ( 4 * ( SupSet.sSup ( Set.range fun y => |f y| ) + 1 ) ) ) ( div_pos hε ( by linarith [ show 0 ≤ SupSet.sSup ( Set.range fun y => |f y| ) by apply_rules [ Real.sSup_nonneg ] ; rintro x ⟨ y, rfl ⟩ ; exact abs_nonneg _ ] ) ) ; use δ, hδ₁; intro z hz; specialize hδ₂ hz; norm_num [ Q3.Fejer_kernel ] at * ; linarith;
