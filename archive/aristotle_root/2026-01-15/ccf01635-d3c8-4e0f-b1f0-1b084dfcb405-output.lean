              simpa only [ mul_assoc ] using h_integrable.const_mul _;
            · filter_upwards [ ] with y using mul_le_mul_of_nonneg_right ( mul_le_mul_of_nonneg_right ( le_csSup ( show BddAbove ( Set.image ( fun y => |f y| ) Set.univ ) from by
                                                                                                                    have := hf_supp.exists_bound_of_continuous hf_cont;
                                                                                                                    exact ⟨ this.choose, Set.forall_mem_image.2 fun x _ => this.choose_spec x ⟩ ) ( Set.mem_image_of_mem _ ( Set.mem_univ _ ) ) ) ( abs_nonneg _ ) ) ( HeatKernel_nonneg t ht.1 _ );
          simp_all +decide [ mul_assoc, mul_comm, mul_left_comm, MeasureTheory.integral_const_mul ];
          exact h_bound.trans ( h_sup.trans_eq ( by rw [ ← MeasureTheory.integral_sub_left_eq_self ] ; rw [ ← MeasureTheory.integral_const_mul ] ; congr; ext; ring ) );
        -- Choose `δ` such that `|z| < δ → |1 - FejerKernel B z| < ε / (4M)`.
