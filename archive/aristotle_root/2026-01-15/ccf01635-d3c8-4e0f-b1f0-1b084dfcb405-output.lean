          rw [ Set.setOf_or, MeasureTheory.measure_union ] <;> norm_num;
          linarith;
        · exact Set.disjoint_left.mpr fun x hx₁ hx₂ => hx₁.out.ne' hx₂.out;
        · exact measurableSet_eq_fun ( measurable_norm ) measurable_const |> MeasurableSet.mem;
        · refine' MeasureTheory.Integrable.integrableOn _;
          exact MeasureTheory.integrable_of_integral_eq_one ( HeatKernel_integral t ht_pos );
        · refine' MeasureTheory.Integrable.integrableOn _;
          exact MeasureTheory.integrable_of_integral_eq_one ( HeatKernel_integral t ht_pos );
      exact Filter.Tendsto.congr' ( Filter.eventuallyEq_of_mem self_mem_nhdsWithin fun t ht => by rw [ h_eq t ht ] ) h_tail;
    -- By combining the results from h_delta and h_tail, we can conclude that the integral tends to 0.
    have h_combined : ∀ ε > 0, ∃ t₀ > 0, ∀ t ∈ Set.Ioo 0 t₀, ∫ z, |Q3.Fejer_kernel B z - 1| * HeatKernel t z < ε := by
      intros ε hε_pos
      obtain ⟨δ, hδ_pos, hδ⟩ : ∃ δ > 0, δ / B < ε / 2 := by
        exact ⟨ ε / 4 * B, by positivity, by rw [ div_lt_iff₀ ] <;> nlinarith ⟩;
      obtain ⟨ t₀, ht₀_pos, ht₀ ⟩ := h_delta δ hδ_pos;
      obtain ⟨ t₁, ht₁_pos, ht₁ ⟩ := Metric.tendsto_nhdsWithin_nhds.mp ( h_tail δ hδ_pos ) ( ε / 2 - δ / B ) ( by linarith );
      exact ⟨ Min.min t₀ t₁, lt_min ht₀_pos ht₁_pos, fun t ht => by linarith [ ht₀ t ⟨ ht.1, ht.2.trans_le ( min_le_left _ _ ) ⟩, abs_lt.mp ( ht₁ ht.1 ( by simpa [ abs_of_pos ht.1 ] using ht.2.trans_le ( min_le_right _ _ ) ) ) ] ⟩;
    rw [ Metric.tendsto_nhdsWithin_nhds ];
    intro ε hε; rcases h_combined ε hε with ⟨ t₀, ht₀, H ⟩ ; exact ⟨ t₀, ht₀, fun x hx₁ hx₂ => by simpa [ abs_of_nonneg ( show 0 ≤ ∫ z : ℝ, |Q3.Fejer_kernel B z - 1| * HeatKernel x z from MeasureTheory.integral_nonneg fun _ => mul_nonneg ( abs_nonneg _ ) ( by exact div_nonneg zero_le_one ( Real.sqrt_nonneg _ ) |> mul_nonneg <| Real.exp_nonneg _ ) ) ] using H x ⟨ hx₁, by linarith [ abs_lt.mp hx₂ ] ⟩ ⟩ ;