          intros t ht
          have h_first_integral_bound : ∫ z in {z | |z| < δ}, |1 - Q3.Fejer_kernel B z| * HeatKernel t z ≤ ∫ z in {z | |z| < δ}, (ε / (4 * (sSup (Set.image (fun y => |f y|) (Set.univ)) + 1))) * HeatKernel t z := by
            refine' MeasureTheory.integral_mono_of_nonneg _ _ _;
            · filter_upwards [ MeasureTheory.ae_restrict_mem <| measurableSet_lt ( measurable_norm ) measurable_const ] with z hz using mul_nonneg ( abs_nonneg _ ) ( HeatKernel_nonneg t ht.1 _ );
            · refine' MeasureTheory.Integrable.const_mul _ _;
