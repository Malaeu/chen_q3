/-
Convolution with FejerHeatKernel approximates identity uniformly.
-/
theorem FejerHeatKernel_approx_identity_uniform (B : ℝ) (hB : B > 0)
  (f : ℝ → ℝ) (hf_cont : Continuous f) (hf_supp : HasCompactSupport f)
  (ε : ℝ) (hε : ε > 0) :
  ∃ t₀ > 0, ∀ t ∈ Set.Ioo 0 t₀, ∀ x,
    |real_convolution f (FejerHeatKernel B t) x - f x| < ε := by
      -- Decompose the difference:
      -- `|conv(f, FejerHeatKernel) - f| ≤ |conv(f, FejerHeatKernel) - conv(f, HeatKernel)| + |conv(f, HeatKernel) - f|`.
      suffices h_decomp : ∀ t ∈ Set.Ioo 0 1, ∀ x, |real_convolution f (FejerHeatKernel B t) x - f x| ≤ |real_convolution f (HeatKernel t) x - f x| + |∫ y, f y * (1 - Q3.Fejer_kernel B (x - y)) * HeatKernel t (x - y)| by
        -- The term `|conv(f, HeatKernel) - f|` is `< ε/2` for small `t` by `HeatKernel_approx_identity_uniform`.
        obtain ⟨t₁, ht₁_pos, ht₁⟩ : ∃ t₁ > 0, t₁ < 1 ∧ ∀ t ∈ Set.Ioo 0 t₁, ∀ x, |real_convolution f (HeatKernel t) x - f x| < ε / 2 := by
          obtain ⟨ t₁, ht₁_pos, ht₁ ⟩ := HeatKernel_approx_identity_uniform f hf_cont hf_supp ( ε / 4 ) ( by linarith ) ; exact ⟨ Min.min t₁ 1 / 2, by positivity, by linarith [ min_le_left t₁ 1, min_le_right t₁ 1 ], fun t ht x => by linarith [ ht₁ t ⟨ by linarith [ ht.1, min_le_left t₁ 1, min_le_right t₁ 1 ], by linarith [ ht.2, min_le_left t₁ 1, min_le_right t₁ 1 ] ⟩ x ] ⟩ ;
        -- The term `|∫ f(y) * (1 - FejerKernel B (x-y)) * HeatKernel t (x-y)|` can be bounded by `M * ∫ |1 - FejerKernel B z| * HeatKernel t z`.
        have h_bound : ∀ t ∈ Set.Ioo 0 1, ∀ x, |∫ y, f y * (1 - Q3.Fejer_kernel B (x - y)) * HeatKernel t (x - y)| ≤ (∫ z, |1 - Q3.Fejer_kernel B z| * HeatKernel t z) * (sSup (Set.image (fun y => |f y|) (Set.univ))) := by
          intros t ht x
          have h_bound : |∫ y, f y * (1 - Q3.Fejer_kernel B (x - y)) * HeatKernel t (x - y)| ≤ ∫ y, |f y| * |1 - Q3.Fejer_kernel B (x - y)| * HeatKernel t (x - y) := by
            convert MeasureTheory.norm_integral_le_integral_norm ( _ : ℝ → ℝ ) using 1;
            simp +decide [ abs_mul, HeatKernel ];
            exact congr_arg _ ( funext fun y => by rw [ abs_of_nonneg ( show 0 ≤ Q3.heat_kernel_A1 t ( x - y ) from mul_nonneg ( one_div_nonneg.mpr ( Real.sqrt_nonneg _ ) ) ( Real.exp_nonneg _ ) ) ] );
          -- Since $|f y| \leq \sup_{y \in \mathbb{R}} |f y|$ for all $y$, we can bound the integral.
          have h_sup : ∫ y, |f y| * |1 - Q3.Fejer_kernel B (x - y)| * HeatKernel t (x - y) ≤ ∫ y, (sSup (Set.image (fun y => |f y|) (Set.univ))) * |1 - Q3.Fejer_kernel B (x - y)| * HeatKernel t (x - y) := by
            refine' MeasureTheory.integral_mono_of_nonneg _ _ _;
            · exact Filter.Eventually.of_forall fun y => mul_nonneg ( mul_nonneg ( abs_nonneg _ ) ( abs_nonneg _ ) ) ( HeatKernel_nonneg t ht.1 _ );
            · -- The function $|1 - Q3.Fejer_kernel B (x - y)| * HeatKernel t (x - y)$ is integrable because $Q3.Fejer_kernel B$ is bounded and $HeatKernel t$ is integrable.
              have h_integrable : MeasureTheory.Integrable (fun y => |1 - Q3.Fejer_kernel B (x - y)| * HeatKernel t (x - y)) MeasureTheory.MeasureSpace.volume := by
                have h_integrable : MeasureTheory.Integrable (fun y => HeatKernel t (x - y)) MeasureTheory.MeasureSpace.volume := by
                  have h_integrable : MeasureTheory.Integrable (fun y => HeatKernel t y) MeasureTheory.MeasureSpace.volume := by
                    have := @HeatKernel_integral t ht.1;
                    exact MeasureTheory.integrable_of_integral_eq_one this;
                  exact h_integrable.comp_sub_left x;
                refine' h_integrable.norm.mono' _ _;
                · refine' MeasureTheory.AEStronglyMeasurable.mul _ h_integrable.aestronglyMeasurable;
                  exact Measurable.aestronglyMeasurable ( by exact Measurable.norm ( measurable_const.sub ( show Measurable ( fun y => Q3.Fejer_kernel B ( x - y ) ) from by exact Measurable.max measurable_const ( show Measurable ( fun y => 1 - |x - y| / B ) from by exact Measurable.sub measurable_const ( by exact Measurable.div_const ( measurable_norm.comp ( measurable_const.sub measurable_id' ) ) _ ) ) ) ) );
                · simp +zetaDelta at *;
