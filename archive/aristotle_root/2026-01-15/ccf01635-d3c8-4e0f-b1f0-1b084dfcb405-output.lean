          · exact Set.disjoint_left.mpr fun x hx₁ hx₂ => hx₁.out.not_le hx₂.out;
          · exact measurableSet_Ici.mem.comp measurable_norm;
          · refine' MeasureTheory.Integrable.mono' _ _ _;
            refine' fun z => ( ε / ( 4 * ( SupSet.sSup ( ( fun y => |f y| ) '' Set.univ ) + 1 ) ) ) * HeatKernel t z;
            · refine' MeasureTheory.Integrable.const_mul _ _;
              refine' MeasureTheory.Integrable.integrableOn _;
              exact MeasureTheory.integrable_of_integral_eq_one ( HeatKernel_integral t ht.1 );
            · refine' Measurable.aestronglyMeasurable _;
              refine' Measurable.mul _ _;
              · exact Measurable.norm ( measurable_const.sub ( measurable_const.max ( measurable_const.sub ( measurable_id'.norm.div_const _ ) ) ) );
              · exact Measurable.mul ( measurable_const ) ( Real.continuous_exp.measurable.comp ( measurable_neg.comp ( measurable_id.pow_const 2 ) |> Measurable.div_const <| 4 * t ) );
            · filter_upwards [ MeasureTheory.ae_restrict_mem <| measurableSet_lt measurable_norm measurable_const ] with x hx using by rw [ Real.norm_of_nonneg <| mul_nonneg ( abs_nonneg _ ) <| show 0 ≤ HeatKernel t x from by exact mul_nonneg ( one_div_nonneg.mpr <| Real.sqrt_nonneg _ ) <| Real.exp_nonneg _ ] ; exact mul_le_mul_of_nonneg_right ( le_of_lt <| hδ x hx ) <| show 0 ≤ HeatKernel t x from by exact mul_nonneg ( one_div_nonneg.mpr <| Real.sqrt_nonneg _ ) <| Real.exp_nonneg _;
          · refine' MeasureTheory.Integrable.mono' _ _ _;
            refine' fun z => 2 * HeatKernel t z;
            · refine' MeasureTheory.Integrable.const_mul _ _;
              refine' MeasureTheory.Integrable.integrableOn _;
              exact MeasureTheory.integrable_of_integral_eq_one ( HeatKernel_integral t ht.1 );
            · refine' Measurable.aestronglyMeasurable _;
              refine' Measurable.mul _ _;
              · exact Measurable.norm ( measurable_const.sub ( measurable_const.max ( measurable_const.sub ( measurable_id'.norm.div_const _ ) ) ) );
              · exact Measurable.mul ( measurable_const ) ( Real.continuous_exp.measurable.comp ( measurable_neg.comp ( measurable_id.pow_const 2 ) |> Measurable.div_const <| 4 * t ) );
            · filter_upwards [ MeasureTheory.ae_restrict_mem <| measurableSet_le measurable_const <| measurable_norm ] with x hx;
